rules_version = '2';

// Security rules for the "rsvp" collection used by page 9 of the
// invitation (StayScene.astro / src/lib/rsvp.ts). This file is not
// deployed automatically -- apply it via the Firebase console (Firestore
// Database -> Rules) or `firebase deploy --only firestore:rules` once the
// Firebase CLI is set up for this project.
//
// Intent, per the page 9 spec:
//   - Reading a single, specific RSVP document by its own id (a `get`) is
//     allowed -- this is what lets StayScene restore a guest's previously
//     saved response on reload (see src/lib/rsvp.ts's getRsvpResponse).
//     There is still no way to enumerate the collection: `list` (any
//     query against /rsvp, e.g. "get all documents") stays denied, so a
//     visitor can only ever read the one document whose exact id
//     (inviteId) they already have -- never discover another guest's.
//   - Guests may create or update only their own document (doc id must
//     equal the guestId field), with the exact five fields the app
//     writes, no more, no less, and each one type/shape-checked.
//   - Nobody may delete a response, and nobody may list the collection.
service cloud.firestore {
  match /databases/{database}/documents {
    match /rsvp/{guestId} {
      allow get: if true;
      allow list: if false;
      allow delete: if false;

      allow create, update: if
        request.resource.data.keys().hasOnly(
          ['guestId', 'guestName', 'attendanceStatus', 'partySize', 'respondedAt']
        ) &&
        request.resource.data.guestId is string &&
        request.resource.data.guestId == guestId &&
        request.resource.data.guestName is string &&
        request.resource.data.guestName.size() > 0 &&
        request.resource.data.attendanceStatus in ['attending', 'maybe', 'not_attending'] &&
        request.resource.data.partySize is int &&
        request.resource.data.partySize > 0 &&
        request.resource.data.respondedAt == request.time;
    }
  }
}
