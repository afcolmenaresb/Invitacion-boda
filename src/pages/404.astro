---
// Catches every unmatched route -- an unknown path, or a /i/{slug}-
// {inviteId} whose exact combination was never generated by
// [invite].astro's getStaticPaths (see that file's own comment: a
// mutated/guessed slug or inviteId simply has no matching static file,
// so the host's normal 404 handling lands here on its own -- nothing
// here ever inspects the attempted path or tries to resolve/redirect it
// to a real invitation). Same screen as index.astro -- see
// NotFoundGate.astro.
import BaseLayout from '../layouts/BaseLayout.astro';
import NotFoundGate from '../components/NotFoundGate.astro';
---

<BaseLayout title="Invitación de Fátima y Andrés" noindex>
  <main>
    <NotFoundGate />
  </main>
</BaseLayout>
