---
import BaseLayout from '../layouts/BaseLayout.astro';
import Cover from '../components/Cover.astro';
import { guests } from '../data/guests';

export function getStaticPaths() {
  return guests.map((guest) => ({
    params: { slug: guest.slug },
    props: { guest },
  }));
}

const { guest } = Astro.props;
---

<BaseLayout title={`Invitación para ${guest.displayName}`}>
  <main>
    <Cover displayName={guest.displayName} dedication={guest.dedication} />
    <div id="viaje" class="scroll-check"></div>
  </main>
</BaseLayout>

<style>
  .scroll-check {
    min-height: 100svh;
  }
</style>
