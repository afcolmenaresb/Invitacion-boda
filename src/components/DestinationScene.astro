---
import { sceneDestination, getDestinationFinalLine } from '../data/sceneDestination';
import type { Guest } from '../data/guests';

interface Props {
  /** Drives the dynamic closing line ("...contigo." / "...con ustedes."). */
  addressing?: Guest['addressing'];
}

// 'plural' is the safer neutral default if this were ever rendered without
// a guest context -- in practice InvitationExperience always passes the
// real guest.addressing through (same convention as MemoryScene).
const { addressing = 'plural' } = Astro.props;

const bodyLines = sceneDestination.body.split('\n');
const finalLine = getDestinationFinalLine(addressing);
---

<div class="destination" data-scene-panel-content aria-label={sceneDestination.eyebrow}>
  <button type="button" class="destination__back" data-action="back-to-memory" aria-label={sceneDestination.backLabel}>
    <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
      <path d="M15 5 L8 12 L15 19" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
    <span>{sceneDestination.backVisibleLabel}</span>
  </button>

  <div class="destination__content">
    <p class="destination__eyebrow" data-destination-part="eyebrow">{sceneDestination.eyebrow}</p>
    <h2 class="destination__title" data-scene-heading data-destination-part="title" tabindex="-1">
      {sceneDestination.title}
    </h2>
    <p class="destination__date" data-destination-part="date">{sceneDestination.date}</p>
    <div class="destination__copy" data-destination-part="copy">
      {bodyLines.map((line) => (
        <p>{line}</p>
      ))}
      <p class="destination__final">{finalLine}</p>
    </div>
    <button
      type="button"
      class="destination__cta destination__cta--primary"
      data-destination-part="cta-primary"
      data-action="go-to-journey"
    >
      {sceneDestination.ctaPrimary}
    </button>
    <p class="destination__cta destination__cta--secondary" data-destination-part="cta-secondary" data-action="show-trip-info">
      {sceneDestination.ctaSecondary}
    </p>
  </div>
</div>

<style>
  .destination {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    isolation: isolate;
  }

  /* Same control as MemoryScene's own .memory__back -- identical position,
     type treatment and icon, just pointing at the previous scene. */
  .destination__back {
    position: absolute;
    top: max(18px, env(safe-area-inset-top));
    left: max(18px, env(safe-area-inset-left));
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: none;
    border: none;
    padding: 0.4rem 0.2rem;
    cursor: pointer;
    font-family: var(--font-sans);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #6b6055;
    opacity: 0;
  }

  :global(.experience.is-revealing-destination) .destination__back {
    opacity: 1;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.experience:not(.is-instant)) .destination__back {
      transition: opacity 320ms ease, color 0.2s ease, transform 0.2s ease;
    }

    .destination__back:hover,
    .destination__back:focus-visible {
      color: var(--color-accent);
      transform: translateX(-2px);
    }
  }

  :global(.experience.is-instant) .destination__back {
    transition: none !important;
  }

  /*
    Frozen at the same 390x844 canvas MemoryScene and Cover use -- see
    MemoryScene.astro's own comment on .memory__content for why px values,
    not vw/vh/clamp(), are correct here: this always lives inside a fixed
    390x844 box that InvitationExperience.astro itself scales uniformly to
    fit any viewport.
  */
  .destination__content {
    margin: auto;
    width: 100%;
    max-width: 358.8px;
    display: flex;
    flex-direction: column;
    gap: 22px;
    padding: 0 28px;
    /* Open, airy vertical position -- a little below true center, so the
       title has room to breathe above it and the CTAs settle low, closer
       to the "sand line" reading of the destination texture beneath. */
    align-items: flex-start;
    text-align: left;
  }

  .destination__eyebrow {
    margin: 0;
    font-family: var(--font-sans);
    text-transform: uppercase;
    letter-spacing: 0.22em;
    font-size: 0.68rem;
    color: #8c7f6a;
  }

  /*
    Editorial, elegant, luxury-travel focal point -- the existing serif
    design token (--font-serif), never MemoryScene's handwritten ink
    typeface. This is the one element the whole scene is built to lead the
    eye toward.
  */
  .destination__title {
    margin: 0;
    font-family: var(--font-serif);
    font-weight: 400;
    font-style: normal;
    color: #211c18;
    font-size: 2.7rem;
    line-height: 1.12;
    letter-spacing: 0.01em;
    outline: none;
  }

  /* Same rationale as MemoryScene's .memory__title:focus-visible -- this
     heading is only ever reached via the scripted focus() call in
     InvitationExperience.astro, never by tabbing, so no focus ring. */
  .destination__title:focus-visible {
    outline: none;
  }

  /* Secondary to the title, as specified -- small, quiet, factual. */
  .destination__date {
    margin: 0;
    font-family: var(--font-sans);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 0.74rem;
    color: var(--color-accent);
  }

  .destination__copy {
    margin: 6px 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.55em;
  }

  .destination__copy p {
    margin: 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    font-size: 1.05rem;
    line-height: 1.6;
    color: #4a3f35;
  }

  /* The dynamic closing line reads as part of the same copy, with a
     touch more presence -- never competing with the title. */
  .destination__final {
    margin-top: 0.25em !important;
    color: #3a3128 !important;
    font-style: normal !important;
  }

  .destination__cta {
    margin: 0;
    /* .destination__content already uses align-items: flex-start (see
       above), so these <p> CTAs already shrink-wrap to their own text --
       position: relative here is only so the ::before glow below can
       size itself against that same shrink-wrapped box, not a fresh
       full-width one. */
    position: relative;
    font-family: var(--font-sans);
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #6b6055;
  }

  /*
    Same soft translucent ivory glow Cover.astro already uses behind
    .cover__meta (identical rgba(255, 254, 248, ...) radial-gradient, see
    that file's .cover__meta::before) -- resized to hug each single-line
    CTA. Not a card/pill: no border-radius, no visible edge, no blur, just
    a quiet lift against the destination texture. The secondary CTA's own
    glow is deliberately smaller/fainter than the primary's so the
    existing hierarchy (color, size) stays intact with this added.
  */
  .destination__cta::before {
    content: '';
    position: absolute;
    z-index: -1;
    pointer-events: none;
    background: radial-gradient(ellipse at center, rgba(255, 254, 248, 1), rgba(255, 254, 248, 0) 80%);
  }

  .destination__cta--primary {
    /* Now a real <button> (was a plain <p>) so it can trigger the
       journey transition -- reset to look identical to the old
       paragraph: no border/background/padding, same cursor affordance
       the rest of the experience's controls use. .destination__content
       already uses align-items: flex-start, so no extra width is needed
       to keep it shrink-wrapped to its own text (see .destination__cta's
       own comment above). */
    display: block;
    background: none;
    border: none;
    padding: 0;
    text-align: left;
    cursor: pointer;
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    margin-top: 14px;
    color: var(--color-accent);
  }

  .destination__cta--primary::before {
    inset: -8px -14px;
  }

  .destination__cta--primary::after {
    content: ' →';
  }

  .destination__cta--secondary {
    color: #8c7f6a;
    font-size: 0.72rem;
  }

  .destination__cta--secondary::before {
    inset: -6px -10px;
    opacity: 0.75;
  }

  /*
    Entrance: plain, quiet opacity + small translateY -- never the
    handwritten ink sweep MemoryScene uses. Hidden by default; each part
    becomes visible once InvitationExperience.astro's script adds
    .is-destination-revealing to the shared .experience root (the moment
    transition3.mp4 begins playing, or -- for reduced motion / an instant
    direct load -- the moment the static final frame is shown), at which
    point each [data-destination-part] fades in on its own
    transition-delay, timed against that same moment -- see the delays
    below, which mirror the "referencia desde el inicio del video" spec
    (4.0s / 4.4s / 5.1s / 5.7s / 6.6s / 7.0s).
  */
  [data-destination-part] {
    opacity: 0;
    transform: translateY(8px);
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.experience.is-destination-revealing) [data-destination-part] {
      transition: opacity 900ms ease, transform 900ms ease;
    }

    :global(.experience.is-destination-revealing) [data-destination-part='eyebrow'] {
      opacity: 1;
      transform: translateY(0);
      transition-delay: 4000ms;
    }

    :global(.experience.is-destination-revealing) [data-destination-part='title'] {
      opacity: 1;
      transform: translateY(0);
      transition-delay: 4400ms;
    }

    :global(.experience.is-destination-revealing) [data-destination-part='date'] {
      opacity: 1;
      transform: translateY(0);
      transition-delay: 5100ms;
    }

    :global(.experience.is-destination-revealing) [data-destination-part='copy'] {
      opacity: 1;
      transform: translateY(0);
      transition-delay: 5700ms;
    }

    :global(.experience.is-destination-revealing) [data-destination-part='cta-primary'] {
      opacity: 1;
      transform: translateY(0);
      transition-delay: 6600ms;
    }

    :global(.experience.is-destination-revealing) [data-destination-part='cta-secondary'] {
      opacity: 1;
      transform: translateY(0);
      transition-delay: 7000ms;
    }
  }

  /*
    Reduced motion / instant loads: no per-part stagger, no delays -- one
    short, uniform fade so the whole scene settles as a single quiet
    crossfade instead of a video-timed sequence that has no video to
    follow.
  */
  :global(.experience.is-reduced-motion.is-destination-revealing) [data-destination-part],
  :global(.experience.is-instant) [data-destination-part] {
    transition: opacity 260ms ease !important;
    transform: none !important;
    transition-delay: 0ms !important;
  }

  :global(.experience.is-reduced-motion.is-destination-revealing) [data-destination-part],
  :global(.experience[data-scene='destination'].is-instant) [data-destination-part] {
    opacity: 1;
    transform: translateY(0);
  }
</style>
