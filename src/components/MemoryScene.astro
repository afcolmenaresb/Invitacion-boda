---
import { memoryScene } from '../data/sceneMemory';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class="memory" data-scene-panel-content aria-label={memoryScene.eyebrow}>
  <div class="memory__texture" style={`background-image: url('${base}/images/textura_vertical_2.png')`}></div>

  <button type="button" class="memory__back" data-action="back-to-cover" aria-label={memoryScene.backLabel}>
    <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
      <path d="M15 5 L8 12 L15 19" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
    <span>Portada</span>
  </button>

  <div class="memory__content">
    <p class="memory__eyebrow">{memoryScene.eyebrow}</p>
    <h2 class="memory__title" data-scene-heading tabindex="-1">{memoryScene.title}</h2>
    <div class="memory__body">
      {memoryScene.body.map((line) => (
        <p>{line}</p>
      ))}
    </div>
    <div class="memory__closing">
      {memoryScene.closing.map((line) => (
        <p>{line}</p>
      ))}
    </div>
    <p class="memory__cta">{memoryScene.cta}</p>
  </div>
</section>

<style>
  .memory {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    isolation: isolate;
    overflow: hidden;
  }

  .memory__texture {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-color: var(--color-bg);
    background-size: cover;
    background-repeat: no-repeat;
    background-position: 40% top;
  }

  .memory__back {
    position: absolute;
    top: max(18px, env(safe-area-inset-top));
    left: max(18px, env(safe-area-inset-left));
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: none;
    border: none;
    padding: 0.4rem 0.2rem;
    cursor: pointer;
    font-family: var(--font-sans);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #6b6055;
  }

  @media (prefers-reduced-motion: no-preference) {
    .memory__back {
      transition: color 0.2s ease, transform 0.2s ease;
    }

    .memory__back:hover,
    .memory__back:focus-visible {
      color: var(--color-accent);
      transform: translateX(-2px);
    }
  }

  .memory__content {
    margin: auto;
    width: 100%;
    max-width: min(92vw, 620px);
    display: flex;
    flex-direction: column;
    gap: clamp(14px, 2.6vh, 26px);
    padding: max(64px, env(safe-area-inset-top))
      max(28px, env(safe-area-inset-right))
      max(28px, env(safe-area-inset-bottom))
      max(28px, env(safe-area-inset-left));
  }

  .memory__eyebrow {
    margin: 0;
    font-family: var(--font-sans);
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-size: 0.68rem;
    color: #8c7f6a;
  }

  .memory__title {
    margin: 0;
    font-family: 'Homemade Apple', cursive;
    font-weight: 400;
    color: #211c18;
    font-size: clamp(1.7rem, min(7vw, 8vh), 2.6rem);
    line-height: 1.25;
    outline: none;
  }

  /*
    tabindex="-1" means this heading is only ever reached via the
    scripted focus() call in InvitationExperience.astro's
    focusSceneHeading (never by a user tabbing through the page) -- its
    purpose is purely to move a screen reader's attention to the new
    scene, since sighted users already have the whole scene change as
    their cue. The browser's default focus ring would otherwise box in
    the handwritten heading, fighting the ink strokes' own framing, so it
    stays suppressed (redundant with the outline:none above, kept
    explicit here since :focus-visible would otherwise reintroduce it).
  */
  .memory__title:focus-visible {
    outline: none;
  }

  .memory__body {
    display: flex;
    flex-direction: column;
    gap: 0.15em;
  }

  .memory__body p,
  .memory__closing p {
    margin: 0;
    font-family: var(--font-serif);
    color: #5c5047;
    font-size: clamp(0.92rem, min(3vw, 3.4vh), 1.1rem);
    line-height: 1.5;
  }

  .memory__closing {
    display: flex;
    flex-direction: column;
    gap: 0.15em;
    margin-top: clamp(4px, 1vh, 10px);
    font-style: italic;
  }

  .memory__cta {
    margin: clamp(8px, 1.6vh, 18px) 0 0;
    font-family: var(--font-sans);
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #6b6055;
  }

  .memory__cta::after {
    content: ' →';
  }

  /*
    Reveal choreography, phase 4 of the transition (see the timing
    constants in InvitationExperience.astro's script): hidden by default
    while the cover scene is active, fading up once the memory scene
    becomes current. The title settles in as D1 (the top stroke) is
    nearly in place, the body follows, and the closing lines + CTA settle
    once E1 (the bottom stroke) finishes its own journey -- delays below
    are chosen to match PHASE1+PHASE2+PHASE3 (~2300ms) from that file.
  */
  :global(.experience:not([data-scene='memory'])) .memory__eyebrow,
  :global(.experience:not([data-scene='memory'])) .memory__title,
  :global(.experience:not([data-scene='memory'])) .memory__body,
  :global(.experience:not([data-scene='memory'])) .memory__closing,
  :global(.experience:not([data-scene='memory'])) .memory__cta {
    opacity: 0;
    transform: translateY(8px);
  }

  :global(.experience[data-scene='memory']) .memory__eyebrow,
  :global(.experience[data-scene='memory']) .memory__title,
  :global(.experience[data-scene='memory']) .memory__body,
  :global(.experience[data-scene='memory']) .memory__closing,
  :global(.experience[data-scene='memory']) .memory__cta {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.experience.is-transitioning[data-transition-direction='forward']) .memory__eyebrow,
    :global(.experience.is-transitioning[data-transition-direction='forward']) .memory__title {
      transition: opacity 500ms ease, transform 500ms ease;
      transition-delay: 2050ms;
    }

    :global(.experience.is-transitioning[data-transition-direction='forward']) .memory__body {
      transition: opacity 500ms ease, transform 500ms ease;
      transition-delay: 2300ms;
    }

    :global(.experience.is-transitioning[data-transition-direction='forward']) .memory__closing,
    :global(.experience.is-transitioning[data-transition-direction='forward']) .memory__cta {
      transition: opacity 500ms ease, transform 500ms ease;
      transition-delay: 2450ms;
    }

    :global(.experience.is-transitioning[data-transition-direction='back']) .memory__eyebrow,
    :global(.experience.is-transitioning[data-transition-direction='back']) .memory__title,
    :global(.experience.is-transitioning[data-transition-direction='back']) .memory__body,
    :global(.experience.is-transitioning[data-transition-direction='back']) .memory__closing,
    :global(.experience.is-transitioning[data-transition-direction='back']) .memory__cta {
      transition: opacity 400ms ease, transform 400ms ease;
    }
  }

  :global(.experience.is-reduced-motion) .memory__eyebrow,
  :global(.experience.is-reduced-motion) .memory__title,
  :global(.experience.is-reduced-motion) .memory__body,
  :global(.experience.is-reduced-motion) .memory__closing,
  :global(.experience.is-reduced-motion) .memory__cta,
  :global(.experience.is-instant) .memory__eyebrow,
  :global(.experience.is-instant) .memory__title,
  :global(.experience.is-instant) .memory__body,
  :global(.experience.is-instant) .memory__closing,
  :global(.experience.is-instant) .memory__cta {
    transition: none !important;
  }

  /* Landscape (rotated phones, tablets, laptops): redistribute into two
     columns instead of just re-flowing the same vertical stack sideways. */
  @media (orientation: landscape) and (min-width: 560px) {
    .memory__content {
      max-width: min(88vw, 980px);
      display: grid;
      grid-template-columns: 1.05fr 1.3fr;
      column-gap: clamp(28px, 5vw, 72px);
      align-items: center;
      padding-top: max(28px, env(safe-area-inset-top));
    }

    .memory__eyebrow,
    .memory__title {
      grid-column: 1;
    }

    .memory__body,
    .memory__closing,
    .memory__cta {
      grid-column: 2;
    }

    .memory__title {
      margin-top: 0.4em;
    }
  }
</style>
