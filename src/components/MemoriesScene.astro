---
// Placeholder only, per spec ("de momento solo crea el CTA y una ruta/
// subescena placeholder limpia... no inventes contenido todavía") -- no
// gallery, no videos yet. Reuses textura_vertical_2.png as its own
// background (same texture WhoWeAreScene.astro already uses, itself
// already cached from Cover.astro's own first paint) rather than
// inventing a new photo for a page with no real content yet.
import { sceneMemories } from '../data/sceneMemories';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<div class="memories" data-scene-panel-content aria-label={sceneMemories.eyebrow}>
  <div class="memories__texture" style={`background-image: url('${base}/images/textura_vertical_2.png')`}></div>
  <span class="memories__wash" aria-hidden="true"></span>
  <button type="button" class="memories__back" data-action="back-to-about" aria-label={sceneMemories.backLabel}>
    <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
      <path d="M15 5 L8 12 L15 19" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
    <span>{sceneMemories.backVisibleLabel}</span>
  </button>

  <div class="memories__content">
    <p class="memories__eyebrow" data-memories-part="eyebrow">
      <span class="memories__halo" aria-hidden="true"></span>
      {sceneMemories.eyebrow}
    </p>
    <h2 class="memories__title" data-scene-heading data-memories-part="title" tabindex="-1">
      <span class="memories__halo memories__halo--wide" aria-hidden="true"></span>
      {sceneMemories.title}
    </h2>
    <p class="memories__body" data-memories-part="body">
      <span class="memories__halo memories__halo--wide" aria-hidden="true"></span>
      {sceneMemories.body}
    </p>
  </div>
</div>

<style>
  .memories {
    position: relative;
    width: 100%;
    height: 100%;
    isolation: isolate;
    overflow: hidden;
  }

  .memories__texture {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }

  .memories__back {
    position: absolute;
    top: max(18px, env(safe-area-inset-top));
    left: max(18px, env(safe-area-inset-left));
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: none;
    border: none;
    padding: 0.4rem 0.2rem;
    cursor: pointer;
    font-family: var(--font-sans);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #3a332b;
    opacity: 0;
  }

  .memories__back::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: -6px -10px;
    pointer-events: none;
    background: radial-gradient(ellipse at center, rgba(255, 254, 248, 0.95), rgba(255, 254, 248, 0) 80%);
  }

  :global(.experience.is-memories-revealing) .memories__back {
    opacity: 1;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.experience:not(.is-instant)) .memories__back {
      transition: opacity 320ms ease, color 0.2s ease, transform 0.2s ease;
    }

    .memories__back:hover,
    .memories__back:focus-visible {
      color: var(--color-accent);
      transform: translateX(-2px);
    }
  }

  :global(.experience.is-instant) .memories__back {
    transition: none !important;
  }

  .memories__content {
    position: relative;
    margin: auto;
    width: 100%;
    max-width: 358.8px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    padding: 0 28px;
  }

  .memories__wash {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(
        ellipse 92% 70% at 30% 62%,
        rgba(255, 251, 244, 0.3) 0%,
        rgba(255, 251, 244, 0.16) 52%,
        rgba(255, 251, 244, 0) 88%
      ),
      linear-gradient(
        to right,
        rgba(255, 251, 244, 0.58) 0%,
        rgba(255, 251, 244, 0.4) 36%,
        rgba(255, 251, 244, 0.16) 60%,
        rgba(255, 251, 244, 0) 88%
      );
    -webkit-mask-image: linear-gradient(to bottom, transparent 0%, rgba(0, 0, 0, 1) 30%, rgba(0, 0, 0, 1) 100%);
    mask-image: linear-gradient(to bottom, transparent 0%, rgba(0, 0, 0, 1) 30%, rgba(0, 0, 0, 1) 100%);
  }

  .memories__halo {
    position: absolute;
    z-index: -1;
    pointer-events: none;
    inset: -10px -18px;
    background: radial-gradient(ellipse at center, rgba(255, 254, 248, 0.9) 0%, rgba(255, 254, 248, 0) 72%);
  }

  .memories__halo--wide {
    inset: -14px -24px;
  }

  .memories__eyebrow {
    position: relative;
    margin: 0 0 18px;
    font-family: var(--font-sans);
    text-transform: uppercase;
    letter-spacing: 0.22em;
    font-size: 0.68rem;
    color: #6f6350;
  }

  .memories__title {
    position: relative;
    margin: 0 0 22px;
    font-family: var(--font-serif);
    font-style: normal;
    font-weight: 400;
    font-size: 2.15rem;
    line-height: 1.25;
    color: #4a3a28;
    outline: none;
    /* Copy itself (sceneMemories.title) is untouched -- this is purely a
       visual uppercase transform, per spec. */
    text-transform: uppercase;
  }

  .memories__body {
    position: relative;
    margin: 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    font-size: 1.1rem;
    line-height: 1.6;
    color: #241a12;
  }

  [data-memories-part] {
    opacity: 0;
    transform: translateY(10px);
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.experience.is-memories-revealing) [data-memories-part] {
      transition: opacity 700ms ease, transform 700ms ease;
    }

    :global(.experience.is-memories-revealing) [data-memories-part='eyebrow'] {
      opacity: 1;
      transform: translateY(0);
      transition-delay: 150ms;
    }

    :global(.experience.is-memories-revealing) [data-memories-part='title'] {
      opacity: 1;
      transform: translateY(0);
      transition-delay: 380ms;
    }

    :global(.experience.is-memories-revealing) [data-memories-part='body'] {
      opacity: 1;
      transform: translateY(0);
      transition-delay: 650ms;
    }
  }

  :global(.experience.is-reduced-motion.is-memories-revealing) [data-memories-part],
  :global(.experience.is-instant) [data-memories-part] {
    transition: opacity 260ms ease !important;
    transform: none !important;
    transition-delay: 0ms !important;
  }

  :global(.experience.is-reduced-motion.is-memories-revealing) [data-memories-part],
  :global(.experience[data-scene='memories'].is-instant) [data-memories-part] {
    opacity: 1;
    transform: translateY(0);
  }
</style>
