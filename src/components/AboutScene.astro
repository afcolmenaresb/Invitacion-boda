---
import { sceneAbout } from '../data/sceneAbout';
---

<div class="about" data-scene-panel-content aria-label={sceneAbout.eyebrow}>
  <span class="about__wash" aria-hidden="true"></span>
  <button type="button" class="about__back" data-action="back-to-cover" aria-label={sceneAbout.backLabel}>
    <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
      <path d="M15 5 L8 12 L15 19" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
    <span>{sceneAbout.backVisibleLabel}</span>
  </button>

  <div class="about__content">
    <p class="about__eyebrow" data-about-part="eyebrow">
      <span class="about__halo" aria-hidden="true"></span>
      {sceneAbout.eyebrow}
    </p>
    <h2 class="about__title" data-scene-heading data-about-part="title" tabindex="-1">
      <span class="about__halo about__halo--wide" aria-hidden="true"></span>
      {sceneAbout.title}
    </h2>
    <p class="about__body" data-about-part="body">
      <span class="about__halo about__halo--wide" aria-hidden="true"></span>
      {sceneAbout.body}
    </p>

    <div class="about__ctas" data-about-part="ctas">
      <button type="button" class="about__cta" data-action="go-to-who-we-are">
        {sceneAbout.ctaWhoWeAre}
      </button>
      <button type="button" class="about__cta about__cta--secondary" data-action="go-to-faq">
        {sceneAbout.ctaFaq}
      </button>
    </div>
  </div>
</div>

<style>
  .about {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    isolation: isolate;
  }

  /* Same control as every previous scene's own back button -- identical
     position, type treatment and icon. Targets the cover directly since
     this sub-tree currently has no dedicated entry CTA elsewhere in the
     experience (see InvitationExperience.astro's own comment). */
  .about__back {
    position: absolute;
    top: max(18px, env(safe-area-inset-top));
    left: max(18px, env(safe-area-inset-left));
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: none;
    border: none;
    padding: 0.4rem 0.2rem;
    cursor: pointer;
    font-family: var(--font-sans);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #3a332b;
    opacity: 0;
  }

  .about__back::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: -6px -10px;
    pointer-events: none;
    background: radial-gradient(ellipse at center, rgba(255, 254, 248, 0.95), rgba(255, 254, 248, 0) 80%);
  }

  :global(.experience.is-about-revealing) .about__back {
    opacity: 1;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.experience:not(.is-instant)) .about__back {
      transition: opacity 320ms ease, color 0.2s ease, transform 0.2s ease;
    }

    .about__back:hover,
    .about__back:focus-visible {
      color: var(--color-accent);
      transform: translateX(-2px);
    }
  }

  :global(.experience.is-instant) .about__back {
    transition: none !important;
  }

  /* Same fixed 390x844 canvas convention as every other scene. */
  .about__content {
    position: relative;
    margin: auto;
    width: 100%;
    max-width: 358.8px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    padding: 0 28px;
  }

  /* Reading column wash -- identical recipe to every other scene's own
     .X__wash (JourneyScene/.../StayScene), kept consistent. */
  .about__wash {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse 60% 44% at 26% 66%, rgba(255, 251, 244, 0.26) 0%, rgba(255, 251, 244, 0) 78%),
      linear-gradient(
        to right,
        rgba(255, 251, 244, 0.55) 0%,
        rgba(255, 251, 244, 0.38) 36%,
        rgba(255, 251, 244, 0.14) 60%,
        rgba(255, 251, 244, 0) 88%
      );
    -webkit-mask-image: linear-gradient(to bottom, transparent 0%, rgba(0, 0, 0, 1) 38%, rgba(0, 0, 0, 1) 100%);
    mask-image: linear-gradient(to bottom, transparent 0%, rgba(0, 0, 0, 1) 38%, rgba(0, 0, 0, 1) 100%);
  }

  .about__halo {
    position: absolute;
    z-index: -1;
    pointer-events: none;
    inset: -10px -18px;
    background: radial-gradient(ellipse at center, rgba(255, 254, 248, 0.9) 0%, rgba(255, 254, 248, 0) 72%);
  }

  .about__halo--wide {
    inset: -14px -24px;
  }

  .about__eyebrow {
    position: relative;
    margin: 0 0 18px;
    font-family: var(--font-sans);
    text-transform: uppercase;
    letter-spacing: 0.22em;
    font-size: 0.68rem;
    color: #6f6350;
  }

  .about__title {
    position: relative;
    margin: 0 0 22px;
    font-family: var(--font-serif);
    font-style: normal;
    font-weight: 400;
    font-size: 2.15rem;
    line-height: 1.25;
    color: #4a3a28;
    outline: none;
  }

  .about__body {
    position: relative;
    margin: 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    font-size: 1.1rem;
    line-height: 1.6;
    color: #241a12;
  }

  /* Two clear, editorial CTAs -- same sans/uppercase/arrow language as
     every other primary CTA, stacked with generous breathing room so
     they read as two distinct doors, never a button pair. */
  .about__ctas {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 22px;
    margin: 40px 0 0;
  }

  .about__cta {
    display: block;
    background: none;
    border: none;
    padding: 0;
    text-align: left;
    cursor: pointer;
    font-family: var(--font-sans);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-size: 0.92rem;
    color: #221a10;
  }

  .about__cta::after {
    content: ' →';
  }

  .about__cta--secondary {
    font-size: 0.8rem;
    color: #6b6055;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.experience:not(.is-instant)) .about__cta {
      transition: color 0.2s ease;
    }

    .about__cta:hover,
    .about__cta:focus-visible {
      color: var(--color-accent);
    }
  }

  /*
    Entrance: plain, quiet opacity + small translateY, same convention as
    every other scene. Hidden by default; each part becomes visible once
    is-about-revealing lands on the shared .experience root.
  */
  [data-about-part] {
    opacity: 0;
    transform: translateY(10px);
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.experience.is-about-revealing) [data-about-part] {
      transition: opacity 700ms ease, transform 700ms ease;
    }

    :global(.experience.is-about-revealing) [data-about-part='eyebrow'] {
      opacity: 1;
      transform: translateY(0);
      transition-delay: 150ms;
    }

    :global(.experience.is-about-revealing) [data-about-part='title'] {
      opacity: 1;
      transform: translateY(0);
      transition-delay: 380ms;
    }

    :global(.experience.is-about-revealing) [data-about-part='body'] {
      opacity: 1;
      transform: translateY(0);
      transition-delay: 650ms;
    }

    :global(.experience.is-about-revealing) [data-about-part='ctas'] {
      opacity: 1;
      transform: translateY(0);
      transition-delay: 950ms;
    }
  }

  /*
    Reduced motion / instant loads: no per-part stagger, one short,
    uniform fade, same convention as every previous scene.
  */
  :global(.experience.is-reduced-motion.is-about-revealing) [data-about-part],
  :global(.experience.is-instant) [data-about-part] {
    transition: opacity 260ms ease !important;
    transform: none !important;
    transition-delay: 0ms !important;
  }

  :global(.experience.is-reduced-motion.is-about-revealing) [data-about-part],
  :global(.experience[data-scene='about'].is-instant) [data-about-part] {
    opacity: 1;
    transform: translateY(0);
  }
</style>
