---
import '@fontsource/sacramento/400.css';
import '@fontsource/homemade-apple/400.css';
import { getDedicationLength } from '../data/guests';

interface Props {
  displayName?: string;
  dedication?: string;
}

const {
  displayName = 'Estefi y Matías',
  dedication = 'Hay viajes que no tendrían el mismo sentido sin ciertas personas.',
} = Astro.props;

const dedicationLength = getDedicationLength(dedication);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<script is:inline>
  // Runs synchronously, before the fixed-canvas markup below is painted, so
  // every --cover-scale* variable is already correct on first paint (no
  // flash from a generic fallback value, no temporary margins). One single
  // recalculation function handles every device path so there is exactly
  // one set of listeners.
  //
  // Whether a device counts as "mobile/tablet" is decided by input type,
  // never by window width alone -- a laptop resized to a narrow window is
  // still a laptop. isMobileOrTablet requires BOTH a coarse pointer (or
  // touch points) AND a short side of 1024px or less:
  //
  // - isMobileOrTablet && portrait (viewportWidth <= viewportHeight): the
  //   fixed 390x844 canvas is stretched, non-uniformly, to exactly fill
  //   the visible viewport -- --cover-scale-x/--cover-scale-y -- via the
  //   `is-fill-viewport` class on <html>, which also removes any outer
  //   margin/scroll (see the global styles below).
  // - isMobileOrTablet && landscape (viewportWidth > viewportHeight): the
  //   invitation itself never shows -- `is-landscape-locked` on <html>
  //   reveals the full-viewport rotate-device notice instead.
  // - anything else (laptops/desktops, in any orientation or window size):
  //   untouched from before -- a single uniform --cover-scale =
  //   Math.min(viewportWidth/390, viewportHeight/844), read verbatim by
  //   .cover-canvas's existing rule; the rotate-device notice never shows.
  (function () {
    var TOUCH_SHORT_SIDE_MAX = 1024;
    var CANVAS_WIDTH = 390;
    var CANVAS_HEIGHT = 844;
    var root = document.documentElement;
    var scheduled = false;

    // Section 3's exact formula: visualViewport first (it tracks mobile
    // toolbars, the on-screen keyboard and pinch-zoom correctly), falling
    // back to the documentElement's client box.
    function getViewportWidth() {
      return (window.visualViewport && window.visualViewport.width) || document.documentElement.clientWidth;
    }
    function getViewportHeight() {
      return (window.visualViewport && window.visualViewport.height) || document.documentElement.clientHeight;
    }

    function update() {
      scheduled = false;

      var viewportWidth = getViewportWidth();
      var viewportHeight = getViewportHeight();

      var isTouchDevice =
        window.matchMedia('(pointer: coarse)').matches || navigator.maxTouchPoints > 0;
      var shortSide = Math.min(viewportWidth, viewportHeight);
      var isMobileOrTablet = isTouchDevice && shortSide <= TOUCH_SHORT_SIDE_MAX;
      var isLandscape = viewportWidth > viewportHeight;

      var isFillViewport = isMobileOrTablet && !isLandscape;
      var isLandscapeLocked = isMobileOrTablet && isLandscape;

      root.classList.toggle('is-fill-viewport', isFillViewport);
      root.classList.toggle('is-landscape-locked', isLandscapeLocked);
      var locked = isFillViewport || isLandscapeLocked;
      root.classList.toggle('is-viewport-locked', locked);
      if (document.body) {
        document.body.classList.toggle('is-viewport-locked', locked);
      }

      if (isFillViewport) {
        root.style.setProperty('--cover-scale-x', String(viewportWidth / CANVAS_WIDTH));
        root.style.setProperty('--cover-scale-y', String(viewportHeight / CANVAS_HEIGHT));
        root.style.setProperty('--cover-viewport-width', viewportWidth + 'px');
        root.style.setProperty('--cover-viewport-height', viewportHeight + 'px');
      } else if (!isMobileOrTablet) {
        // Laptop/desktop path -- untouched: the same single uniform
        // (contain-style) --cover-scale as before, in any orientation or
        // window size, never gated by touch/pointer.
        var scale = Math.min(viewportWidth / CANVAS_WIDTH, viewportHeight / CANVAS_HEIGHT);
        root.style.setProperty('--cover-scale', String(scale));
      }
    }

    function scheduleUpdate() {
      if (scheduled) return;
      scheduled = true;
      requestAnimationFrame(update);
    }

    update();
    window.addEventListener('resize', scheduleUpdate);
    window.addEventListener('orientationchange', scheduleUpdate);
    if (window.visualViewport) {
      window.visualViewport.addEventListener('resize', scheduleUpdate);
      // Mobile browsers shrink/grow the visual viewport (address bar,
      // on-screen keyboard) by scrolling it, not just resizing it.
      window.visualViewport.addEventListener('scroll', scheduleUpdate);
    }

    // Best-effort only -- orientation can't be forced; the rotate-device
    // overlay above is the real, always-working fallback.
    if (screen.orientation && screen.orientation.lock) {
      screen.orientation.lock('portrait').catch(function () {});
    }
  })();
</script>

<div
  class="orientation-lock"
  style={`background-image: url('${base}/images/textura_vertical_2.png')`}
>
  <div class="orientation-lock__content">
    <svg
      class="orientation-lock__icon"
      viewBox="0 0 48 80"
      width="48"
      height="80"
      aria-hidden="true"
      focusable="false"
    >
      <rect x="4" y="4" width="40" height="72" rx="8" fill="none" stroke="currentColor" stroke-width="3" />
      <line x1="18" y1="70" x2="30" y2="70" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
    </svg>
    <p class="orientation-lock__text">Para vivir esta experiencia,<br />gira tu dispositivo.</p>
  </div>
</div>

<div class="cover-frame" style={`background-image: url('${base}/images/textura_vertical_2.png')`}>
  <div class="cover-canvas">
    <header class="cover" data-animation-state="normal" data-cover-boot="pending">
      <img
        class="cover__texture"
    src={`${base}/images/textura-vertical.png`}
    alt=""
    role="presentation"
    width="705"
    height="967"
    loading="eager"
  />
  <div
    class="cover__texture-v2"
    style={`background-image: url('${base}/images/textura_vertical_2.png')`}
  >
  </div>
  <svg
    class="cover__foam-abstract"
    viewBox="0 0 400 200"
    preserveAspectRatio="xMaxYMax slice"
    aria-hidden="true"
    focusable="false"
  >
    <defs>
      <filter id="foamBlur" x="-30%" y="-30%" width="160%" height="160%">
        <feGaussianBlur stdDeviation="7" />
      </filter>
    </defs>
    <path
      class="cover__foam-shape"
      d="M400,200 L400,128 C372,120 344,101 313,105 C282,109 268,132 233,129
         C198,126 190,148 155,146 C120,144 108,163 72,160
         C46,158 30,172 0,168 L0,200 Z"
      fill="#fbf5e7"
      filter="url(#foamBlur)"
    />
    <g class="cover__foam-flecks" fill="#fdf9ef">
      <circle cx="150" cy="132" r="3" />
      <circle cx="182" cy="121" r="2" />
      <circle cx="212" cy="136" r="3.6" />
      <circle cx="260" cy="110" r="2.2" />
      <circle cx="296" cy="115" r="3" />
      <circle cx="330" cy="100" r="2" />
      <circle cx="103" cy="155" r="2.4" />
      <circle cx="66" cy="162" r="3" />
      <circle cx="35" cy="170" r="2" />
    </g>
  </svg>
  <img
    class="cover__elephant"
    data-animation="elephant"
    src={`${base}/images/elephant.png`}
    alt="Ilustración de un elefante de perfil entrando desde la izquierda, trazo fino"
    width="1101"
    height="1856"
    loading="eager"
  />
  <img
    class="cover__duck"
    data-animation="duck"
    src={`${base}/images/duck.png`}
    alt="Ilustración de un pato mirando hacia el bloque central, trazo fino"
    width="768"
    height="1376"
    loading="eager"
  />

  <div class="cover__intro" data-length={dedicationLength}>
    <p class="cover__kicker" data-autofit="width" data-animation="guest-name">{displayName}</p>
    <p class="cover__lede" data-autofit="width" data-animation="dedication">{dedication}</p>
  </div>

  <div class="cover__names">
    <h1 class="cover__title" data-autofit="width">
      <span class="signature-fatima" data-animation="name-fatima">Fátima</span>
      <span class="cover__amp signature-amp" data-animation="name-separator">&amp;</span>
      <span class="signature-andres" data-animation="name-andres">Andrés</span>
    </h1>
  </div>

  <div class="cover__meta">
    <p class="cover__location" data-animation="location">Imbassaí, Bahía</p>
    <a class="cover__cta" href="#viaje" data-animation="cta">Comenzar el viaje</a>
  </div>
    </header>
  </div>
</div>

<script>
  function fitText(el: HTMLElement) {
    el.style.fontSize = '';
    const maxSize = parseFloat(getComputedStyle(el).fontSize);
    let size = maxSize;
    let guard = 0;
    while (el.scrollWidth > el.clientWidth && size > 10 && guard < 80) {
      size -= 1;
      el.style.fontSize = size + 'px';
      guard++;
    }
  }

  function fitAll() {
    document.querySelectorAll<HTMLElement>('[data-autofit]').forEach(fitText);
  }

  fitAll();
  document.fonts?.ready.then(fitAll);
  window.addEventListener('resize', fitAll);

  // --- Slow handwritten-ink intro (name, dedication, signature, location, CTA) ---
  //
  // Whole sequence targets ~18-23s (default guest ~20.5-21s): a long,
  // intimate, continuous "ink on paper" reveal, not a fast UI transition.
  // Duck, elephant, texture and background are never touched here -- they
  // are visible from the very first frame.
  const EASE = 'cubic-bezier(0.22, 0.61, 0.36, 1)';

  function clamp(value: number, min: number, max: number) {
    return Math.min(max, Math.max(min, value));
  }

  // Evaluates the same curve as EASE, so --reveal can be driven manually
  // in step with the native CSS transition used for clip-path (see below).
  function cubicBezierEase(p1x: number, p1y: number, p2x: number, p2y: number) {
    const cx = 3 * p1x;
    const bx = 3 * (p2x - p1x) - cx;
    const ax = 1 - cx - bx;
    const cy = 3 * p1y;
    const by = 3 * (p2y - p1y) - cy;
    const ay = 1 - cy - by;
    const sampleX = (t: number) => ((ax * t + bx) * t + cx) * t;
    const sampleY = (t: number) => ((ay * t + by) * t + cy) * t;
    const sampleDerivativeX = (t: number) => (3 * ax * t + 2 * bx) * t + cx;
    return (x: number) => {
      let t = x;
      for (let i = 0; i < 6; i++) {
        const dx = sampleX(t) - x;
        const d = sampleDerivativeX(t);
        if (Math.abs(d) < 1e-6) break;
        t -= dx / d;
      }
      return sampleY(clamp(t, 0, 1));
    };
  }
  const easeReveal = cubicBezierEase(0.22, 0.61, 0.36, 1);

  function sleep(ms: number) {
    return new Promise<void>((resolve) => setTimeout(resolve, ms));
  }

  function nextFrame() {
    return new Promise<void>((resolve) => requestAnimationFrame(() => requestAnimationFrame(() => resolve())));
  }

  function waitForImages(root: ParentNode) {
    const imgs = Array.from(root.querySelectorAll<HTMLImageElement>('img[loading="eager"]'));
    return Promise.all(
      imgs.map((img) =>
        img.complete
          ? Promise.resolve()
          : new Promise<void>((resolve) => {
              img.addEventListener('load', () => resolve(), { once: true });
              img.addEventListener('error', () => resolve(), { once: true });
            })
      )
    );
  }

  // document.fonts.ready is the primary, cross-browser guarantee that the
  // custom typeface used by name/dedication/signature (all "Homemade
  // Apple") has finished loading. document.fonts.check is an extra,
  // best-effort confirmation on top of it -- wrapped in try/catch since
  // it isn't universally supported and a malformed/unsupported call must
  // never block the boot guard from ever lifting.
  async function waitForSignatureFonts(): Promise<void> {
    if (!document.fonts) return;
    await document.fonts.ready;
    try {
      const spec = '400 16px "Homemade Apple"';
      if (!document.fonts.check(spec)) {
        await document.fonts.load(spec);
      }
    } catch {
      // Unsupported in this engine -- document.fonts.ready above already
      // resolved, which is the real guarantee.
    }
  }

  // Slightly irregular vertical boundary, sampled top-to-bottom, so the ink
  // front reads as an uneven hand-drawn stroke rather than a ruled line.
  function jaggedClipPath(percent: number, seed: number) {
    const steps = 7;
    const points = ['0% 0%'];
    for (let i = 0; i <= steps; i++) {
      const t = i / steps;
      const jitter = Math.sin((t * 6 + seed) * 3.7) * 2.2;
      const x = clamp(percent + jitter, 0, 100);
      points.push(`${x.toFixed(2)}% ${(t * 100).toFixed(2)}%`);
    }
    points.push('0% 100%');
    return `polygon(${points.join(', ')})`;
  }

  // A short, soft semi-transparent band riding just ahead of the jagged
  // clip edge -- "wet ink still settling" -- instead of a hard on/off cut.
  // Opaque BEFORE --reveal (already written), transparent AFTER it (not
  // yet reached). Every stop is offset FROM var(--reveal) -- none pinned
  // to a fixed 0%/100% -- so the whole ramp translates as one piece as
  // --reveal animates, instead of leaving a fixed band near the left edge
  // that doesn't track the sweep. At REVEAL_HIDDEN the entire ramp sits
  // left of 0% (fully transparent across the box); at REVEAL_SHOWN it
  // sits entirely right of 100% (fully opaque across the box).
  const INK_MASK =
    'linear-gradient(90deg, ' +
    '#000 calc(var(--reveal) - 60%), #000 calc(var(--reveal) - 7%), ' +
    'rgba(0,0,0,.6) calc(var(--reveal) - 3%), rgba(0,0,0,.18) var(--reveal), ' +
    'transparent calc(var(--reveal) + 4%), transparent calc(var(--reveal) + 60%))';
  const REVEAL_HIDDEN_NUM = -12;
  const REVEAL_SHOWN_NUM = 110;
  const REVEAL_HIDDEN = `${REVEAL_HIDDEN_NUM}%`;
  const REVEAL_SHOWN = `${REVEAL_SHOWN_NUM}%`;

  // Sets the fully-hidden state instantly (no transition), so this is what
  // gets painted on the very first frame -- never a flash of visible text.
  function prepareInkHidden(el: HTMLElement, seed: number) {
    el.style.transition = 'none';
    el.style.clipPath = jaggedClipPath(-10, seed);
    el.style.setProperty('--reveal', REVEAL_HIDDEN);
    el.style.setProperty('mask-image', INK_MASK);
    el.style.setProperty('-webkit-mask-image', INK_MASK);
  }

  // Whether this engine actually tweens a *typed* custom property. Checked
  // once, live, instead of assumed: a CSS transition on --reveal only
  // interpolates smoothly when @property registered it as a <percentage>;
  // unregistered/unsupported engines snap it instantly at the transition's
  // halfway point, which is exactly the "signature pops at the end" bug.
  let revealTransitionVerified: boolean | null = null;

  function verifyRevealInterpolates(el: HTMLElement) {
    if (revealTransitionVerified !== null) return revealTransitionVerified;
    const probe = document.createElement('span');
    probe.style.position = 'absolute';
    probe.style.visibility = 'hidden';
    probe.style.setProperty('--reveal', '0%');
    probe.style.setProperty('transition', '--reveal 100ms linear');
    document.body.appendChild(probe);
    void probe.offsetWidth; // force layout so the starting value is committed
    probe.style.setProperty('--reveal', '100%');
    const midway = getComputedStyle(probe).getPropertyValue('--reveal').trim();
    probe.remove();
    // If the browser can't tween it, the computed value right after the
    // change either jumps straight to 100% or reports something that
    // isn't a mid-range percentage -- either way, not real interpolation.
    const midValue = parseFloat(midway);
    revealTransitionVerified = Number.isFinite(midValue) && midValue > 0 && midValue < 100;
    return revealTransitionVerified;
  }

  // Drives clip-path (a natively-animatable property) via a real CSS
  // transition, and drives --reveal by hand, frame by frame, with the
  // *same* easing curve -- so the ink-mask's soft edge always tracks
  // progressively regardless of @property support, instead of snapping
  // straight to "fully revealed" only when resetInkUnit later clears the
  // mask (the "pop"). CSS transition is kept as a harmless no-op fallback
  // for engines that do support it, since both land on the same values.
  function triggerInkReveal(el: HTMLElement, duration: number, delay: number, seed: number) {
    verifyRevealInterpolates(el);
    el.style.transition = `clip-path ${duration}ms ${EASE} ${delay}ms`;
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        el.style.clipPath = jaggedClipPath(112, seed);
      });
    });

    let start: number | null = null;
    function step(now: number) {
      if (start === null) start = now;
      const elapsed = now - start - delay;
      if (elapsed < 0) {
        requestAnimationFrame(step);
        return;
      }
      const t = clamp(elapsed / duration, 0, 1);
      const value = REVEAL_HIDDEN_NUM + (REVEAL_SHOWN_NUM - REVEAL_HIDDEN_NUM) * easeReveal(t);
      el.style.setProperty('--reveal', `${value.toFixed(2)}%`);
      if (t < 1) {
        requestAnimationFrame(step);
      }
    }
    requestAnimationFrame(step);
  }

  function resetInkUnit(el: HTMLElement) {
    el.style.clipPath = '';
    el.style.transition = '';
    el.style.removeProperty('--reveal');
    el.style.removeProperty('mask-image');
    el.style.removeProperty('-webkit-mask-image');
  }

  // --- Signature reveal: one rectangular clip over the whole signature ---
  //
  // "Fátima & Andrés" reveals as a single unit -- one clip-path: inset(...)
  // applied to .cover__names, whose right edge sweeps from fully-closed to
  // fully-open. There is no per-word clip, mask or progress: whatever the
  // sweep has reached (Fátima, then &, then Andrés) is simply whatever
  // falls inside the currently-visible rectangle. The clip is sized to an
  // *expanded* box -- .cover__names' own measured width plus a fixed
  // safety margin on every side (20px above, 55px below, 20px left, 20px
  // right) so ascenders, descenders and calligraphic overshoot across the
  // whole signature always sit inside the clipped area, never trimmed by
  // a box clipped tight to the typographic bounding box. Insets are
  // computed in plain px from the element's own measured width -- never
  // CSS %, which is always relative to the box's *own* width alone and
  // can't express "hide the margin too" -- so progress=0 truly hides the
  // entire expanded box, margin included, not just the original width.
  // The left edge of the expanded box never moves (never used to drive
  // progress); only the right edge sweeps, from 0px visible up to the
  // expanded width.
  const SIGNATURE_MARGIN_TOP = 20;
  const SIGNATURE_MARGIN_BOTTOM = 55;
  const SIGNATURE_MARGIN_LEFT = 20;
  const SIGNATURE_MARGIN_RIGHT = 20;

  function signatureClipPath(progress: number, width: number): string {
    const expandedWidth = width + SIGNATURE_MARGIN_LEFT + SIGNATURE_MARGIN_RIGHT;
    const rightInset = (1 - progress) * expandedWidth - SIGNATURE_MARGIN_RIGHT;
    return `inset(-${SIGNATURE_MARGIN_TOP}px ${rightInset}px -${SIGNATURE_MARGIN_BOTTOM}px -${SIGNATURE_MARGIN_LEFT}px)`;
  }

  // Closes the clip down to nothing, instantly, so this is what's painted
  // on the very first frame -- never a flash of any part of the signature.
  function prepareSignatureHidden(el: HTMLElement) {
    el.style.clipPath = signatureClipPath(0, el.offsetWidth);
  }

  // Linear, frame-driven progress: the whole assigned duration is spent
  // sweeping (no easing curve lets the clip "arrive early"), so the
  // signature advances uniformly and is never near-complete early on.
  function signatureProgress(t: number): number {
    if (t <= 0) return 0;
    if (t >= 1) return 1;
    return t;
  }

  function triggerSignatureReveal(el: HTMLElement, duration: number, delay: number) {
    const width = el.offsetWidth;
    const startTime = performance.now() + delay;
    let resetFrames = 0;

    function step(now: number) {
      const progress = clamp((now - startTime) / duration, 0, 1);
      el.style.clipPath = signatureClipPath(signatureProgress(progress), width);

      if (progress < 1) {
        requestAnimationFrame(step);
        return;
      }

      // progress === 1: the signature is already fully visible -- wait
      // two more frames, invisibly holding that finished state, before
      // any caller-side cleanup runs, so the reset never overlaps the
      // settle.
      if (resetFrames < 2) {
        resetFrames += 1;
        requestAnimationFrame(step);
      }
    }

    requestAnimationFrame(step);
  }

  // Waits exactly two rAF frames (never setTimeout) past the fully-revealed
  // state before touching the clip-path, then re-applies the very same
  // fully-revealed value -- so the frame right before and right after this
  // runs are visually identical, never a pop.
  function resetSignatureUnit(el: HTMLElement) {
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        el.style.clipPath = signatureClipPath(1, el.offsetWidth);
      });
    });
  }

  // Location and CTA are not "written" -- they simply settle in once the
  // signature is done, per spec: a plain gentle fade + tiny rise.
  function prepareFadeHidden(el: HTMLElement) {
    el.style.transition = 'none';
    el.style.opacity = '0';
    el.style.transform = 'translateY(2px)';
  }

  function triggerFade(el: HTMLElement, duration: number, delay: number) {
    el.style.transition = `opacity ${duration}ms ease-out ${delay}ms, transform ${duration}ms ease-out ${delay}ms`;
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        el.style.opacity = '1';
        el.style.transform = 'translateY(0)';
      });
    });
  }

  function resetFadeUnit(el: HTMLElement) {
    el.style.opacity = '';
    el.style.transform = '';
    el.style.transition = '';
  }

  function prepareUnderlineHidden(el: HTMLElement) {
    el.style.setProperty('--cta-underline', '0%');
  }

  function triggerUnderline(el: HTMLElement, duration: number, delay: number) {
    el.style.setProperty('transition', `${el.style.transition ? el.style.transition + ', ' : ''}--cta-underline ${duration}ms ${EASE} ${delay}ms`);
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        el.style.setProperty('--cta-underline', '100%');
      });
    });
  }

  function resetUnderline(el: HTMLElement) {
    el.style.removeProperty('--cta-underline');
  }

  // Wraps each word in a span, measures its rendered line via offsetTop,
  // then regroups the words into per-line wrappers. Works for any text
  // length/line count without hard-coding a number of lines.
  function splitIntoLines(el: HTMLElement): HTMLElement[] {
    const original = el.textContent ?? '';
    const tokens = original.match(/\S+\s*/g) ?? [original];

    el.textContent = '';
    const wordEls = tokens.map((token) => {
      const span = document.createElement('span');
      span.className = 'ink-word';
      span.textContent = token;
      el.appendChild(span);
      return span;
    });

    const lineMap = new Map<number, HTMLElement[]>();
    wordEls.forEach((span) => {
      const top = span.offsetTop;
      if (!lineMap.has(top)) lineMap.set(top, []);
      lineMap.get(top)!.push(span);
    });

    const tops = [...lineMap.keys()].sort((a, b) => a - b);
    el.textContent = '';
    return tops.map((top) => {
      const lineEl = document.createElement('span');
      lineEl.className = 'ink-line';
      lineMap.get(top)!.forEach((span) => lineEl.appendChild(span));
      el.appendChild(lineEl);
      return lineEl;
    });
  }

  // Reveals lines top-to-bottom as one continuous gesture: each line's
  // share of the total duration is weighted by its actual rendered width
  // (not char count), and the next line begins before the previous one
  // has fully settled (LINE_OVERLAP_MS) so the multi-line block reads as
  // a single unbroken stroke rather than independent chunks loading in.
  const LINE_OVERLAP_MS = 210;
  const MIN_LINE_DURATION_MS = 550;

  function revealLines(lines: HTMLElement[], totalDuration: number, seedBase: number) {
    const n = lines.length;
    if (n === 0) return 0;
    if (n === 1) {
      triggerInkReveal(lines[0], totalDuration, 0, seedBase);
      return totalDuration;
    }

    const widths = lines.map((line) => Math.max(line.scrollWidth, 1));
    const totalWidth = widths.reduce((a, b) => a + b, 0);
    const overlapBudget = LINE_OVERLAP_MS * (n - 1);
    const durationBudget = Math.max(totalDuration - overlapBudget, totalDuration * 0.6);

    let durations = widths.map((w) => Math.max(MIN_LINE_DURATION_MS, durationBudget * (w / totalWidth)));
    const sum = durations.reduce((a, b) => a + b, 0);
    const scale = sum > 0 ? durationBudget / sum : 1;
    durations = durations.map((d) => d * scale);

    let cursor = 0;
    lines.forEach((line, i) => {
      triggerInkReveal(line, durations[i], cursor, seedBase + i);
      if (i < n - 1) cursor += durations[i] - LINE_OVERLAP_MS;
    });
    return cursor + durations[n - 1];
  }

  // Reveals everything immediately, with no timers and no hidden state --
  // used for reduced-motion, missing elements, the error fallback, and
  // the 8s safety timeout. Always lifts the FOUC boot guard too, so
  // nothing ever depends on the timed sequence having run for the cover
  // to become fully, finally visible.
  function showEverythingNow(cover: HTMLElement) {
    bootCompleted = true;
    cover.removeAttribute('data-cover-boot');
    cover.classList.remove('is-preparing-animation', 'is-animating');
    cover.classList.add('is-animation-complete');
  }

  // True whenever <html> carries is-landscape-locked -- set by the inline
  // script above only for phones/tablets (coarse pointer or touch
  // points, short side <= 1024px) currently in landscape. Laptops/desktops
  // never set it, so this is always false for them.
  function isLandscapeGate(): boolean {
    return document.documentElement.classList.contains('is-landscape-locked');
  }

  // animationStarted / waitingForPortrait / animationRunToken / bootCompleted:
  // the whole start-once, restart-safe state machine lives in these four.
  // animationRunToken is bumped on every real (re)start attempt so any
  // `await` still in flight from a superseded attempt (device rotated
  // back to landscape mid-load, or the 8s safety fired) can tell it's
  // stale and stop touching the DOM.
  let animationStarted = false;
  let waitingForPortrait = false;
  let animationRunToken = 0;
  let bootCompleted = false;

  // Section 3 / step 6 of the landscape-return sequence: wait for fonts,
  // critical images, two more animation frames, then report whether the
  // device is still in an allowed (non-landscape-gated) state. Never
  // mutates anything -- callers decide what to do with the result.
  async function waitForReadyState(token: number, cover: HTMLElement): Promise<boolean> {
    await Promise.all([waitForSignatureFonts(), waitForImages(cover)]);
    if (token !== animationRunToken) return false;
    fitAll();
    await nextFrame();
    if (token !== animationRunToken) return false;
    return !isLandscapeGate();
  }

  async function startAnimationOnce(token: number, cover: HTMLElement) {
    const nameEl = cover.querySelector<HTMLElement>('[data-animation="guest-name"]');
    const dedicationEl = cover.querySelector<HTMLElement>('[data-animation="dedication"]');
    const namesEl = cover.querySelector<HTMLElement>('.cover__names');
    const locationEl = cover.querySelector<HTMLElement>('[data-animation="location"]');
    const ctaEl = cover.querySelector<HTMLElement>('[data-animation="cta"]');

    if (!nameEl || !dedicationEl || !namesEl || !locationEl || !ctaEl) {
      showEverythingNow(cover);
      return;
    }

    const originalName = nameEl.textContent ?? '';
    const originalDedication = dedicationEl.textContent ?? '';

    try {
      const ready = await waitForReadyState(token, cover);
      if (token !== animationRunToken) return;
      if (!ready) {
        // Rotated back to landscape while fonts/images were still
        // loading -- go back to the waiting state; the orientation
        // checker below calls startAnimationOnce again, from scratch,
        // once is-landscape-locked clears for real.
        animationStarted = false;
        waitingForPortrait = true;
        return;
      }

      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduceMotion) {
        // Straight from the protected initial state to the final one --
        // no timers, no masks, no intermediate frame with incomplete
        // styles.
        showEverythingNow(cover);
        return;
      }

      const nameLen = originalName.trim().length;
      const dedicationLen = originalDedication.trim().length;
      // Calibrated so "Estefi y Matías" (~15 chars) lands near 3.1s and its
      // dedication (~67 chars) near 7.2s, per the approved choreography.
      const nameDuration = clamp(2400 + nameLen * 47, 2400, 3900);
      const dedicationDuration = clamp(3500 + dedicationLen * 55, 5600, 8600);
      const signatureDuration = 5000;
      const locationDuration = 1200;
      const ctaDuration = 1200;
      const ctaStagger = 370;
      const underlineDuration = 1100;

      const nameLines = splitIntoLines(nameEl);
      const dedicationLines = splitIntoLines(dedicationEl);

      // Hide everything up front, in the same tick, so the first thing
      // ever painted is the hidden state -- not a flash of visible text.
      nameLines.forEach((line, i) => prepareInkHidden(line, i));
      dedicationLines.forEach((line, i) => prepareInkHidden(line, 100 + i));
      prepareSignatureHidden(namesEl);
      prepareFadeHidden(locationEl);
      prepareFadeHidden(ctaEl);
      prepareUnderlineHidden(ctaEl);
      cover.classList.add('is-preparing-animation');
      await nextFrame();
      if (token !== animationRunToken) return;

      // The finer-grained per-element hidden state above (clip-path/mask/
      // opacity) is now in place and painted, so lifting the coarse FOUC
      // guard here causes no visible change -- both states already look
      // fully hidden.
      bootCompleted = true;
      cover.removeAttribute('data-cover-boot');

      await sleep(1300); // silence: scene visible, nothing written yet
      if (token !== animationRunToken) return;

      cover.classList.add('is-animating');

      revealLines(nameLines, nameDuration, 0);
      await sleep(Math.max(nameDuration - 250, 0));
      if (token !== animationRunToken) return;

      revealLines(dedicationLines, dedicationDuration, 100);
      await sleep(Math.max(dedicationDuration - 250, 0));
      if (token !== animationRunToken) return;

      triggerSignatureReveal(namesEl, signatureDuration, 0);
      await sleep(Math.max(signatureDuration - 150, 0));
      if (token !== animationRunToken) return;

      triggerFade(locationEl, locationDuration, 0);
      triggerFade(ctaEl, ctaDuration, ctaStagger);
      triggerUnderline(ctaEl, underlineDuration, ctaStagger + ctaDuration * 0.6);

      const metaSpan = Math.max(
        locationDuration,
        ctaStagger + ctaDuration,
        ctaStagger + ctaDuration * 0.6 + underlineDuration
      );
      await sleep(metaSpan);
      if (token !== animationRunToken) return;

      await sleep(1300); // final settle: nothing else moves
      if (token !== animationRunToken) return;

      nameEl.textContent = originalName;
      dedicationEl.textContent = originalDedication;
      resetSignatureUnit(namesEl);
      [locationEl, ctaEl].forEach(resetFadeUnit);
      resetUnderline(ctaEl);

      showEverythingNow(cover);
    } catch (err) {
      // Never leave the cover partially hidden if something goes wrong.
      nameEl.textContent = originalName;
      dedicationEl.textContent = originalDedication;
      resetSignatureUnit(namesEl);
      [locationEl, ctaEl].forEach(resetFadeUnit);
      resetUnderline(ctaEl);
      showEverythingNow(cover);
    }
  }

  // The single entry point, matching the spec's central condition
  // exactly: starts once, restarts after a landscape round-trip only if
  // it never truly started, and never restarts once it has.
  function maybeStartAnimation() {
    if (animationStarted) return;
    const cover = document.querySelector<HTMLElement>('.cover');
    if (!cover) return;

    if (isLandscapeGate()) {
      waitingForPortrait = true;
      return;
    }

    waitingForPortrait = false;
    animationStarted = true;
    const token = ++animationRunToken;
    startAnimationOnce(token, cover);
  }

  // Re-checks after every event that could flip is-landscape-locked.
  // Double rAF so this always runs *after* the inline script's own
  // (single-rAF-scheduled) class update for the same event -- otherwise
  // this could read a stale class on the very frame orientation changes.
  function scheduleAnimationCheck() {
    requestAnimationFrame(() => requestAnimationFrame(maybeStartAnimation));
  }

  maybeStartAnimation();
  window.addEventListener('resize', scheduleAnimationCheck);
  window.addEventListener('orientationchange', scheduleAnimationCheck);
  window.visualViewport?.addEventListener('resize', scheduleAnimationCheck);

  // Pure safety net, never part of the normal flow: a stuck load (a JS
  // error nothing caught, a font/image that never resolves, a device
  // stuck reporting landscape) must never hide the invitation forever.
  window.setTimeout(() => {
    if (bootCompleted) return;
    animationRunToken += 1; // invalidate any run still in flight
    animationStarted = true;
    const cover = document.querySelector<HTMLElement>('.cover');
    if (cover) showEverythingNow(cover);
  }, 8000);
</script>


<style>
  /*
