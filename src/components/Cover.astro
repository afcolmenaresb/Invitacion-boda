---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<header class="cover">
  <img
    class="cover__elephant"
    src={`${base}/images/elephant.png`}
    alt="Ilustración de un elefante de perfil, trazo fino"
    width="1101"
    height="1856"
    loading="eager"
  />
  <img
    class="cover__duck"
    src={`${base}/images/duck.png`}
    alt="Ilustración de un pato de perfil, trazo fino"
    width="548"
    height="885"
    loading="eager"
  />

  <div class="cover__text">
    <p class="cover__kicker">Estefi y Matías</p>
    <p class="cover__lede">Hay viajes que no tendrían el mismo sentido sin ciertas personas.</p>
    <h1 class="cover__title">Fátima &amp; Andrés</h1>
    <p class="cover__location">Imbassaí, Bahía</p>
    <a class="cover__cta" href="#viaje">Comenzar el viaje</a>
  </div>
</header>

<style>
  .cover {
    position: relative;
    overflow: hidden;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 8svh 6vw 12svh;
    isolation: isolate;
  }

  .cover::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      repeating-linear-gradient(0deg, rgba(42, 36, 29, 0.05) 0, transparent 1px, transparent 2px),
      repeating-linear-gradient(90deg, rgba(42, 36, 29, 0.04) 0, transparent 1px, transparent 3px);
    mix-blend-mode: multiply;
    opacity: 0.5;
    pointer-events: none;
  }

  .cover__elephant,
  .cover__duck {
    position: absolute;
    z-index: 0;
    width: auto;
    height: auto;
  }

  .cover__elephant {
    width: 46vw;
    left: -8vw;
    bottom: -4svh;
  }

  .cover__duck {
    width: 30vw;
    right: -6vw;
    top: -3svh;
  }

  .cover__text {
    position: relative;
    z-index: 1;
    max-width: 22rem;
    margin-inline-start: 4vw;
  }

  .cover__kicker,
  .cover__location {
    font-family: var(--font-sans);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 0.75rem;
    color: var(--color-muted);
    margin: 0 0 1rem;
  }

  .cover__lede {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(1.05rem, 4vw, 1.25rem);
    line-height: 1.5;
    max-width: 20ch;
    margin: 0 0 2rem;
  }

  .cover__title {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(2.2rem, 9vw, 3rem);
    line-height: 1.05;
    letter-spacing: 0.01em;
    margin: 0 0 1.25rem;
  }

  .cover__location {
    margin-bottom: 2.5rem;
  }

  .cover__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-sans);
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink);
    text-decoration: none;
    border-bottom: 1px solid var(--color-accent);
    padding-bottom: 0.35rem;
    width: fit-content;
  }

  .cover__cta::after {
    content: '→';
  }

  @media (prefers-reduced-motion: no-preference) {
    .cover__cta {
      transition: color 0.2s ease, border-color 0.2s ease;
    }

    .cover__cta:hover,
    .cover__cta:focus-visible {
      color: var(--color-accent);
    }
  }

  /* Tablet vertical */
  @media (min-width: 768px) {
    .cover {
      padding: 10svh 8vw 14svh;
    }

    .cover__elephant {
      width: 34vw;
      left: -6vw;
      bottom: -5svh;
    }

    .cover__duck {
      width: 20vw;
      right: -4vw;
      top: -4svh;
    }

    .cover__text {
      max-width: 26rem;
      margin-inline-start: 8vw;
    }

    .cover__title {
      font-size: clamp(2.6rem, 6vw, 3.4rem);
    }
  }

  /* Tablet horizontal / small desktop */
  @media (min-width: 1024px) {
    .cover {
      padding: 8svh 8vw;
    }

    .cover__elephant {
      width: 28vw;
      left: -4vw;
      bottom: -4svh;
    }

    .cover__duck {
      width: 16vw;
      right: -3vw;
      top: -3svh;
    }

    .cover__text {
      max-width: 28rem;
      margin-inline-start: 30vw;
    }

    .cover__title {
      font-size: clamp(3rem, 5vw, 3.8rem);
    }
  }

  /* Desktop */
  @media (min-width: 1280px) {
    .cover {
      padding: 6svh 6vw;
    }

    .cover__elephant {
      width: 26vw;
      left: -3vw;
      bottom: -6svh;
    }

    .cover__duck {
      width: 15vw;
      right: -2vw;
      top: -5svh;
    }

    .cover__text {
      max-width: 30rem;
      margin-inline-start: 34vw;
    }

    .cover__title {
      font-size: clamp(3.4rem, 4vw, 4.4rem);
    }
  }

  /* Mobile horizontal (short viewport, overrides width-based rules above) */
  @media (orientation: landscape) and (max-height: 500px) {
    .cover {
      flex-direction: row;
      align-items: center;
      justify-content: flex-start;
      padding: 6svh 6vw;
      gap: 4vw;
    }

    .cover__elephant {
      width: 26vw;
      left: -4vw;
      bottom: -6svh;
    }

    .cover__duck {
      width: 16vw;
      right: -3vw;
      top: -4svh;
    }

    .cover__text {
      max-width: 26rem;
      margin-inline-start: 30vw;
    }

    .cover__title {
      font-size: clamp(1.8rem, 6vw, 2.4rem);
    }

    .cover__lede {
      margin-bottom: 1.25rem;
    }

    .cover__location {
      margin-bottom: 1.5rem;
    }
  }
</style>
