---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<header class="cover">
  <img
    class="cover__elephant"
    src={`${base}/images/elephant.png`}
    alt="Ilustración de un elefante de perfil, trazo fino"
    width="1101"
    height="1856"
    loading="eager"
  />
  <img
    class="cover__duck"
    src={`${base}/images/duck.png`}
    alt="Ilustración de un pato mirando hacia el bloque central, trazo fino"
    width="768"
    height="1376"
    loading="eager"
  />

  <div class="cover__text">
    <p class="cover__kicker">Estefi y Matías</p>
    <p class="cover__lede">Hay viajes que no tendrían el mismo sentido sin ciertas personas.</p>
    <h1 class="cover__title">Fátima &amp; Andrés</h1>
    <p class="cover__location">Imbassaí, Bahía</p>
    <a class="cover__cta" href="#viaje">Comenzar el viaje</a>
  </div>
</header>

<style>
  .cover {
    position: relative;
    overflow: hidden;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 8svh 6vw 12svh;
    isolation: isolate;
  }

  .cover::before {
    content: '';
    position: absolute;
    inset: 0;
    background-repeat: no-repeat;
    background-image:
      /* soft irregular tonal modulation, hand-placed, low periodicity */
      radial-gradient(ellipse 58% 42% at 14% 20%, rgba(112, 92, 62, 0.045), transparent 63%),
      radial-gradient(ellipse 38% 58% at 88% 8%, rgba(112, 92, 62, 0.04), transparent 60%),
      radial-gradient(ellipse 62% 46% at 30% 84%, rgba(96, 78, 54, 0.04), transparent 58%),
      radial-gradient(ellipse 40% 55% at 94% 90%, rgba(112, 92, 62, 0.035), transparent 55%),
      radial-gradient(ellipse 85% 92% at 60% 44%, rgba(112, 92, 62, 0.025), transparent 70%),
      radial-gradient(ellipse 30% 40% at 55% 12%, rgba(96, 78, 54, 0.03), transparent 60%),
      /* faint cotton-paper fibers: long soft diagonal streaks at non-aligned angles */
      linear-gradient(17deg, transparent 42%, rgba(60, 50, 36, 0.035) 50%, transparent 58%),
      linear-gradient(-34deg, transparent 44%, rgba(60, 50, 36, 0.03) 50%, transparent 56%),
      linear-gradient(58deg, transparent 43%, rgba(60, 50, 36, 0.028) 50%, transparent 57%),
      linear-gradient(-72deg, transparent 45%, rgba(60, 50, 36, 0.028) 50%, transparent 55%),
      linear-gradient(6deg, transparent 44%, rgba(60, 50, 36, 0.025) 50%, transparent 56%),
      /* fine irregular grain: individual, non-repeating flecks at fixed pseudo-random spots */
      radial-gradient(circle 0.41px at 33.1% 16.5%, rgba(60, 50, 36, 0.058), transparent 0.9px),
      radial-gradient(circle 0.35px at 37.1% 7.6%, rgba(42, 36, 29, 0.054), transparent 0.77px),
      radial-gradient(circle 0.37px at 42.1% 25.1%, rgba(60, 50, 36, 0.057), transparent 0.81px),
      radial-gradient(circle 0.38px at 93.0% 62.5%, rgba(42, 36, 29, 0.057), transparent 0.84px),
      radial-gradient(circle 0.37px at 6.8% 23.2%, rgba(42, 36, 29, 0.065), transparent 0.81px),
      radial-gradient(circle 0.27px at 15.8% 13.3%, rgba(60, 50, 36, 0.14), transparent 0.59px),
      radial-gradient(circle 0.23px at 11.9% 56.8%, rgba(60, 50, 36, 0.061), transparent 0.51px),
      radial-gradient(circle 0.35px at 56.2% 61.4%, rgba(42, 36, 29, 0.108), transparent 0.77px),
      radial-gradient(circle 0.29px at 46.7% 90.7%, rgba(60, 50, 36, 0.077), transparent 0.64px),
      radial-gradient(circle 0.38px at 69.1% 25.4%, rgba(42, 36, 29, 0.108), transparent 0.84px),
      radial-gradient(circle 0.54px at 72.0% 29.6%, rgba(42, 36, 29, 0.063), transparent 1.19px),
      radial-gradient(circle 0.52px at 17.8% 34.8%, rgba(60, 50, 36, 0.096), transparent 1.14px),
      radial-gradient(circle 0.5px at 75.4% 57.0%, rgba(42, 36, 29, 0.085), transparent 1.1px),
      radial-gradient(circle 0.33px at 59.1% 57.7%, rgba(42, 36, 29, 0.142), transparent 0.73px),
      radial-gradient(circle 0.17px at 47.5% 65.8%, rgba(42, 36, 29, 0.127), transparent 0.37px),
      radial-gradient(circle 0.42px at 29.3% 39.0%, rgba(42, 36, 29, 0.052), transparent 0.92px),
      radial-gradient(circle 0.35px at 36.1% 60.6%, rgba(42, 36, 29, 0.074), transparent 0.77px),
      radial-gradient(circle 0.31px at 14.4% 25.8%, rgba(60, 50, 36, 0.146), transparent 0.68px),
      radial-gradient(circle 0.26px at 18.0% 40.6%, rgba(42, 36, 29, 0.065), transparent 0.57px),
      radial-gradient(circle 0.32px at 84.9% 28.7%, rgba(42, 36, 29, 0.089), transparent 0.7px),
      radial-gradient(circle 0.22px at 93.9% 16.5%, rgba(60, 50, 36, 0.076), transparent 0.48px),
      radial-gradient(circle 0.22px at 3.2% 81.8%, rgba(60, 50, 36, 0.081), transparent 0.48px),
      radial-gradient(circle 0.38px at 42.2% 37.4%, rgba(60, 50, 36, 0.155), transparent 0.84px),
      radial-gradient(circle 0.53px at 45.8% 85.6%, rgba(42, 36, 29, 0.125), transparent 1.17px),
      radial-gradient(circle 0.34px at 40.2% 39.8%, rgba(60, 50, 36, 0.094), transparent 0.75px),
      radial-gradient(circle 0.21px at 8.5% 22.0%, rgba(60, 50, 36, 0.087), transparent 0.46px),
      radial-gradient(circle 0.36px at 11.8% 56.4%, rgba(60, 50, 36, 0.154), transparent 0.79px),
      radial-gradient(circle 0.3px at 8.8% 22.0%, rgba(42, 36, 29, 0.12), transparent 0.66px),
      radial-gradient(circle 0.2px at 59.8% 47.5%, rgba(42, 36, 29, 0.104), transparent 0.44px),
      radial-gradient(circle 0.21px at 48.1% 31.9%, rgba(42, 36, 29, 0.132), transparent 0.46px),
      radial-gradient(circle 0.36px at 47.9% 68.4%, rgba(42, 36, 29, 0.073), transparent 0.79px),
      radial-gradient(circle 0.16px at 16.1% 54.1%, rgba(60, 50, 36, 0.108), transparent 0.35px),
      radial-gradient(circle 0.3px at 68.8% 27.1%, rgba(60, 50, 36, 0.068), transparent 0.66px),
      radial-gradient(circle 0.28px at 53.1% 76.8%, rgba(60, 50, 36, 0.075), transparent 0.62px),
      radial-gradient(circle 0.45px at 79.4% 80.6%, rgba(42, 36, 29, 0.075), transparent 0.99px),
      radial-gradient(circle 0.16px at 36.1% 4.8%, rgba(42, 36, 29, 0.081), transparent 0.35px),
      radial-gradient(circle 0.29px at 20.6% 60.1%, rgba(42, 36, 29, 0.139), transparent 0.64px),
      radial-gradient(circle 0.24px at 93.7% 37.0%, rgba(60, 50, 36, 0.075), transparent 0.53px),
      radial-gradient(circle 0.54px at 34.4% 48.3%, rgba(60, 50, 36, 0.117), transparent 1.19px),
      radial-gradient(circle 0.47px at 48.0% 64.7%, rgba(60, 50, 36, 0.059), transparent 1.03px),
      radial-gradient(circle 0.45px at 89.3% 77.1%, rgba(60, 50, 36, 0.103), transparent 0.99px),
      radial-gradient(circle 0.18px at 43.7% 63.0%, rgba(42, 36, 29, 0.154), transparent 0.4px);
    mix-blend-mode: multiply;
    opacity: 0.7;
    pointer-events: none;
  }

  .cover__elephant,
  .cover__duck {
    position: absolute;
    z-index: 0;
    width: auto;
    height: auto;
  }

  .cover__elephant {
    width: 40vw;
    left: -8vw;
    bottom: -1.5svh;
  }

  .cover__duck {
    width: clamp(230px, 60vw, 300px);
    right: -3vw;
    top: -2svh;
    transform: scaleX(-1);
  }

  .cover__text {
    position: relative;
    z-index: 1;
    max-width: 22rem;
    margin-inline-start: 7vw;
  }

  .cover__kicker,
  .cover__location {
    font-family: var(--font-sans);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 0.75rem;
    color: var(--color-muted);
    margin: 0 0 1rem;
  }

  .cover__kicker {
    margin-bottom: 0.6rem;
  }

  .cover__lede {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(1.05rem, 4vw, 1.25rem);
    line-height: 1.5;
    max-width: 20ch;
    margin: 0 0 2rem;
  }

  .cover__title {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(2.05rem, 8.2vw, 2.8rem);
    line-height: 1.05;
    letter-spacing: 0.01em;
    margin: 0 0 1.25rem;
  }

  .cover__location {
    margin-bottom: 2.5rem;
  }

  .cover__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-sans);
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink);
    text-decoration: none;
    border-bottom: 1px solid var(--color-accent);
    padding-bottom: 0.35rem;
    width: fit-content;
  }

  .cover__cta::after {
    content: '→';
  }

  @media (prefers-reduced-motion: no-preference) {
    .cover__cta {
      transition: color 0.2s ease, border-color 0.2s ease;
    }

    .cover__cta:hover,
    .cover__cta:focus-visible {
      color: var(--color-accent);
    }
  }

  /* Tablet vertical */
  @media (min-width: 768px) {
    .cover {
      padding: 10svh 8vw 14svh;
    }

    .cover__elephant {
      width: 30vw;
      left: -6vw;
      bottom: -4svh;
    }

    .cover__duck {
      width: 34vw;
      right: 2vw;
      top: 4svh;
    }

    .cover__text {
      max-width: 26rem;
      margin-inline-start: 8vw;
      margin-block-start: -50px;
    }

    .cover__title {
      font-size: clamp(2.6rem, 6vw, 3.4rem);
    }
  }

  /* Tablet horizontal / small desktop */
  @media (min-width: 1024px) {
    .cover {
      padding: 8svh 8vw;
    }

    .cover__elephant {
      width: 25vw;
      left: -4vw;
      bottom: -4svh;
    }

    .cover__duck {
      width: 26vw;
      right: 1vw;
      top: 3svh;
    }

    .cover__text {
      max-width: 28rem;
      margin-inline-start: 33vw;
      margin-block-start: 0;
    }

    .cover__title {
      font-size: clamp(2.7rem, 4.5vw, 3.4rem);
    }
  }

  /* Desktop */
  @media (min-width: 1280px) {
    .cover {
      padding: 6svh 6vw;
    }

    .cover__elephant {
      width: 23vw;
      left: -5vw;
      bottom: -6svh;
    }

    .cover__duck {
      width: 24vw;
      right: 3vw;
      top: 4svh;
    }

    .cover__text {
      max-width: 30rem;
      margin-inline-start: calc(34vw + 45px);
    }

    .cover__title {
      font-size: clamp(3.4rem, 4vw, 4.4rem);
    }
  }

  /* Mobile horizontal (short viewport, overrides width-based rules above) */
  @media (orientation: landscape) and (max-height: 500px) {
    .cover {
      flex-direction: row;
      align-items: center;
      justify-content: flex-start;
      padding: 6svh 6vw;
      gap: 4vw;
    }

    .cover__elephant {
      width: 22vw;
      left: -4vw;
      bottom: -5svh;
    }

    .cover__duck {
      width: 30vw;
      right: 0;
      top: -1svh;
    }

    .cover__text {
      max-width: 26rem;
      margin-inline-start: 30vw;
      margin-block-start: 0;
    }

    .cover__title {
      font-size: clamp(1.6rem, 5.3vw, 2.15rem);
    }

    .cover__lede {
      margin-bottom: 1rem;
    }

    .cover__location {
      margin-bottom: 1.2rem;
    }
  }
</style>
