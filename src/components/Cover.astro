---
import '@fontsource/beau-rivage';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<header class="cover">
  <img
    class="cover__texture"
    src={`${base}/images/textura-vertical.png`}
    alt=""
    role="presentation"
    width="705"
    height="967"
    loading="eager"
  />
  <img
    class="cover__elephant"
    src={`${base}/images/elephant.png`}
    alt="Ilustración de un elefante de perfil entrando desde la izquierda, trazo fino"
    width="1101"
    height="1856"
    loading="eager"
  />
  <img
    class="cover__duck"
    src={`${base}/images/duck.png`}
    alt="Ilustración de un pato mirando hacia el bloque central, trazo fino"
    width="768"
    height="1376"
    loading="eager"
  />

  <div class="cover__intro">
    <p class="cover__kicker">Estefi y Matías</p>
    <p class="cover__lede">Hay viajes que no tendrían el mismo sentido sin ciertas personas.</p>
  </div>

  <div class="cover__names">
    <h1 class="cover__title">
      <span>Fátima</span>
      <span class="cover__amp">&amp;</span>
      <span>Andrés</span>
    </h1>
    <p class="cover__location">Imbassaí, Bahía</p>
    <a class="cover__cta" href="#viaje">Comenzar el viaje</a>
  </div>
</header>

<style>
  .cover {
    position: relative;
    overflow: hidden;
    min-height: 100svh;
    isolation: isolate;
  }

  .cover__texture {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: left top;
    z-index: -1;
    pointer-events: none;
  }

  .cover__elephant,
  .cover__duck {
    position: absolute;
    z-index: 0;
    width: auto;
    height: auto;
  }

  .cover__elephant {
    width: 54vw;
    left: -6vw;
    bottom: -7svh;
    transform: scaleX(-1);
  }

  .cover__duck {
    width: clamp(230px, 60vw, 300px);
    right: -3vw;
    top: -2svh;
    transform: scaleX(-1);
    filter: contrast(1.18) brightness(0.94);
    opacity: 1;
  }

  .cover__intro {
    position: absolute;
    z-index: 1;
    top: 5svh;
    left: 6vw;
    max-width: 60vw;
  }

  .cover__names {
    position: absolute;
    z-index: 1;
    left: 76%;
    top: 58svh;
    transform: translateX(-50%);
    width: max-content;
    max-width: 52vw;
    text-align: center;
  }

  .cover__kicker,
  .cover__location {
    font-family: var(--font-sans);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 0.75rem;
    color: var(--color-muted);
    margin: 0 0 1rem;
  }

  .cover__kicker {
    margin-bottom: 0.6rem;
  }

  .cover__lede {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(1rem, 4vw, 1.15rem);
    line-height: 1.5;
    max-width: 25ch;
    margin: 0;
  }

  .cover__title {
    display: flex;
    flex-direction: column;
    align-items: center;
    font-family: 'Beau Rivage', cursive;
    font-weight: 400;
    font-size: clamp(2.6rem, 13vw, 3.6rem);
    line-height: 1.15;
    letter-spacing: 0;
    margin: 0 0 1.1rem;
  }

  .cover__title span {
    display: block;
  }

  .cover__amp {
    margin: -0.35em 0;
  }

  .cover__location {
    margin-bottom: 1.6rem;
  }

  .cover__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-sans);
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink);
    text-decoration: none;
    border-bottom: 1px solid var(--color-accent);
    padding-bottom: 0.35rem;
    width: fit-content;
    white-space: nowrap;
  }

  .cover__cta::after {
    content: '→';
  }

  @media (prefers-reduced-motion: no-preference) {
    .cover__cta {
      transition: color 0.2s ease, border-color 0.2s ease;
    }

    .cover__cta:hover,
    .cover__cta:focus-visible {
      color: var(--color-accent);
    }
  }

  /* Phone landscape (844x390) */
  @media (orientation: landscape) and (max-height: 500px) {
    .cover__elephant {
      width: 30vw;
      left: -2vw;
      bottom: -32svh;
    }

    .cover__duck {
      width: 26vw;
      right: 0;
      top: -1svh;
    }

    .cover__intro {
      top: 8svh;
      left: 33vw;
      max-width: 45vw;
    }

    .cover__names {
      left: 63%;
      top: 60svh;
      max-width: 34vw;
    }

    .cover__title {
      flex-direction: row;
      gap: 0.4em;
      font-size: clamp(1.7rem, 6vw, 2.3rem);
      margin-bottom: 0.7rem;
    }

    .cover__amp {
      margin: 0;
    }

    .cover__location {
      margin-bottom: 1rem;
    }
  }

  /* Tablet portrait / large vertical (1600x2560) */
  @media (orientation: portrait) and (min-width: 1200px) {
    .cover__elephant {
      width: 42vw;
      left: -4vw;
      bottom: -5svh;
    }

    .cover__duck {
      width: 30vw;
      right: 1vw;
      top: 3svh;
    }

    .cover__intro {
      top: 7svh;
      left: 7vw;
      max-width: 52vw;
    }

    .cover__intro .cover__kicker {
      font-size: 1.1rem;
    }

    .cover__intro .cover__lede {
      font-size: clamp(1.6rem, 2.6vw, 2rem);
      max-width: 26ch;
    }

    .cover__names {
      left: 68%;
      top: 76svh;
      max-width: 34vw;
    }

    .cover__title {
      font-size: clamp(4.2rem, 6vw, 5.4rem);
      margin-bottom: 1.6rem;
    }

    .cover__location {
      font-size: 1.05rem;
      margin-bottom: 2.4rem;
    }

    .cover__cta {
      font-size: 1.05rem;
    }
  }

  /* Tablet landscape / laptop (2560x1600) */
  @media (orientation: landscape) and (min-width: 1200px) {
    .cover__elephant {
      width: 26vw;
      left: -3vw;
      bottom: -12svh;
    }

    .cover__duck {
      width: 18vw;
      right: 2vw;
      top: 4svh;
    }

    .cover__intro {
      top: 8svh;
      left: 8vw;
      max-width: 34vw;
    }

    .cover__intro .cover__kicker {
      font-size: 1rem;
    }

    .cover__intro .cover__lede {
      font-size: clamp(1.3rem, 1.8vw, 1.6rem);
      max-width: 28ch;
    }

    .cover__names {
      left: 55%;
      top: 80svh;
      max-width: 30vw;
    }

    .cover__title {
      flex-direction: row;
      gap: 0.45em;
      font-size: clamp(3rem, 4vw, 4rem);
      margin-bottom: 1.2rem;
    }

    .cover__amp {
      margin: 0;
    }

    .cover__location {
      font-size: 0.95rem;
      margin-bottom: 1.8rem;
    }

    .cover__cta {
      font-size: 0.95rem;
    }
  }
</style>
