---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<header class="cover">
  <img
    class="cover__elephant"
    src={`${base}/images/elephant.png`}
    alt="Ilustración de un elefante de perfil entrando desde la izquierda, trazo fino"
    width="1101"
    height="1856"
    loading="eager"
  />
  <img
    class="cover__duck"
    src={`${base}/images/duck.png`}
    alt="Ilustración de un pato mirando hacia el bloque central, trazo fino"
    width="768"
    height="1376"
    loading="eager"
  />

  <div class="cover__intro">
    <p class="cover__kicker">Estefi y Matías</p>
    <p class="cover__lede">Hay viajes que no tendrían el mismo sentido sin ciertas personas.</p>
  </div>

  <div class="cover__names">
    <h1 class="cover__title">
      <span class="cover__title-name">Fátima</span>{' '}<span class="cover__title-amp">&amp;</span>{' '}<span class="cover__title-name">Andrés</span>
    </h1>
    <p class="cover__location">Imbassaí, Bahía</p>
    <a class="cover__cta" href="#viaje">Comenzar el viaje</a>
  </div>
</header>

<style>
  .cover {
    position: relative;
    overflow: hidden;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 7svh 7vw 6svh;
    isolation: isolate;
  }

  .cover::before {
