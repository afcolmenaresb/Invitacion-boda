---
import '@fontsource/sacramento/400.css';
import '@fontsource/homemade-apple/400.css';
import { getVisibleDedicationLength } from '../data/guests';
import { hyphenateSpanishText } from '../lib/spanishHyphenation';

interface Props {
  displayName?: string;
  dedication?: string;
}

const {
  displayName = 'Estefi y Matías',
  dedication = 'Hay viajes que no tendrían el mismo sentido sin ciertas personas.',
} = Astro.props;

// Continuous size ramp for the dedication (replaces the old 3-bucket
// short/medium/long system): font-size and line-height shrink smoothly as
// the character count grows, instead of jumping between fixed steps. Below
// DEDICATION_SCALE_START_LEN the size is clamped at its max; at/after
// DEDICATION_SCALE_END_LEN (the absolute 160-char cap enforced in
// guests.ts) it's clamped at its legible minimum. This is the *first*
// pass, computed server-side from character count alone; the client
// script below adds a second, height-based pass that shrinks further
// only if the rendered block still runs into .cover__names' safe margin
// (see fitDedicationHeight).
//
// The max was lowered from 1.4rem (~20.16px visual on the reference
// device) to 1.125rem (18px). Measured directly against the fixed 140px
// zone: at 1.4rem the default guest dedication ("Hay viajes que no
// tendrían el mismo sentido sin ciertas personas.") wraps into 7 ragged
// lines with "mismo" isolated alone; the wrap pattern flips to a full
// 5-line reading -- "Hay viajes que / no tendrían el / mismo sentido /
// sin ciertas / personas." -- at exactly 18px and stays there down to
// ~15.5px. Only the ceiling changed, so this only affects dedications
// short enough to sit at or near the ramp's start; medium/long
// dedications (which already sit below this ceiling) keep their
// existing sizes.
const DEDICATION_SCALE_START_LEN = 55;
const DEDICATION_SCALE_END_LEN = 160;
const DEDICATION_FONT_SIZE_MAX_REM = 1.125;
const DEDICATION_FONT_SIZE_MIN_REM = 0.85;
const DEDICATION_LINE_HEIGHT_MAX = 1.6;
const DEDICATION_LINE_HEIGHT_MIN = 1.3;

function clampNumber(value: number, min: number, max: number) {
  return Math.min(max, Math.max(min, value));
}

function computeDedicationTypography(length: number) {
  const t = clampNumber(
    (length - DEDICATION_SCALE_START_LEN) / (DEDICATION_SCALE_END_LEN - DEDICATION_SCALE_START_LEN),
    0,
    1
  );
  const fontSize = DEDICATION_FONT_SIZE_MAX_REM - (DEDICATION_FONT_SIZE_MAX_REM - DEDICATION_FONT_SIZE_MIN_REM) * t;
  const lineHeight = DEDICATION_LINE_HEIGHT_MAX - (DEDICATION_LINE_HEIGHT_MAX - DEDICATION_LINE_HEIGHT_MIN) * t;
  return { fontSize, lineHeight };
}

// Soft hyphens (U+00AD, see guests.ts) are invisible unless the browser
// actually breaks a word there -- they must never inflate the character
// count that drives sizing/timing, or an editor adding one for better
// wrapping would unfairly lose real, visible characters off their budget.
const dedicationLength = getVisibleDedicationLength(dedication);
const { fontSize: dedicationFontSize, lineHeight: dedicationLineHeight } =
  computeDedicationTypography(dedicationLength);

// Editorial rule: a word may only ever break across lines at an explicit,
// visible hyphen -- never a blind cut. Rather than requiring every guest
// dedication to be hand-annotated with \u00AD, this runs deterministic
// Spanish syllabification (see spanishHyphenation.ts) once, at build time,
// over the *unmodified* `dedication` prop, and only the resulting display
// string (with soft hyphens inserted at safe syllable boundaries) is
// rendered. Any \u00AD an editor already typed by hand is honored verbatim
// as an override, never re-processed. `dedication` itself -- used above for
// length/duration, and again below for aria-label -- is never touched.
const dedicationDisplay = hyphenateSpanishText(dedication);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<script is:inline>
  // Runs synchronously, before the fixed-canvas markup below is painted, so
  // every --cover-scale* variable is already correct on first paint (no
  // flash from a generic fallback value, no temporary margins). One single
  // recalculation function handles every device path so there is exactly
  // one set of listeners.
  //
  // Whether a device counts as "mobile/tablet" is decided by input type,
  // never by window width alone -- a laptop resized to a narrow window is
  // still a laptop. isMobileOrTablet requires BOTH a coarse pointer (or
  // touch points) AND a short side of 1024px or less:
  //
  // - isMobileOrTablet && portrait (viewportWidth <= viewportHeight): the
  //   fixed 390x844 canvas is stretched, non-uniformly, to exactly fill
  //   the visible viewport -- --cover-scale-x/--cover-scale-y -- via the
  //   `is-fill-viewport` class on <html>, which also removes any outer
  //   margin/scroll (see the global styles below).
  // - isMobileOrTablet && landscape (viewportWidth > viewportHeight): the
  //   invitation itself never shows -- `is-landscape-locked` on <html>
  //   reveals the full-viewport rotate-device notice instead.
  // - anything else (laptops/desktops, in any orientation or window size):
  //   untouched from before -- a single uniform --cover-scale =
  //   Math.min(viewportWidth/390, viewportHeight/844), read verbatim by
  //   .cover-canvas's existing rule; the rotate-device notice never shows.
  (function () {
    var TOUCH_SHORT_SIDE_MAX = 1024;
    var CANVAS_WIDTH = 390;
    var CANVAS_HEIGHT = 844;
    var root = document.documentElement;
    var scheduled = false;

    // Section 3's exact formula: visualViewport first (it tracks mobile
    // toolbars, the on-screen keyboard and pinch-zoom correctly), falling
    // back to the documentElement's client box.
    function getViewportWidth() {
      return (window.visualViewport && window.visualViewport.width) || document.documentElement.clientWidth;
    }
    function getViewportHeight() {
      return (window.visualViewport && window.visualViewport.height) || document.documentElement.clientHeight;
    }

    function update() {
      scheduled = false;

      var viewportWidth = getViewportWidth();
      var viewportHeight = getViewportHeight();

      var isTouchDevice =
        window.matchMedia('(pointer: coarse)').matches || navigator.maxTouchPoints > 0;
      var shortSide = Math.min(viewportWidth, viewportHeight);
      var isMobileOrTablet = isTouchDevice && shortSide <= TOUCH_SHORT_SIDE_MAX;
      var isLandscape = viewportWidth > viewportHeight;

      var isFillViewport = isMobileOrTablet && !isLandscape;
      var isLandscapeLocked = isMobileOrTablet && isLandscape;

      root.classList.toggle('is-fill-viewport', isFillViewport);
      root.classList.toggle('is-landscape-locked', isLandscapeLocked);
      var locked = isFillViewport || isLandscapeLocked;
      root.classList.toggle('is-viewport-locked', locked);
      if (document.body) {
        document.body.classList.toggle('is-viewport-locked', locked);
      }

      if (isFillViewport) {
        root.style.setProperty('--cover-scale-x', String(viewportWidth / CANVAS_WIDTH));
        root.style.setProperty('--cover-scale-y', String(viewportHeight / CANVAS_HEIGHT));
        root.style.setProperty('--cover-viewport-width', viewportWidth + 'px');
        root.style.setProperty('--cover-viewport-height', viewportHeight + 'px');
      } else if (!isMobileOrTablet) {
        // Laptop/desktop path -- untouched: the same single uniform
        // (contain-style) --cover-scale as before, in any orientation or
        // window size, never gated by touch/pointer.
        var scale = Math.min(viewportWidth / CANVAS_WIDTH, viewportHeight / CANVAS_HEIGHT);
        root.style.setProperty('--cover-scale', String(scale));
      }
    }

    function scheduleUpdate() {
      if (scheduled) return;
      scheduled = true;
      requestAnimationFrame(update);
    }

    update();
    window.addEventListener('resize', scheduleUpdate);
    window.addEventListener('orientationchange', scheduleUpdate);
    if (window.visualViewport) {
      window.visualViewport.addEventListener('resize', scheduleUpdate);
      // Mobile browsers shrink/grow the visual viewport (address bar,
      // on-screen keyboard) by scrolling it, not just resizing it.
      window.visualViewport.addEventListener('scroll', scheduleUpdate);
    }

    // Best-effort only -- orientation can't be forced; the rotate-device
    // overlay above is the real, always-working fallback.
    if (screen.orientation && screen.orientation.lock) {
      screen.orientation.lock('portrait').catch(function () {});
    }
  })();
</script>

<!-- The rotate-device notice's own markup now lives in OrientationGate.astro
     (rendered globally in InvitationExperience.astro, not nested here) so
     it works on every scene, not just the cover -- see that file's own
     comment. The detection script above is untouched: it already toggles
     html.is-landscape-locked from viewport dimensions alone, independent
     of where the notice itself is painted. -->

<div class="cover-frame" style={`background-image: url('${base}/images/textura_vertical_2.png')`}>
  <div class="cover-canvas">
    <header class="cover" data-animation-state="normal" data-cover-boot="pending">
      <img
        class="cover__texture"
    src={`${base}/images/textura-vertical.png`}
    alt=""
    role="presentation"
    width="705"
    height="967"
    loading="eager"
  />
  <div
    class="cover__texture-v2"
    style={`background-image: url('${base}/images/textura_vertical_2.png')`}
  >
  </div>
  <svg
    class="cover__foam-abstract"
    viewBox="0 0 400 200"
    preserveAspectRatio="xMaxYMax slice"
    aria-hidden="true"
    focusable="false"
  >
    <defs>
      <filter id="foamBlur" x="-30%" y="-30%" width="160%" height="160%">
        <feGaussianBlur stdDeviation="7" />
      </filter>
    </defs>
    <path
      class="cover__foam-shape"
      d="M400,200 L400,128 C372,120 344,101 313,105 C282,109 268,132 233,129
         C198,126 190,148 155,146 C120,144 108,163 72,160
         C46,158 30,172 0,168 L0,200 Z"
      fill="#fbf5e7"
      filter="url(#foamBlur)"
    />
    <g class="cover__foam-flecks" fill="#fdf9ef">
      <circle cx="150" cy="132" r="3" />
      <circle cx="182" cy="121" r="2" />
      <circle cx="212" cy="136" r="3.6" />
      <circle cx="260" cy="110" r="2.2" />
      <circle cx="296" cy="115" r="3" />
      <circle cx="330" cy="100" r="2" />
      <circle cx="103" cy="155" r="2.4" />
      <circle cx="66" cy="162" r="3" />
      <circle cx="35" cy="170" r="2" />
    </g>
  </svg>
  <img
    class="cover__elephant"
    data-animation="elephant"
    src={`${base}/images/elephant.png`}
    alt="Ilustración de un elefante de perfil entrando desde la izquierda, trazo fino"
    width="1101"
    height="1856"
    loading="eager"
  />
  <img
    class="cover__duck"
    data-animation="duck"
    src={`${base}/images/duck.png`}
    alt="Ilustración de un pato mirando hacia el bloque central, trazo fino"
    width="768"
    height="1376"
    loading="eager"
  />

  <div class="cover__intro">
    <p class="cover__kicker" data-autofit="width" data-animation="guest-name">{displayName}</p>
    <p
      class="cover__lede"
      lang="es"
      aria-label={dedication}
      data-autofit="width"
      data-animation="dedication"
      style={`--dedication-font-size: ${dedicationFontSize.toFixed(3)}rem; --dedication-line-height: ${dedicationLineHeight.toFixed(3)};`}
    >{dedicationDisplay}</p>
  </div>

  <div class="cover__names">
    <h1 class="cover__title" data-autofit="width">
      <span class="signature-fatima" data-animation="name-fatima">Fátima</span>
      <span class="cover__amp signature-amp" data-animation="name-separator">&amp;</span>
      <span class="signature-andres" data-animation="name-andres">Andrés</span>
    </h1>
  </div>

  <div class="cover__meta">
    {/* Text removed per request -- element kept empty (not deleted) so
       startAnimationOnce's own required-element guard still finds it and
       the existing elephant/duck/name/dedication animation sequence keeps
       running unchanged; prepareFadeHidden/triggerFade on it are already
       plain opacity fades with no text-dependent logic. */}
    <p class="cover__location" data-animation="location"></p>
    <a class="cover__cta" href="#recuerdo" data-animation="cta">Comenzar el viaje</a>
  </div>
    </header>
  </div>
</div>

<script>
  function fitText(el: HTMLElement) {
    el.style.fontSize = '';
    const maxSize = parseFloat(getComputedStyle(el).fontSize);
    let size = maxSize;
    let guard = 0;
    while (el.scrollWidth > el.clientWidth && size > 10 && guard < 80) {
      size -= 1;
      el.style.fontSize = size + 'px';
      guard++;
    }
  }

  // Second, height-based pass for the dedication -- on top of the
  // character-count ramp computed server-side (see computeDedicationTypography
  // in the frontmatter). Character count alone can't guarantee a safe fit:
  // the same length wraps into a different number of lines depending on word
  // lengths, so this defines an explicit max-height budget for the protected
  // zone (.cover__lede) -- namesTop minus a fixed safe margin, minus however
  // much room the kicker (guest name) already took above it -- and shrinks
  // font-size/line-height in small steps only if the block's actual rendered
  // height still exceeds that budget. Never hides or truncates text and
  // never moves .cover__names, the kicker, or any other element -- if the
  // hard floor is reached and it still doesn't fit, it simply stops there
  // and accepts the reduced (but still present) margin.
  const DEDICATION_SAFE_MARGIN_PX = 24;
  // Real visual floor -- never render the dedication smaller than this,
  // full stop. Below it the text stops being comfortably legible, so an
  // unfittable combination is reported (see reportDedicationTooTight) as an
  // editorial problem to fix (shorten the dedication/name) rather than
  // silently squeezed further.
  const DEDICATION_FONT_HARD_MIN_PX = 13;

  // Best-effort "which guest is this" for the error message below -- the
  // page's own path is exactly the slug (see src/pages/[slug].astro), and
  // there's no need to thread the slug through as a separate prop just for
  // this diagnostic.
  function currentGuestSlugForDiagnostics(): string {
    const segments = location.pathname.split('/').filter(Boolean);
    return segments[segments.length - 1] || '(desconocido)';
  }

  function reportDedicationTooTight(ledeEl: HTMLElement, maxHeight: number) {
    const kickerEl = document.querySelector<HTMLElement>('[data-animation="guest-name"]');
    const nameLength = kickerEl?.textContent?.trim().length ?? 0;
    const dedicationVisibleLength = (ledeEl.textContent ?? '').replace(/\u00AD/g, '').length;
    console.error(
      '[dedication] La combinación de nombre + dedicatoria no cabe con un ' +
        `tamaño legible (mínimo ${DEDICATION_FONT_HARD_MIN_PX}px) por encima de la firma. ` +
        `Invitado: "${currentGuestSlugForDiagnostics()}" -- nombre: ${nameLength} caracteres, ` +
        `dedicatoria: ${dedicationVisibleLength} caracteres visibles, ` +
        `espacio vertical disponible: ${maxHeight.toFixed(1)}px. ` +
        'El texto se muestra completo (nunca se oculta ni se recorta), pero excede ' +
        'ese espacio. Solución editorial: acortar la dedicatoria (o el nombre del invitado).'
    );
  }

  // The composition is a fixed 390x844 logical canvas, uniformly (desktop)
  // or non-uniformly (mobile fill-viewport, see the inline script above)
  // *scaled* to fit the real viewport -- a paint-time transform, not a
  // layout change. getBoundingClientRect() reports post-scale pixels, so a
  // vertical measurement taken that way must be divided by the vertical
  // scale factor to compare against a value defined in logical px.
  function getVerticalCoverScale(): number {
    const root = document.documentElement;
    const raw = root.classList.contains('is-fill-viewport')
      ? getComputedStyle(root).getPropertyValue('--cover-scale-y')
      : getComputedStyle(root).getPropertyValue('--cover-scale');
    const value = parseFloat(raw);
    return Number.isFinite(value) && value > 0 ? value : 1;
  }

  function fitDedicationHeight() {
    const ledeEl = document.querySelector<HTMLElement>('[data-animation="dedication"]');
    const namesEl = document.querySelector<HTMLElement>('.cover__names');
    if (!ledeEl || !namesEl) return;

    // Always start from the SSR-computed baseline (--dedication-font-size/
    // --dedication-line-height) so this never compounds shrinkage across
    // repeated calls (resize, font load, etc.).
    ledeEl.style.removeProperty('font-size');
    ledeEl.style.removeProperty('line-height');
    ledeEl.style.removeProperty('max-height');

    const scale = getVerticalCoverScale();
    // The zone's own top only depends on the kicker (guest name) above it,
    // never on the dedication's own length -- so this budget is constant
    // for a given guest, exactly matching the "constant zone" requirement.
    const zoneTop = ledeEl.getBoundingClientRect().top / scale;
    const namesTop = namesEl.getBoundingClientRect().top / scale;
    const maxHeight = Math.max(0, namesTop - DEDICATION_SAFE_MARGIN_PX - zoneTop);
    // Applied as a real CSS constraint (with overflow left at its default
    // "visible" -- never "hidden", which would clip manuscript strokes), so
    // the zone itself provably cannot grow past this budget. It alone
    // doesn't shrink the text though: with overflow:visible, content past
    // max-height simply paints outside the box rather than being clamped,
    // so the loop below still has to measure the *actual* rendered content
    // (via Range, which reports the true glyph extent regardless of the
    // container's own capped box height -- unlike scrollHeight, which is
    // unreliable on an overflow:visible element) and shrink until it fits.
    ledeEl.style.maxHeight = `${maxHeight}px`;

    function measureContentHeight() {
      const range = document.createRange();
      range.selectNodeContents(ledeEl);
      return range.getBoundingClientRect().height / scale;
    }

    const baselineSize = parseFloat(getComputedStyle(ledeEl).fontSize);
    const baselineLineHeight = parseFloat(getComputedStyle(ledeEl).lineHeight);
    const ratio = baselineLineHeight / baselineSize;

    function applySize(size: number) {
      ledeEl!.style.fontSize = `${size}px`;
      ledeEl!.style.lineHeight = `${size * ratio}px`;
      return measureContentHeight();
    }

    // Real Spanish hyphenation (see spanishHyphenation.ts) plus the wider,
    // fixed 140px zone both mean the text often wraps into noticeably fewer
    // lines than the character-count ramp's baseline assumed -- so rather
    // than only ever shrinking down from that baseline (which would leave
    // unused vertical space on the table whenever the real wrapping turned
    // out more efficient than the ramp's rough guess), this searches the
    // *entire* approved typographic range for the largest size that still
    // fits the zone's max-height budget. DEDICATION_FONT_SIZE_MAX_REM_PX
    // mirrors DEDICATION_FONT_SIZE_MAX_REM from the frontmatter ramp (kept
    // in sync manually -- separate script, separate scope) as the ceiling,
    // so a long dedication can still end up larger than its own SSR
    // baseline guess, but never past what a short one is allowed.
    const rootFontSizePx = parseFloat(getComputedStyle(document.documentElement).fontSize) || 16;
    const DEDICATION_FONT_SIZE_MAX_REM_PX = 1.125 * rootFontSizePx;

    if (applySize(DEDICATION_FONT_SIZE_MAX_REM_PX) <= maxHeight) {
      // Fits at the full typographic ceiling -- use it outright.
      return;
    }

    if (applySize(DEDICATION_FONT_HARD_MIN_PX) > maxHeight) {
      // Doesn't fit even at the hard visual floor. This jointly reflects
      // (a) the kicker/guest-name's own rendered height (baked into
      // zoneTop above), (b) the dedication's own rendered height (just
      // measured), and (c) the safe margin to the signature (baked into
      // maxHeight) -- so this is the combined "no valid layout exists at a
      // legible size" case. Never hides, crops, or truncates the text: it
      // still renders in full at the hard floor (already applied by the
      // applySize call above), simply extending past the safe margin. The
      // real fix is editorial (shorten the dedication or the guest name),
      // so this is reported loudly rather than silently accepted.
      reportDedicationTooTight(ledeEl, maxHeight);
      return;
    }

    // Binary search for the *largest* font-size that fits the budget,
    // across the whole [hard floor, typographic ceiling] range. 20
    // iterations over a ~1rem range is well under 0.01px precision --
    // plenty tighter than any visible difference.
    let lo = DEDICATION_FONT_HARD_MIN_PX;
    let hi = DEDICATION_FONT_SIZE_MAX_REM_PX;
    for (let i = 0; i < 20; i++) {
      const mid = (lo + hi) / 2;
      if (applySize(mid) <= maxHeight) {
        lo = mid;
      } else {
        hi = mid;
      }
    }
    applySize(lo);
  }

  // Editorial rule: a word may only ever break across lines at an explicit
  // soft hyphen (U+00AD) -- never a blind, unmarked cut. .cover__lede no
  // longer sets overflow-wrap: break-word (see the CSS), so the browser's
  // default word-breaking already refuses to cut a word with no eligible
  // break point; it lets it overflow the zone's width instead. This runs
  // *after* fitDedicationHeight has already tried shrinking font-size all
  // the way to its hard floor (per the editorial spec: autofit first, down
  // to the approved typographic minimum), and only reports words that still
  // don't fit at that final, settled size -- via console.warn, so it's a
  // visible, discoverable authoring problem (add a soft hyphen, shorten the
  // word) instead of ever silently degrading into an ugly unmarked cut.
  function checkDedicationOverflow() {
    const ledeEl = document.querySelector<HTMLElement>('[data-animation="dedication"]');
    if (!ledeEl) return;

    const zoneWidth = ledeEl.clientWidth;
    const text = ledeEl.textContent ?? '';
    const words = text.split(/\s+/).filter(Boolean);
    if (words.length === 0 || zoneWidth <= 0) return;

    const cs = getComputedStyle(ledeEl);
    const probe = document.createElement('span');
    probe.style.position = 'absolute';
    probe.style.visibility = 'hidden';
    probe.style.whiteSpace = 'nowrap';
    probe.style.fontFamily = cs.fontFamily;
    probe.style.fontSize = cs.fontSize;
    probe.style.fontWeight = cs.fontWeight;
    document.body.appendChild(probe);

    const offenders: string[] = [];
    for (const word of words) {
      if (word.indexOf('\u00AD') !== -1) continue; // has an eligible break point
      probe.textContent = word;
      if (probe.offsetWidth > zoneWidth) offenders.push(word);
    }
    probe.remove();

    if (offenders.length > 0) {
      console.warn(
        '[dedication] Palabra(s) sin soft hyphen que no caben en la zona ' +
          'ni al tamaño tipográfico mínimo -- revisar el contenido o añadir ' +
          '\\u00AD en un punto de sílaba: ' +
          offenders.map((w) => JSON.stringify(w)).join(', ')
      );
    }
  }

  // While the ink-reveal has split the guest name/dedication into per-line
  // spans (.ink-line), their clip-path is a percentage of each line's own
  // box -- refitting font-size/line-height here (e.g. from a 'resize'
  // fired mid-animation by a mobile browser's address bar settling) would
  // change that box's geometry out from under the in-progress reveal with
  // no transition, popping/cropping whatever fraction was already
  // revealed. Skip the refit while the animation is actually running.
  //
  // This used to key off .ink-line's mere presence in the DOM, which was
  // correct back when the sequence tore the spans down and rebuilt plain
  // text at the end -- .ink-line existing *was* "mid-animation". Now the
  // spans are the permanent, final markup (see showEverythingNow), so
  // that check would block every future fitAll() call for the rest of
  // the page's life, including legitimate ones from a later real resize
  // (address bar, orientation change) long after the reveal settled.
  // is-preparing-animation/is-animating (added right before splitIntoLines
  // creates the first .ink-line, removed once is-animation-complete is
  // set -- see startAnimationOnce/showEverythingNow) track the animation
  // itself, not the spans' lifetime, so refitting is blocked only for the
  // few seconds the reveal is actually in flight and freely allowed
  // before it starts and forever after it completes.
  function fitAll() {
    const cover = document.querySelector('.cover');
    if (cover?.classList.contains('is-preparing-animation') || cover?.classList.contains('is-animating')) return;
    document.querySelectorAll<HTMLElement>('[data-autofit]').forEach(fitText);
    fitDedicationHeight();
    checkDedicationOverflow();
  }

  fitAll();
  document.fonts?.ready.then(fitAll);
  window.addEventListener('resize', fitAll);

  // --- Slow handwritten-ink intro (elephant, duck, name, dedication, signature, location, CTA) ---
  //
  // Whole sequence targets ~18-23s (default guest ~20.5-21s): a long,
  // intimate, continuous "ink on paper" reveal, not a fast UI transition.
  // Elephant and duck draw in first (same ink technique as the text below),
  // then the text sequence runs. Texture and background are never touched
  // here -- they are visible from the very first frame.
  const EASE = 'cubic-bezier(0.22, 0.61, 0.36, 1)';

  function clamp(value: number, min: number, max: number) {
    return Math.min(max, Math.max(min, value));
  }

  // Dedication writing duration: unchanged below DEDICATION_DURATION_BREAK_LEN
  // chars (same base/slope/floor as before -- "Estefi y Matías"'s ~67-char
  // dedication still lands at ~7.2s, per the approved choreography). Past
  // that point it used to flatline at a fixed 8600ms ceiling; it now keeps
  // growing, on a second, shallower linear ramp anchored so a 160-char
  // dedication (the absolute cap enforced in guests.ts) lands at ~11000ms.
  // The two segments share their boundary value exactly (computed, not
  // hardcoded), so there's no jump at the breakpoint.
  const DEDICATION_DURATION_BASE = 3500;
  const DEDICATION_DURATION_SLOPE1 = 55;
  const DEDICATION_DURATION_MIN = 5600;
  const DEDICATION_DURATION_BREAK_LEN = 93;
  const DEDICATION_DURATION_MAX = 11000;
  const DEDICATION_DURATION_MAX_LEN = 160;

  function dedicationDurationFor(length: number) {
    const breakDuration = DEDICATION_DURATION_BASE + DEDICATION_DURATION_BREAK_LEN * DEDICATION_DURATION_SLOPE1;
    if (length <= DEDICATION_DURATION_BREAK_LEN) {
      return clamp(DEDICATION_DURATION_BASE + length * DEDICATION_DURATION_SLOPE1, DEDICATION_DURATION_MIN, breakDuration);
    }
    const slope2 =
      (DEDICATION_DURATION_MAX - breakDuration) / (DEDICATION_DURATION_MAX_LEN - DEDICATION_DURATION_BREAK_LEN);
    return clamp(
      breakDuration + (length - DEDICATION_DURATION_BREAK_LEN) * slope2,
      breakDuration,
      DEDICATION_DURATION_MAX
    );
  }

  // Evaluates the same curve as EASE, so --reveal can be driven manually
  // in step with the native CSS transition used for clip-path (see below).
  function cubicBezierEase(p1x: number, p1y: number, p2x: number, p2y: number) {
    const cx = 3 * p1x;
    const bx = 3 * (p2x - p1x) - cx;
    const ax = 1 - cx - bx;
    const cy = 3 * p1y;
    const by = 3 * (p2y - p1y) - cy;
    const ay = 1 - cy - by;
    const sampleX = (t: number) => ((ax * t + bx) * t + cx) * t;
    const sampleY = (t: number) => ((ay * t + by) * t + cy) * t;
    const sampleDerivativeX = (t: number) => (3 * ax * t + 2 * bx) * t + cx;
    return (x: number) => {
      let t = x;
      for (let i = 0; i < 6; i++) {
        const dx = sampleX(t) - x;
        const d = sampleDerivativeX(t);
        if (Math.abs(d) < 1e-6) break;
        t -= dx / d;
      }
      return sampleY(clamp(t, 0, 1));
    };
  }
  const easeReveal = cubicBezierEase(0.22, 0.61, 0.36, 1);

  function sleep(ms: number) {
    return new Promise<void>((resolve) => setTimeout(resolve, ms));
  }

  function nextFrame() {
    return new Promise<void>((resolve) => requestAnimationFrame(() => requestAnimationFrame(() => resolve())));
  }

  function waitForImages(root: ParentNode) {
    const imgs = Array.from(root.querySelectorAll<HTMLImageElement>('img[loading="eager"]'));
    return Promise.all(
      imgs.map((img) =>
        img.complete
          ? Promise.resolve()
          : new Promise<void>((resolve) => {
              img.addEventListener('load', () => resolve(), { once: true });
              img.addEventListener('error', () => resolve(), { once: true });
            })
      )
    );
  }

  // document.fonts.ready is the primary, cross-browser guarantee that the
  // custom typeface used by name/dedication/signature (all "Homemade
  // Apple") has finished loading. document.fonts.check is an extra,
  // best-effort confirmation on top of it -- wrapped in try/catch since
  // it isn't universally supported and a malformed/unsupported call must
  // never block the boot guard from ever lifting.
  async function waitForSignatureFonts(): Promise<void> {
    if (!document.fonts) return;
    await document.fonts.ready;
    try {
      const spec = '400 16px "Homemade Apple"';
      if (!document.fonts.check(spec)) {
        await document.fonts.load(spec);
      }
    } catch {
      // Unsupported in this engine -- document.fonts.ready above already
      // resolved, which is the real guarantee.
    }
  }

  // Slightly irregular vertical boundary, sampled top-to-bottom, so the ink
  // front reads as an uneven hand-drawn stroke rather than a ruled line.
  // fromRight anchors the fixed edge at 100% instead of 0% and mirrors the
  // moving edge (100 - x) -- needed for elements that are themselves
  // scaleX(-1)'d (elephant/duck), so the reveal still reads left-to-right
  // or right-to-left on screen as intended, not backwards after the mirror.
  function jaggedClipPath(percent: number, seed: number, fromRight = false) {
    const steps = 7;
    const anchor = fromRight ? '100%' : '0%';
    const points = [`${anchor} 0%`];
    for (let i = 0; i <= steps; i++) {
      const t = i / steps;
      const jitter = Math.sin((t * 6 + seed) * 3.7) * 2.2;
      let x = clamp(percent + jitter, 0, 100);
      if (fromRight) x = 100 - x;
      points.push(`${x.toFixed(2)}% ${(t * 100).toFixed(2)}%`);
    }
    points.push(`${anchor} 100%`);
    return `polygon(${points.join(', ')})`;
  }

  // A short, soft semi-transparent band riding just ahead of the jagged
  // clip edge -- "wet ink still settling" -- instead of a hard on/off cut.
  // Opaque BEFORE --reveal (already written), transparent AFTER it (not
  // yet reached). Every stop is offset FROM var(--reveal) -- none pinned
  // to a fixed 0%/100% -- so the whole ramp translates as one piece as
  // --reveal animates, instead of leaving a fixed band near the left edge
  // that doesn't track the sweep. At REVEAL_HIDDEN the entire ramp sits
  // left of 0% (fully transparent across the box); at REVEAL_SHOWN it
  // sits entirely right of 100% (fully opaque across the box).
  const INK_MASK =
    'linear-gradient(90deg, ' +
    '#000 calc(var(--reveal) - 60%), #000 calc(var(--reveal) - 7%), ' +
    'rgba(0,0,0,.6) calc(var(--reveal) - 3%), rgba(0,0,0,.18) var(--reveal), ' +
    'transparent calc(var(--reveal) + 4%), transparent calc(var(--reveal) + 60%))';
  // Same ramp, mirrored (270deg instead of 90deg) -- used for elements whose
  // clip boundary moves right-to-left in local space (fromRight below), so
  // the soft "wet ink" band stays aligned with the jagged clip edge instead
  // of drifting to the wrong side once the element's own scaleX(-1) flips it.
  const INK_MASK_REVERSED =
    'linear-gradient(270deg, ' +
    '#000 calc(var(--reveal) - 60%), #000 calc(var(--reveal) - 7%), ' +
    'rgba(0,0,0,.6) calc(var(--reveal) - 3%), rgba(0,0,0,.18) var(--reveal), ' +
    'transparent calc(var(--reveal) + 4%), transparent calc(var(--reveal) + 60%))';
  const REVEAL_HIDDEN_NUM = -12;
  const REVEAL_SHOWN_NUM = 110;
  const REVEAL_HIDDEN = `${REVEAL_HIDDEN_NUM}%`;
  const REVEAL_SHOWN = `${REVEAL_SHOWN_NUM}%`;

  // Sets the fully-hidden state instantly (no transition), so this is what
  // gets painted on the very first frame -- never a flash of visible text.
  function prepareInkHidden(el: HTMLElement, seed: number, fromRight = false) {
    const mask = fromRight ? INK_MASK_REVERSED : INK_MASK;
    el.style.transition = 'none';
    el.style.clipPath = jaggedClipPath(-10, seed, fromRight);
    el.style.setProperty('--reveal', REVEAL_HIDDEN);
    el.style.setProperty('mask-image', mask);
    el.style.setProperty('-webkit-mask-image', mask);
  }

  // Whether this engine actually tweens a *typed* custom property. Checked
  // once, live, instead of assumed: a CSS transition on --reveal only
  // interpolates smoothly when @property registered it as a <percentage>;
  // unregistered/unsupported engines snap it instantly at the transition's
  // halfway point, which is exactly the "signature pops at the end" bug.
  let revealTransitionVerified: boolean | null = null;

  function verifyRevealInterpolates(el: HTMLElement) {
    if (revealTransitionVerified !== null) return revealTransitionVerified;
    const probe = document.createElement('span');
    probe.style.position = 'absolute';
    probe.style.visibility = 'hidden';
    probe.style.setProperty('--reveal', '0%');
    probe.style.setProperty('transition', '--reveal 100ms linear');
    document.body.appendChild(probe);
    void probe.offsetWidth; // force layout so the starting value is committed
    probe.style.setProperty('--reveal', '100%');
    const midway = getComputedStyle(probe).getPropertyValue('--reveal').trim();
    probe.remove();
    // If the browser can't tween it, the computed value right after the
    // change either jumps straight to 100% or reports something that
    // isn't a mid-range percentage -- either way, not real interpolation.
    const midValue = parseFloat(midway);
    revealTransitionVerified = Number.isFinite(midValue) && midValue > 0 && midValue < 100;
    return revealTransitionVerified;
  }

  // Drives clip-path (a natively-animatable property) via a real CSS
  // transition, and drives --reveal by hand, frame by frame, with the
  // *same* easing curve -- so the ink-mask's soft edge always tracks
  // progressively regardless of @property support, instead of snapping
  // straight to "fully revealed" only when resetInkUnit later clears the
  // mask (the "pop"). CSS transition is kept as a harmless no-op fallback
  // for engines that do support it, since both land on the same values.
  function triggerInkReveal(el: HTMLElement, duration: number, delay: number, seed: number, fromRight = false) {
    verifyRevealInterpolates(el);
    el.style.transition = `clip-path ${duration}ms ${EASE} ${delay}ms`;
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        el.style.clipPath = jaggedClipPath(112, seed, fromRight);
      });
    });

    let start: number | null = null;
    function step(now: number) {
      if (start === null) start = now;
      const elapsed = now - start - delay;
      if (elapsed < 0) {
        requestAnimationFrame(step);
        return;
      }
      const t = clamp(elapsed / duration, 0, 1);
      const value = REVEAL_HIDDEN_NUM + (REVEAL_SHOWN_NUM - REVEAL_HIDDEN_NUM) * easeReveal(t);
      el.style.setProperty('--reveal', `${value.toFixed(2)}%`);
      if (t < 1) {
        requestAnimationFrame(step);
      }
    }
    requestAnimationFrame(step);
  }

  function resetInkUnit(el: HTMLElement) {
    el.style.clipPath = '';
    el.style.transition = '';
    el.style.removeProperty('--reveal');
    el.style.removeProperty('mask-image');
    el.style.removeProperty('-webkit-mask-image');
  }

  // --- Guest name / dedication line reveal: clip-path only, no mask ---
  //
  // The elephant/duck reveal above pairs clip-path with the INK_MASK
  // gradient (driven by --reveal) for a soft "wet ink" leading edge. The
  // name/dedication lines used to share that exact mechanism, but a
  // controlled A/B test (freezing clip-path and --reveal at an identical
  // mid-reveal value, then toggling only mask-image) showed the mask
  // suppressing ink that the clip-path alone already permitted -- a real
  // mismatch between the two, not a timing illusion, and exactly the
  // "fixed transparent band at the left edge" being reported. Lines get
  // their own single-mechanism reveal instead: clip-path alone, natively
  // animatable and not dependent on any custom-property/calc() interplay
  // for its interpolation, so there is nothing left for a second
  // mechanism to disagree with.
  // Horizontal bleed lives in .ink-line's own box (padding-left/right +
  // an equal negative margin-left/right, see the CSS below), not in this
  // polygon -- a fixed negative/over-100% x-coordinate here would put
  // that bleed strip permanently inside the clipped-in region, at every
  // percent including the hidden one, leaking whatever ink sits in it
  // (a cursive entry stroke) before the line ever starts revealing. With
  // the bleed folded into the box instead, 0%/100% are the box's own
  // (widened, but visually unmoved -- see the CSS) edges, so a plain 0%
  // -to-100% sweep already covers the full bleed once it completes,
  // with nothing exposed early.
  const LINE_BLEED_EM = 0.5;

  // The left edge is always a flat 0% -- never negative, never animated.
  // Top/bottom get a constant vertical bleed (ascenders/descenders/
  // accents past the line box's own height): unlike a horizontal bleed,
  // a vertical one can't leak anything early, since at percent<=0 the
  // polygon's left and right edges coincide at 0% -- zero width, so zero
  // area, regardless of how tall it is. Only the right edge moves,
  // sweeping from 0% up to 100% of the (bleed-widened) box; the
  // irregular jitter rides only that moving edge, same as
  // jaggedClipPath above. At the fully-revealed call (percent >= 100),
  // every jittered point clamps to the same 100%, so the resting right
  // edge -- like the fixed left one -- is a plain straight line already
  // at the box's true edge: the last frame with clip-path still applied
  // shows the exact same ink as removing it entirely.
  function lineClipPath(percent: number, seed: number): string {
    const steps = 7;
    const verticalBleed = `${LINE_BLEED_EM}em`;
    const left = '0%';
    const top = `-${verticalBleed}`;
    const bottom = `calc(100% + ${verticalBleed})`;

    const points = [`${left} ${top}`];
    for (let i = 0; i <= steps; i++) {
      const t = i / steps;
      const jitter = Math.sin((t * 6 + seed) * 3.7) * 2.2;
      const x = clamp(percent + jitter, 0, 100);
      points.push(`${x.toFixed(2)}% ${(t * 100).toFixed(2)}%`);
    }
    points.push(`${left} ${bottom}`);
    return `polygon(${points.join(', ')})`;
  }

  function prepareLineHidden(el: HTMLElement, seed: number) {
    el.style.transition = 'none';
    el.style.clipPath = lineClipPath(-10, seed);
  }

  // Leaving the completed clip-path in place permanently (rather than
  // clearing it) turned out to trade a subpixel antialiasing difference
  // for a worse, real bug: on long, many-line dedications some line's
  // "100%" polygon didn't actually cover every pixel of its own ink, and
  // with nothing ever clearing it, that gap stayed cut off forever
  // instead of being masked by the later cleanup. A permanent clip is
  // never safe to rely on, no matter how carefully the polygon is
  // built -- so each line now clears its own clip-path right after its
  // own transition ends (not just once, globally, at the very end of
  // the whole sequence): transitionend fires once the box is already
  // sitting at the fully-revealed 100% frame, and clearing one frame
  // later removes the clip while every pixel of ink is already exactly
  // where it belongs, closing whatever gap the polygon itself might
  // have left, line by line, well before showEverythingNow ever runs.
  function triggerLineReveal(el: HTMLElement, duration: number, delay: number, seed: number) {
    el.style.transition = `clip-path ${duration}ms ${EASE} ${delay}ms`;
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        el.style.clipPath = lineClipPath(112, seed);
      });
    });

    el.addEventListener(
      'transitionend',
      (ev) => {
        if (ev.propertyName !== 'clip-path') return;
        requestAnimationFrame(() => {
          el.style.clipPath = '';
          el.style.transition = '';
        });
      },
      { once: true }
    );
  }

  // Emergency/fallback cleanup: whatever state a line's clip-path is
  // still in -- fully settled and already self-cleared above, mid-reveal
  // (a superseded run, the 8s safety timeout, an error abandoning the
  // sequence early) -- clearing it here always lands on the same normal,
  // fully-visible resting state. Never left in place; see
  // triggerLineReveal above for why a permanent clip isn't trustworthy.
  function resetLineUnit(el: HTMLElement) {
    el.style.clipPath = '';
    el.style.transition = '';
  }

  // --- Signature reveal: one rectangular clip over the whole signature ---
  //
  // "Fátima & Andrés" reveals as a single unit -- one clip-path: inset(...)
  // applied to .cover__names, whose right edge sweeps from fully-closed to
  // fully-open. There is no per-word clip, mask or progress: whatever the
  // sweep has reached (Fátima, then &, then Andrés) is simply whatever
  // falls inside the currently-visible rectangle. The clip is sized to an
  // *expanded* box -- .cover__names' own measured width plus a fixed
  // safety margin on every side (20px above, 55px below, 20px left, 20px
  // right) so ascenders, descenders and calligraphic overshoot across the
  // whole signature always sit inside the clipped area, never trimmed by
  // a box clipped tight to the typographic bounding box. Insets are
  // computed in plain px from the element's own measured width -- never
  // CSS %, which is always relative to the box's *own* width alone and
  // can't express "hide the margin too" -- so progress=0 truly hides the
  // entire expanded box, margin included, not just the original width.
  // The left edge of the expanded box never moves (never used to drive
  // progress); only the right edge sweeps, from 0px visible up to the
  // expanded width.
  const SIGNATURE_MARGIN_TOP = 20;
  const SIGNATURE_MARGIN_BOTTOM = 55;
  const SIGNATURE_MARGIN_LEFT = 20;
  const SIGNATURE_MARGIN_RIGHT = 20;

  function signatureClipPath(progress: number, width: number): string {
    const expandedWidth = width + SIGNATURE_MARGIN_LEFT + SIGNATURE_MARGIN_RIGHT;
    const rightInset = (1 - progress) * expandedWidth - SIGNATURE_MARGIN_RIGHT;
    return `inset(-${SIGNATURE_MARGIN_TOP}px ${rightInset}px -${SIGNATURE_MARGIN_BOTTOM}px -${SIGNATURE_MARGIN_LEFT}px)`;
  }

  // Closes the clip down to nothing, instantly, so this is what's painted
  // on the very first frame -- never a flash of any part of the signature.
  function prepareSignatureHidden(el: HTMLElement) {
    el.style.clipPath = signatureClipPath(0, el.offsetWidth);
  }

  // Linear, frame-driven progress: the whole assigned duration is spent
  // sweeping (no easing curve lets the clip "arrive early"), so the
  // signature advances uniformly and is never near-complete early on.
  function signatureProgress(t: number): number {
    if (t <= 0) return 0;
    if (t >= 1) return 1;
    return t;
  }

  function triggerSignatureReveal(el: HTMLElement, duration: number, delay: number) {
    const width = el.offsetWidth;
    const startTime = performance.now() + delay;
    let resetFrames = 0;

    function step(now: number) {
      const progress = clamp((now - startTime) / duration, 0, 1);
      el.style.clipPath = signatureClipPath(signatureProgress(progress), width);

      if (progress < 1) {
        requestAnimationFrame(step);
        return;
      }

      // progress === 1: the signature is already fully visible -- wait
      // two more frames, invisibly holding that finished state, before
      // any caller-side cleanup runs, so the reset never overlaps the
      // settle.
      if (resetFrames < 2) {
        resetFrames += 1;
        requestAnimationFrame(step);
      }
    }

    requestAnimationFrame(step);
  }

  // Waits exactly two rAF frames (never setTimeout) past the fully-revealed
  // state before touching the clip-path, then re-applies the very same
  // fully-revealed value -- so the frame right before and right after this
  // runs are visually identical, never a pop.
  function resetSignatureUnit(el: HTMLElement) {
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        el.style.clipPath = signatureClipPath(1, el.offsetWidth);
      });
    });
  }

  // Location and CTA are not "written" -- they simply settle in once the
  // signature is done, per spec: a plain gentle fade + tiny rise.
  function prepareFadeHidden(el: HTMLElement) {
    el.style.transition = 'none';
    el.style.opacity = '0';
    el.style.transform = 'translateY(2px)';
  }

  function triggerFade(el: HTMLElement, duration: number, delay: number) {
    el.style.transition = `opacity ${duration}ms ease-out ${delay}ms, transform ${duration}ms ease-out ${delay}ms`;
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        el.style.opacity = '1';
        el.style.transform = 'translateY(0)';
      });
    });
  }

  function resetFadeUnit(el: HTMLElement) {
    el.style.opacity = '';
    el.style.transform = '';
    el.style.transition = '';
  }

  function prepareUnderlineHidden(el: HTMLElement) {
    el.style.setProperty('--cta-underline', '0%');
  }

  function triggerUnderline(el: HTMLElement, duration: number, delay: number) {
    el.style.setProperty('transition', `${el.style.transition ? el.style.transition + ', ' : ''}--cta-underline ${duration}ms ${EASE} ${delay}ms`);
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        el.style.setProperty('--cta-underline', '100%');
      });
    });
  }

  function resetUnderline(el: HTMLElement) {
    el.style.removeProperty('--cta-underline');
  }

  // Wraps each word in a span, measures its rendered line via offsetTop,
  // then regroups the words into per-line wrappers. Works for any text
  // length/line count without hard-coding a number of lines.
  // A word containing a soft hyphen (U+00AD, see guests.ts) is one token
  // here -- \S matches it, it's not whitespace -- but if the browser
  // actually breaks the word there, that one <span> now visually spans two
  // rendered lines. offsetTop alone (used below) would then attribute the
  // *whole* word, including the part that visually overflows onto the next
  // line, to only the first line's ink-reveal wrapper. This walks the
  // span's own text character-by-character (via Range, cheap for a single
  // word) to find exactly where the render breaks, and splits the DOM
  // there into two fresh spans -- one per visual line -- so each is grouped
  // correctly below. A no-op (returns the original span) for the vast
  // majority of words that only ever render on one line.
  function splitWrappedWordSpan(span: HTMLElement): HTMLElement[] {
    const text = span.textContent ?? '';
    const textNode = span.firstChild;
    if (!textNode || text.length < 2) return [span];

    const range = document.createRange();
    const firstTop = span.getClientRects()[0]?.top;
    if (firstTop === undefined) return [span];

    let splitIndex = -1;
    for (let i = 1; i < text.length; i++) {
      range.setStart(textNode, 0);
      range.setEnd(textNode, i);
      const rects = range.getClientRects();
      const lastRect = rects[rects.length - 1];
      if (lastRect && Math.abs(lastRect.top - firstTop) > 1) {
        splitIndex = i - 1;
        break;
      }
    }
    if (splitIndex < 1 || splitIndex >= text.length) return [span];

    // Plain .ink-word spans, same as any other word -- no clip-path, mask
    // or padding of their own. The only thing that ever clips or masks
    // ink is .ink-line, once, on the shared line box both halves end up
    // in; these just need to never restrict their own content, which
    // display:inline + the default overflow:visible already guarantees.
    const firstSpan = document.createElement('span');
    firstSpan.className = 'ink-word';
    firstSpan.textContent = text.slice(0, splitIndex);
    const secondSpan = document.createElement('span');
    secondSpan.className = 'ink-word';
    secondSpan.textContent = text.slice(splitIndex);
    span.replaceWith(firstSpan, secondSpan);
    return [firstSpan, secondSpan];
  }

  function splitIntoLines(el: HTMLElement): HTMLElement[] {
    const original = el.textContent ?? '';
    const tokens = original.match(/\S+\s*/g) ?? [original];

    el.textContent = '';
    let wordEls = tokens.map((token) => {
      const span = document.createElement('span');
      span.className = 'ink-word';
      span.textContent = token;
      el.appendChild(span);
      return span;
    });

    wordEls = wordEls.flatMap((span) =>
      span.getClientRects().length > 1 ? splitWrappedWordSpan(span) : [span]
    );

    const lineMap = new Map<number, HTMLElement[]>();
    wordEls.forEach((span) => {
      const top = span.offsetTop;
      if (!lineMap.has(top)) lineMap.set(top, []);
      lineMap.get(top)!.push(span);
    });

    const tops = [...lineMap.keys()].sort((a, b) => a - b);
    el.textContent = '';
    return tops.map((top) => {
      const lineEl = document.createElement('span');
      lineEl.className = 'ink-line';
      lineMap.get(top)!.forEach((span) => lineEl.appendChild(span));
      el.appendChild(lineEl);
      return lineEl;
    });
  }

  // Reveals lines top-to-bottom as one continuous gesture: each line's
  // share of the total duration is weighted by its actual rendered width
  // (not char count), and the next line begins before the previous one
  // has fully settled (LINE_OVERLAP_MS) so the multi-line block reads as
  // a single unbroken stroke rather than independent chunks loading in.
  const LINE_OVERLAP_MS = 210;
  const MIN_LINE_DURATION_MS = 550;

  function revealLines(lines: HTMLElement[], totalDuration: number, seedBase: number) {
    const n = lines.length;
    if (n === 0) return 0;
    if (n === 1) {
      triggerLineReveal(lines[0], totalDuration, 0, seedBase);
      return totalDuration;
    }

    const widths = lines.map((line) => Math.max(line.scrollWidth, 1));
    const totalWidth = widths.reduce((a, b) => a + b, 0);
    const overlapBudget = LINE_OVERLAP_MS * (n - 1);
    const durationBudget = Math.max(totalDuration - overlapBudget, totalDuration * 0.6);

    let durations = widths.map((w) => Math.max(MIN_LINE_DURATION_MS, durationBudget * (w / totalWidth)));
    const sum = durations.reduce((a, b) => a + b, 0);
    const scale = sum > 0 ? durationBudget / sum : 1;
    durations = durations.map((d) => d * scale);

    let cursor = 0;
    lines.forEach((line, i) => {
      triggerLineReveal(line, durations[i], cursor, seedBase + i);
      if (i < n - 1) cursor += durations[i] - LINE_OVERLAP_MS;
    });
    return cursor + durations[n - 1];
  }

  // The single place every exit path converges on: normal completion,
  // the error fallback, reduced motion, and the 8s safety timeout. It
  // never rebuilds anything -- the guest name and dedication keep the
  // exact per-line/per-word spans splitIntoLines produced (if it ever
  // ran at all); this only strips whatever ink-reveal styling is
  // currently on them, however far the reveal got. Clearing clip-path/
  // mask-image/transition off an element already sitting at its fully
  // -revealed value is visually a no-op (no clip == the same "everything
  // visible" result), so the frame right before and right after this
  // runs are pixel-identical -- there is no separate "final" layout to
  // fall back to, and so no chance for one to disagree with the other.
  function showEverythingNow(cover: HTMLElement) {
    bootCompleted = true;
    cover.removeAttribute('data-cover-boot');
    cover.classList.remove('is-preparing-animation', 'is-animating');
    cover.classList.add('is-animation-complete');

    cover.querySelectorAll<HTMLElement>('.ink-line').forEach(resetLineUnit);
    const elephantEl = cover.querySelector<HTMLElement>('[data-animation="elephant"]');
    const duckEl = cover.querySelector<HTMLElement>('[data-animation="duck"]');
    const namesEl = cover.querySelector<HTMLElement>('.cover__names');
    const locationEl = cover.querySelector<HTMLElement>('[data-animation="location"]');
    const ctaEl = cover.querySelector<HTMLElement>('[data-animation="cta"]');
    if (elephantEl) resetInkUnit(elephantEl);
    if (duckEl) resetInkUnit(duckEl);
    if (namesEl) resetSignatureUnit(namesEl);
    if (locationEl) resetFadeUnit(locationEl);
    if (ctaEl) resetFadeUnit(ctaEl);
    if (ctaEl) resetUnderline(ctaEl);
  }

  // True whenever <html> carries is-landscape-locked -- set by the inline
  // script above only for phones/tablets (coarse pointer or touch
  // points, short side <= 1024px) currently in landscape. Laptops/desktops
  // never set it, so this is always false for them.
  function isLandscapeGate(): boolean {
    return document.documentElement.classList.contains('is-landscape-locked');
  }

  // animationStarted / waitingForPortrait / animationRunToken / bootCompleted:
  // the whole start-once, restart-safe state machine lives in these four.
  // animationRunToken is bumped on every real (re)start attempt so any
  // `await` still in flight from a superseded attempt (device rotated
  // back to landscape mid-load, or the 8s safety fired) can tell it's
  // stale and stop touching the DOM.
  let animationStarted = false;
  let waitingForPortrait = false;
  let animationRunToken = 0;
  let bootCompleted = false;

  // Section 3 / step 6 of the landscape-return sequence: wait for fonts,
  // critical images, two more animation frames, then report whether the
  // device is still in an allowed (non-landscape-gated) state. Never
  // mutates anything -- callers decide what to do with the result.
  async function waitForReadyState(token: number, cover: HTMLElement): Promise<boolean> {
    await Promise.all([waitForSignatureFonts(), waitForImages(cover)]);
    if (token !== animationRunToken) return false;
    fitAll();
    await nextFrame();
    if (token !== animationRunToken) return false;
    return !isLandscapeGate();
  }

  async function startAnimationOnce(token: number, cover: HTMLElement) {
    const nameEl = cover.querySelector<HTMLElement>('[data-animation="guest-name"]');
    const dedicationEl = cover.querySelector<HTMLElement>('[data-animation="dedication"]');
    const namesEl = cover.querySelector<HTMLElement>('.cover__names');
    const locationEl = cover.querySelector<HTMLElement>('[data-animation="location"]');
    const ctaEl = cover.querySelector<HTMLElement>('[data-animation="cta"]');
    const elephantEl = cover.querySelector<HTMLElement>('[data-animation="elephant"]');
    const duckEl = cover.querySelector<HTMLElement>('[data-animation="duck"]');

    if (!nameEl || !dedicationEl || !namesEl || !locationEl || !ctaEl || !elephantEl || !duckEl) {
      showEverythingNow(cover);
      return;
    }

    const originalName = nameEl.textContent ?? '';
    const originalDedication = dedicationEl.textContent ?? '';

    try {
      const ready = await waitForReadyState(token, cover);
      if (token !== animationRunToken) return;
      if (!ready) {
        // Rotated back to landscape while fonts/images were still
        // loading -- go back to the waiting state; the orientation
        // checker below calls startAnimationOnce again, from scratch,
        // once is-landscape-locked clears for real.
        animationStarted = false;
        waitingForPortrait = true;
        return;
      }

      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduceMotion) {
        // Straight from the protected initial state to the final one --
        // no timers, no masks, no intermediate frame with incomplete
        // styles.
        showEverythingNow(cover);
        return;
      }

      const nameLen = originalName.trim().length;
      // Soft hyphens (U+00AD) are invisible unless actually broken across a
      // line -- excluded here too, so they never inflate the writing
      // duration (matches getVisibleDedicationLength in guests.ts).
      const dedicationLen = originalDedication.trim().replace(/\u00AD/g, '').length;
      // Calibrated so "Estefi y Matías" (~15 chars) lands near 3.1s and its
      // dedication (~67 chars) near 7.2s, per the approved choreography.
      // Longer dedications (up to the 160-char cap) keep growing past that
      // via dedicationDurationFor -- see its definition above.
      const nameDuration = clamp(2400 + nameLen * 47, 2400, 3900);
      const dedicationDuration = dedicationDurationFor(dedicationLen);
      const signatureDuration = 5000;
      const locationDuration = 1200;
      const ctaDuration = 1200;
      const ctaStagger = 370;
      const underlineDuration = 1100;

      // Marks the cover as "animation in progress" before splitIntoLines
      // creates the first .ink-line -- fitAll() reads this class (not
      // .ink-line's mere presence, which now outlives the animation) to
      // know whether it's safe to refit. Covering the window from here,
      // not from nextFrame() below, means there's no gap where .ink-line
      // exists but the class hasn't caught up yet.
      cover.classList.add('is-preparing-animation');

      const nameLines = splitIntoLines(nameEl);
      const dedicationLines = splitIntoLines(dedicationEl);

      // Hide everything up front, in the same tick, so the first thing
      // ever painted is the hidden state -- not a flash of visible text.
      nameLines.forEach((line, i) => prepareLineHidden(line, i));
      dedicationLines.forEach((line, i) => prepareLineHidden(line, 100 + i));
      // fromRight=true on the elephant compensates for its own scaleX(-1)
      // so the reveal still reads as "entering from the left" on screen
      // (see jaggedClipPath); the duck's default direction already reads
      // right-to-left toward the center once its own scaleX(-1) is applied.
      prepareInkHidden(elephantEl, 200, true);
      prepareInkHidden(duckEl, 201, false);
      prepareSignatureHidden(namesEl);
      prepareFadeHidden(locationEl);
      prepareFadeHidden(ctaEl);
      prepareUnderlineHidden(ctaEl);
      await nextFrame();
      if (token !== animationRunToken) return;

      // The finer-grained per-element hidden state above (clip-path/mask/
      // opacity) is now in place and painted, so lifting the coarse FOUC
      // guard here causes no visible change -- both states already look
      // fully hidden.
      bootCompleted = true;
      cover.removeAttribute('data-cover-boot');

      // Animals draw in slowly, overlapping the text sequence rather than
      // blocking it. Elephant leads (delay 0), duck follows with a small
      // stagger (delay 250ms); both run 11000ms, well past the point the
      // text sequence starts below.
      const elephantRevealDelay = 0;
      const elephantRevealDuration = 11000;
      const duckRevealDelay = 250;
      const duckRevealDuration = 11000;
      triggerInkReveal(elephantEl, elephantRevealDuration, elephantRevealDelay, 200, true);
      triggerInkReveal(duckEl, duckRevealDuration, duckRevealDelay, 201, false);

      await sleep(1300); // silence: scene visible, nothing written yet
      if (token !== animationRunToken) return;

      cover.classList.add('is-animating');

      // revealLines returns the *actual* elapsed time its staggered,
      // overlapping lines take to settle -- shorter than the nominal
      // nameDuration/dedicationDuration by 2 * LINE_OVERLAP_MS per extra
      // line, since each line starts before the previous one fully
      // finishes. Sleeping against the nominal duration instead (as
      // before) left a dead gap after the text had already finished
      // writing and before the next phase began -- most noticeable
      // between the dedication and the signature on multi-line dedications.
      const nameActualDuration = revealLines(nameLines, nameDuration, 0);
      await sleep(Math.max(nameActualDuration - 250, 0));
      if (token !== animationRunToken) return;

      const dedicationActualDuration = revealLines(dedicationLines, dedicationDuration, 100);
      await sleep(Math.max(dedicationActualDuration - 250, 0));
      if (token !== animationRunToken) return;

      triggerSignatureReveal(namesEl, signatureDuration, 0);
      await sleep(Math.max(signatureDuration - 150, 0));
      if (token !== animationRunToken) return;

      triggerFade(locationEl, locationDuration, 0);
      triggerFade(ctaEl, ctaDuration, ctaStagger);
      triggerUnderline(ctaEl, underlineDuration, ctaStagger + ctaDuration * 0.6);

      const metaSpan = Math.max(
        locationDuration,
        ctaStagger + ctaDuration,
        ctaStagger + ctaDuration * 0.6 + underlineDuration
      );
      await sleep(metaSpan);
      if (token !== animationRunToken) return;

      await sleep(1300); // final settle: nothing else moves
      if (token !== animationRunToken) return;

      // No textContent/innerHTML swap here: the .ink-line/.ink-word spans
      // splitIntoLines produced *are* the final markup. showEverythingNow
      // below strips their ink-reveal styling in place, so the line
      // breaks, word wrapping and hyphens that were on screen for the
      // whole reveal are exactly what's left standing afterward -- never
      // a second, independently-computed "final" layout to disagree with
      // the animated one.
      showEverythingNow(cover);
    } catch (err) {
      // Never leave the cover partially hidden if something goes wrong.
      // Same reasoning as above: whatever markup exists (split or still
      // plain, depending on how early this failed) is left as-is.
      showEverythingNow(cover);
    }
  }

  // The single entry point, matching the spec's central condition
  // exactly: starts once, restarts after a landscape round-trip only if
  // it never truly started, and never restarts once it has.
  function maybeStartAnimation() {
    if (animationStarted) return;
    const cover = document.querySelector<HTMLElement>('.cover');
    if (!cover) return;

    if (isLandscapeGate()) {
      waitingForPortrait = true;
      return;
    }

    waitingForPortrait = false;
    animationStarted = true;
    const token = ++animationRunToken;
    startAnimationOnce(token, cover);
  }

  // Re-checks after every event that could flip is-landscape-locked.
  // Double rAF so this always runs *after* the inline script's own
  // (single-rAF-scheduled) class update for the same event -- otherwise
  // this could read a stale class on the very frame orientation changes.
  function scheduleAnimationCheck() {
    requestAnimationFrame(() => requestAnimationFrame(maybeStartAnimation));
  }

  maybeStartAnimation();
  window.addEventListener('resize', scheduleAnimationCheck);
  window.addEventListener('orientationchange', scheduleAnimationCheck);
  window.visualViewport?.addEventListener('resize', scheduleAnimationCheck);

  // Pure safety net, never part of the normal flow: a stuck load (a JS
  // error nothing caught, a font/image that never resolves, a device
  // stuck reporting landscape) must never hide the invitation forever.
  //
  // This is a *boot* watchdog, not a whole-sequence one, and can't become
  // one by accident: it starts counting from script evaluation (page
  // load), but its only guard is bootCompleted -- a one-way latch flipped
  // near the very start of startAnimationOnce, right after fonts/images
  // resolve and the first hidden frame is painted, well before the
  // ~18-23s reveal (elephant/duck/name/dedication/signature/location/CTA)
  // even begins. Once true it never flips back, so by the time this timer
  // could fire against a run that's actually progressing, bootCompleted
  // is already true and it no-ops -- it can only ever fire while still
  // waiting on fonts/images/orientation, i.e. before the visible sequence
  // has started at all. There is nothing to size against the sequence's
  // own computed duration here: that duration is irrelevant to what this
  // timer guards.
  window.setTimeout(() => {
    if (bootCompleted) return;
    animationRunToken += 1; // invalidate any run still in flight
    animationStarted = true;
    const cover = document.querySelector<HTMLElement>('.cover');
    if (cover) showEverythingNow(cover);
  }, 8000);
</script>


<style>
  /*
    Registers --reveal as a typed <percentage> custom property. Not load
    -bearing for the reveal animation anymore (triggerInkReveal above
    drives --reveal itself, frame by frame, so it never depends on this
    being honored) but kept so calc() involving it parses as arithmetic
    on a percentage everywhere, and any browser that *does* support typed
    custom properties gets a real fallback transition for free. As a
    selector-less at-rule it can't be (and isn't) scoped by Astro, so it's
    safe living in the same block as the rest of the component's styles --
    keeping it in one <style> tag also avoids any risk of a second,
    accidentally-malformed <style>...<style> block silently dropping the
    rule that follows it.
  */
  @property --reveal {
    syntax: '<percentage>';
    inherits: true;
    initial-value: 0%;
  }

  /*
    Applied to <html> and <body> only while the mobile-portrait fill mode
    or the landscape rotate-device notice is active (both toggled by the
    inline script above) -- laptops/desktops never get this class, so
    their document is completely untouched. Removes any outer margin and
    blocks page-level scroll/bounce so the cover is the only thing the
    visible viewport can ever show.
  */
  :global(html.is-viewport-locked),
  :global(body.is-viewport-locked) {
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    overflow: hidden;
    overscroll-behavior: none;
  }

  /*
    Fixed logical canvas: the cover is a fixed artistic composition
    designed at exactly 390x844 -- it no longer redistributes internally
    per device. .cover-frame fills the real viewport and centers
    .cover-canvas, a constant 390x844 box holding the untouched 390x844
    composition below, uniformly scaled via --cover-scale (computed in the
    inline script above, before first paint) to fit any screen without
    cropping, deforming, or scrolling. Leftover space is letterboxed with
    the same paper texture as the canvas itself (background-image set
    inline above), scaled with the same object-position/size the canvas
    texture uses, so the exterior reads as more paper -- not a flat-color
    frame around it. --color-bg stays as the fallback while it loads.
  */
  .cover-frame {
    width: 100%;
    height: 100svh;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-bg);
    background-size: cover;
    background-repeat: no-repeat;
    background-position: 60% top;
  }

  /* @supports keeps this from being minified away as a "duplicate" of the
     100svh fallback above -- browsers without dvh support correctly keep
     using svh instead of losing the height declaration entirely. */
  @supports (height: 100dvh) {
    .cover-frame {
      height: 100dvh;
    }
  }

  /*
    Portrait phones/tablets under 1200px only: the frame is pinned to the
    exact visible viewport box measured by the inline script
    (--cover-viewport-width/height, from visualViewport) instead of the
    svh/dvh percentage above, and taken out of document flow entirely so
    no ancestor's layout can reintroduce a scrollbar or outer margin.
    Laptops/desktops (no is-fill-viewport class) never match this rule.
  */
  :global(html.is-fill-viewport) .cover-frame {
    position: fixed;
    inset: 0;
    width: var(--cover-viewport-width, 100%);
    height: var(--cover-viewport-height, 100svh);
  }

  .cover-canvas {
    width: 390px;
    height: 844px;
    flex-shrink: 0;
    transform-origin: center center;
    /* Falls back to scale(1) with no JS: still fully visible and
       centered, just not scale-corrected (cropped by .cover-frame's
       overflow:hidden on very small screens instead of blank). */
    transform: scale(var(--cover-scale, 1));
  }

  /*
    Same portrait/phone-tablet path: the 390x844 canvas is stretched
    non-uniformly, independently on each axis, to exactly fill the
    measured viewport -- no Math.min, no aspect ratio preserved, no
    clamping. .cover-frame no longer centers it via flexbox (position:
    fixed above takes it out of flow), so centering is redone here with
    the standard translate(-50%,-50%) trick against the frame's own
    top/left 50%.
  */
  :global(html.is-fill-viewport) .cover-canvas {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) scale(var(--cover-scale-x, 1), var(--cover-scale-y, 1));
  }

  /*
    Below this point the composition is frozen at its approved 390x844
    pixel values (merged from the old base + "mobile portrait" rules,
    which is what actually rendered at 390 width). Per-device breakpoints
    that used to individually reposition/resize text, signature, duck,
    elephant, meta or CTA are gone -- adapting to the real device is now
    handled entirely by scaling the canvas above, uniformly.
  */
  .cover {
    position: relative;
    overflow: hidden;
    width: 100%;
    height: 100%;
    isolation: isolate;
  }

  /*
    FOUC guard: data-cover-boot="pending" is rendered server-side, right
    in the markup, so it is already present on the very first paint --
    nothing here waits on JS timing. While it is set, the pieces the
    reveal sequence writes (name, dedication, signature, location, CTA,
    elephant, duck) are hidden via opacity+visibility, which keeps their
    layout space -- no reflow when they later appear, and no display:none.
    Everything else (background, texture, the orientation notice) is
    untouched and visible from the first frame. The attribute is removed
    by the script above the instant the reveal's own per-element hidden
    state (clip-path/mask for elephant/duck; clip-path/mask/opacity for
    the rest) is already in place, so the handoff causes no visible
    change -- never a frame with the full, final content flashed.
  */
  .cover[data-cover-boot='pending'] [data-animation='guest-name'],
  .cover[data-cover-boot='pending'] [data-animation='dedication'],
  .cover[data-cover-boot='pending'] .cover__names,
  .cover[data-cover-boot='pending'] [data-animation='location'],
  .cover[data-cover-boot='pending'] [data-animation='cta'],
  .cover[data-cover-boot='pending'] [data-animation='elephant'],
  .cover[data-cover-boot='pending'] [data-animation='duck'] {
    opacity: 0;
    visibility: hidden;
  }

