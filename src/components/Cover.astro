---
import '@fontsource/sacramento/400.css';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<header class="cover">
  <img
    class="cover__texture"
    src={`${base}/images/textura-vertical.png`}
    alt=""
    role="presentation"
    width="705"
    height="967"
    loading="eager"
  />
  <img
    class="cover__elephant"
    src={`${base}/images/elephant.png`}
    alt="Ilustración de un elefante de perfil entrando desde la izquierda, trazo fino"
    width="1101"
    height="1856"
    loading="eager"
  />
  <img
    class="cover__duck"
    src={`${base}/images/duck.png`}
    alt="Ilustración de un pato mirando hacia el bloque central, trazo fino"
    width="768"
    height="1376"
    loading="eager"
  />

  <div class="cover__kicker-box">
    <p class="cover__kicker" data-autofit>Estefi y Matías</p>
  </div>
  <div class="cover__lede-box">
    <p class="cover__lede" data-autofit>Hay viajes que no tendrían el mismo sentido sin ciertas personas.</p>
  </div>

  <div class="cover__names">
    <h1 class="cover__title">
      <span>Fátima</span>
      <span class="cover__amp">&amp;</span>
      <span>Andrés</span>
    </h1>
    <p class="cover__location">Imbassaí, Bahía</p>
    <a class="cover__cta" href="#viaje">Comenzar el viaje</a>
  </div>
</header>

<script>
  function fitText(el: HTMLElement) {
    const box = el.parentElement;
    if (!box) return;
    el.style.fontSize = '';
    const maxSize = parseFloat(getComputedStyle(el).fontSize);
    let size = maxSize;
    let guard = 0;
    while (
      (el.scrollHeight > box.clientHeight || el.scrollWidth > box.clientWidth) &&
      size > 10 &&
      guard < 80
    ) {
      size -= 1;
      el.style.fontSize = size + 'px';
      guard++;
    }
  }

  function fitAll() {
    document.querySelectorAll<HTMLElement>('[data-autofit]').forEach(fitText);
  }

  fitAll();
  document.fonts?.ready.then(fitAll);
  window.addEventListener('resize', fitAll);
</script>

<style>
  .cover {
    position: relative;
    overflow: hidden;
    min-height: 100svh;
    isolation: isolate;
  }

  .cover__texture {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: 25% top;
    z-index: -1;
    pointer-events: none;
  }

  .cover__elephant,
  .cover__duck {
    position: absolute;
    z-index: 0;
    width: auto;
    height: auto;
    mix-blend-mode: multiply;
  }

  .cover__elephant {
    width: 60vw;
    left: -3vw;
    bottom: 0;
    transform: scaleX(-1);
  }

  .cover__duck {
    width: clamp(250px, 68vw, 320px);
    right: -6vw;
    top: -4svh;
    transform: scaleX(-1);
    filter: brightness(0.45) contrast(1.5);
    opacity: 1;
  }

  .cover__kicker-box {
    position: absolute;
    z-index: 1;
    left: 8.3vw;
    top: 3svh;
    width: 60.2vw;
    height: 9.4svh;
    display: flex;
    align-items: flex-start;
    overflow: hidden;
  }

  .cover__lede-box {
    position: absolute;
    z-index: 1;
    left: 4.1vw;
    top: 17svh;
    width: 63.3vw;
    height: 29.9svh;
    display: flex;
    align-items: flex-start;
    overflow: hidden;
  }

  .cover__names {
    position: absolute;
    z-index: 1;
    left: 76%;
    top: 58svh;
    transform: translateX(-50%);
    width: max-content;
    max-width: 52vw;
    text-align: center;
  }

  .cover__location {
    font-family: var(--font-sans);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 0.75rem;
    color: var(--color-muted);
    margin: 0 0 1rem;
  }

  .cover__kicker {
    width: 100%;
    font-family: 'Sacramento', cursive;
    font-weight: 400;
    font-size: 2rem;
    line-height: 1.15;
    color: var(--color-ink);
    margin: 0;
  }

  .cover__lede {
    width: 100%;
    font-family: 'Sacramento', cursive;
    font-weight: 400;
    font-size: 2.1rem;
    line-height: 1.25;
    color: var(--color-ink);
    margin: 0;
  }

  .cover__title {
    display: flex;
    flex-direction: column;
    align-items: center;
    font-family: 'Sacramento', cursive;
    font-weight: 400;
    font-size: clamp(3.2rem, 15vw, 4.4rem);
    line-height: 1.05;
    letter-spacing: 0;
    margin: 0 0 1.1rem;
  }

  .cover__title span {
    display: block;
  }

  .cover__amp {
    margin: -0.35em 0;
  }

  .cover__location {
    margin-bottom: 1.6rem;
  }

  .cover__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-sans);
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink);
    text-decoration: none;
    border-bottom: 1px solid var(--color-accent);
    padding-bottom: 0.35rem;
    width: fit-content;
    white-space: nowrap;
  }

  .cover__cta::after {
    content: '→';
  }

  @media (prefers-reduced-motion: no-preference) {
    .cover__cta {
      transition: color 0.2s ease, border-color 0.2s ease;
    }

    .cover__cta:hover,
    .cover__cta:focus-visible {
      color: var(--color-accent);
    }
  }

  /* Phone landscape (844x390) */
  @media (orientation: landscape) and (max-height: 500px) {
    .cover__elephant {
      width: 30vw;
      left: -2vw;
      bottom: -32svh;
    }

    .cover__duck {
      width: 26vw;
      right: 0;
      top: -1svh;
    }

    .cover__kicker-box {
      top: 6svh;
      left: 33vw;
      width: 45vw;
      height: 16svh;
    }

    .cover__lede-box {
      top: 24svh;
      left: 33vw;
      width: 45vw;
      height: 40svh;
    }

    .cover__names {
      left: 63%;
      top: 60svh;
      max-width: 34vw;
    }

    .cover__title {
      flex-direction: row;
      gap: 0.4em;
      font-size: clamp(1.7rem, 6vw, 2.3rem);
      margin-bottom: 0.7rem;
    }

    .cover__amp {
      margin: 0;
    }

    .cover__location {
      margin-bottom: 1rem;
    }
  }

  /* Tablet portrait / large vertical (1600x2560) */
  @media (orientation: portrait) and (min-width: 1200px) {
    .cover__elephant {
      width: 42vw;
      left: -4vw;
      bottom: -5svh;
    }

    .cover__duck {
      width: 30vw;
      right: 1vw;
      top: 3svh;
    }

    .cover__kicker-box {
      top: 7svh;
      left: 7vw;
      width: 52vw;
      height: 10svh;
    }

    .cover__lede-box {
      top: 19svh;
      left: 7vw;
      width: 52vw;
      height: 28svh;
    }

    .cover__kicker {
      font-size: 2.2rem;
    }

    .cover__lede {
      font-size: 2.4rem;
    }

    .cover__names {
      left: 68%;
      top: 76svh;
      max-width: 34vw;
    }

    .cover__title {
      font-size: clamp(4.2rem, 6vw, 5.4rem);
      margin-bottom: 1.6rem;
    }

    .cover__location {
      font-size: 1.05rem;
      margin-bottom: 2.4rem;
    }

    .cover__cta {
      font-size: 1.05rem;
    }
  }

  /* Tablet landscape / laptop (2560x1600) */
  @media (orientation: landscape) and (min-width: 1200px) {
    .cover__elephant {
      width: 26vw;
      left: -3vw;
      bottom: -12svh;
    }

    .cover__duck {
      width: 18vw;
      right: 2vw;
      top: 4svh;
    }

    .cover__kicker-box {
      top: 8svh;
      left: 8vw;
      width: 34vw;
      height: 9svh;
    }

    .cover__lede-box {
      top: 19svh;
      left: 8vw;
      width: 34vw;
      height: 22svh;
    }

    .cover__kicker {
      font-size: 1.8rem;
    }

    .cover__lede {
      font-size: 2rem;
    }

    .cover__names {
      left: 55%;
      top: 80svh;
      max-width: 30vw;
    }

    .cover__title {
      flex-direction: row;
      gap: 0.45em;
      font-size: clamp(3rem, 4vw, 4rem);
      margin-bottom: 1.2rem;
    }

    .cover__amp {
      margin: 0;
    }

    .cover__location {
      font-size: 0.95rem;
      margin-bottom: 1.8rem;
    }

    .cover__cta {
      font-size: 0.95rem;
    }
  }
</style>
