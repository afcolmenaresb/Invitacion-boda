    mix-blend-mode: multiply;
    opacity: 0.7;
    pointer-events: none;
  }

  .cover__elephant,
  .cover__duck {
    position: absolute;
    z-index: 0;
    width: auto;
    height: auto;
  }

  .cover__elephant {
    width: 54vw;
    left: -6vw;
    bottom: -7svh;
    transform: scaleX(-1);
  }

  .cover__duck {
    width: clamp(230px, 60vw, 300px);
    right: -3vw;
    top: -2svh;
    transform: scaleX(-1);
    filter: contrast(1.16) brightness(0.95);
    opacity: 0.97;
  }

  .cover__intro {
    position: relative;
    z-index: 1;
    align-self: flex-start;
    text-align: left;
    max-width: 74vw;
  }

  .cover__names {
    position: relative;
    z-index: 1;
    align-self: flex-end;
    text-align: right;
    width: max-content;
    max-width: 100%;
  }

  .cover__kicker,
  .cover__location {
    font-family: var(--font-sans);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 0.75rem;
    color: var(--color-muted);
    margin: 0 0 1rem;
  }

  .cover__kicker {
    margin-bottom: 0.6rem;
  }

  .cover__lede {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(1.05rem, 4vw, 1.25rem);
    line-height: 1.5;
    max-width: 28ch;
    margin: 0;
  }

  .cover__title {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(2.05rem, 8.2vw, 2.8rem);
    line-height: 1.05;
    letter-spacing: 0.01em;
    margin: 0 0 1.25rem;
  }

  .cover__title-name,
  .cover__title-amp {
    display: inline;
  }

  @media (max-width: 479px) {
    .cover__title-name,
    .cover__title-amp {
      display: block;
    }

    .cover__title-amp {
      font-size: 0.6em;
      margin-block: 0.12em;
    }
  }

  .cover__location {
    margin-bottom: 2.5rem;
  }

  .cover__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-sans);
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink);
    text-decoration: none;
    border-bottom: 1px solid var(--color-accent);
    padding-bottom: 0.35rem;
    width: fit-content;
  }

  .cover__cta::after {
    content: '→';
  }

  @media (prefers-reduced-motion: no-preference) {
    .cover__cta {
      transition: color 0.2s ease, border-color 0.2s ease;
    }

    .cover__cta:hover,
    .cover__cta:focus-visible {
      color: var(--color-accent);
    }
  }

  /* Tablet vertical: four-quadrant letter, more air */
  @media (min-width: 768px) {
    .cover {
      padding: 9svh 8vw 8svh;
    }

    .cover__elephant {
      width: 46vw;
      left: -6vw;
      bottom: -6svh;
    }

    .cover__duck {
      width: 40vw;
      right: 1vw;
      top: 2svh;
    }

    .cover__intro {
      max-width: 60vw;
    }

    .cover__lede {
      max-width: 32ch;
    }

    .cover__title {
      font-size: clamp(2.6rem, 6vw, 3.4rem);
    }
  }

  /* Tablet horizontal / small desktop */
  @media (min-width: 1024px) {
    .cover {
      padding: 8svh 8vw;
    }

    .cover__elephant {
      width: 32vw;
      left: -8vw;
      bottom: -11svh;
    }

    .cover__duck {
      width: 25vw;
      right: 0;
      top: 2svh;
    }

    .cover__intro {
      max-width: 34vw;
    }

    .cover__lede {
      max-width: 34ch;
    }

    .cover__title {
      font-size: clamp(2.7rem, 4.5vw, 3.4rem);
    }
  }

  /* Desktop */
  @media (min-width: 1280px) {
    .cover {
      padding: 7svh 6vw;
    }

    .cover__elephant {
      width: 36vw;
      left: -4vw;
      bottom: -19svh;
    }

    .cover__duck {
      width: 27vw;
      right: 2vw;
      top: 2svh;
    }

    .cover__intro {
      max-width: 32vw;
    }

    .cover__lede {
      max-width: 36ch;
    }

    .cover__title {
      font-size: clamp(3.4rem, 4vw, 4.4rem);
    }
  }

  /* Mobile horizontal (short viewport, overrides width-based rules above regardless of matched width) */
  @media (orientation: landscape) and (max-height: 500px) {
    .cover {
      padding: 5svh 6vw 4svh;
    }

    .cover__elephant {
      width: 32vw;
      left: -4vw;
      bottom: -65svh;
    }

    .cover__duck {
      width: 26vw;
      right: -3vw;
      top: -8svh;
    }

    .cover__intro {
      max-width: 46vw;
    }

    .cover__lede {
      max-width: 26ch;
      font-size: clamp(0.95rem, 2.6vw, 1.1rem);
    }

    .cover__title {
      font-size: clamp(1.6rem, 5vw, 2.15rem);
      margin-bottom: 0.75rem;
    }

    .cover__location {
      margin-bottom: 1.1rem;
    }
  }
</style>
