  /*
    Fixed logical canvas: the cover is a fixed artistic composition
    designed at exactly 390x844 -- it no longer redistributes internally
    per device. .cover-frame fills the real viewport and centers
    .cover-canvas, a constant 390x844 box holding the untouched 390x844
    composition below, uniformly scaled via --cover-scale (computed in the
    inline script above, before first paint) to fit any screen without
    cropping, deforming, or scrolling. Leftover space is letterboxed with
    the same paper texture as the canvas itself (background-image set
    inline above), scaled with the same object-position/size the canvas
    texture uses, so the exterior reads as more paper -- not a flat-color
    frame around it. --color-bg stays as the fallback while it loads.
  */
  .cover-frame {
    width: 100%;
    height: 100svh;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-bg);
    background-size: cover;
    background-repeat: no-repeat;
    background-position: 60% top;
  }

  /* @supports keeps this from being minified away as a "duplicate" of the
     100svh fallback above -- browsers without dvh support correctly keep
     using svh instead of losing the height declaration entirely. */
  @supports (height: 100dvh) {
    .cover-frame {
      height: 100dvh;
    }
  }

  .cover-canvas {
    width: 390px;
    height: 844px;
    flex-shrink: 0;
    transform-origin: center center;
    /* Falls back to scale(1) with no JS: still fully visible and
       centered, just not scale-corrected (cropped by .cover-frame's
       overflow:hidden on very small screens instead of blank). */
    transform: scale(var(--cover-scale, 1));
  }

  /*
    Below this point the composition is frozen at its approved 390x844
    pixel values (merged from the old base + "mobile portrait" rules,
    which is what actually rendered at 390 width). Per-device breakpoints
