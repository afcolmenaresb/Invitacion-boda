---
import {
  sceneStay,
  getStayTitle,
  getStayRsvpQuestion,
  getStayRsvpOptions,
  getStayRsvpConfirmations,
} from '../data/sceneStay';
import { getGoTravelWhatsAppUrl } from '../data/goTravelConfig';
import type { Guest } from '../data/guests';

interface Props {
  addressing?: Guest['addressing'];
  /** Guest.inviteId -- the RSVP document id. Empty on the guest-less demo (/) page. */
  guestId?: string;
  guestName?: string;
  partySize?: number;
  /**
   * Lets a second entry point (the page-3 "VER INFORMACIÓN DEL VIAJE"
   * shortcut in InvitationExperience.astro) reuse this same component with
   * a different back destination, instead of duplicating its markup --
   * defaults match the normal page-9 flow (back to KeepsakeScene)
   * unchanged.
   */
  backAction?: string;
  backLabel?: string;
  backVisibleLabel?: string;
}

// 'plural' is the safer neutral default if this were ever rendered without
// a guest context -- in practice InvitationExperience always passes the
// real guest.addressing through (same convention as every previous scene).
const {
  addressing = 'plural',
  guestId = '',
  guestName = '',
  partySize = 1,
  backAction = 'back-to-keepsake',
  backLabel = sceneStay.backLabel,
  backVisibleLabel = sceneStay.backVisibleLabel,
} = Astro.props;

const title = getStayTitle(addressing);
const rsvpQuestion = getStayRsvpQuestion(addressing);
const rsvpOptions = getStayRsvpOptions(addressing);
const rsvpConfirmations = getStayRsvpConfirmations(addressing);
const whatsAppUrl = getGoTravelWhatsAppUrl(guestName || 'invitado');
---

<div class="stay" data-scene-panel-content aria-label={sceneStay.eyebrow}>
  <span class="stay__wash" aria-hidden="true"></span>
  <button type="button" class="stay__back" data-action={backAction} aria-label={backLabel}>
    <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
      <path d="M15 5 L8 12 L15 19" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
    <span>{backVisibleLabel}</span>
  </button>

  <div class="stay__content">
    <p class="stay__eyebrow" data-stay-part="eyebrow">
      <span class="stay__halo" aria-hidden="true"></span>
      {sceneStay.eyebrow}
    </p>
    <h2 class="stay__title" data-scene-heading data-stay-part="title" tabindex="-1">
      <span class="stay__halo stay__halo--wide" aria-hidden="true"></span>
      {title}
    </h2>
    <div class="stay__body" data-stay-part="body">
      <span class="stay__halo stay__halo--wide" aria-hidden="true"></span>
      {sceneStay.body.map((line) => (
        <p>{line}</p>
      ))}
    </div>

    <ul class="stay__highlights" data-stay-part="highlights" aria-label="Highlights">
      {sceneStay.highlights.map((item) => (
        <li>{item}</li>
      ))}
    </ul>

    <div
      class="stay__rsvp"
      data-stay-part="rsvp"
      data-guest-id={guestId}
      data-guest-name={guestName}
      data-party-size={partySize}
    >
      <span class="stay__halo stay__halo--wide" aria-hidden="true"></span>
      <p class="stay__rsvp-question">{rsvpQuestion}</p>
      <div class="stay__rsvp-options" role="group" aria-label={rsvpQuestion}>
        <button type="button" class="stay__rsvp-option" data-rsvp-status="attending">
          {rsvpOptions.attending}
        </button>
        <button type="button" class="stay__rsvp-option" data-rsvp-status="maybe">
          {rsvpOptions.maybe}
        </button>
        <button type="button" class="stay__rsvp-option" data-rsvp-status="not_attending">
          {rsvpOptions.not_attending}
        </button>
      </div>
      <p class="stay__rsvp-feedback" data-rsvp-feedback aria-live="polite">
        <span data-rsvp-message="saving" hidden>Guardando tu respuesta…</span>
        <span data-rsvp-message="attending" hidden>{rsvpConfirmations.attending}</span>
        <span data-rsvp-message="maybe" hidden>{rsvpConfirmations.maybe}</span>
        <span data-rsvp-message="not_attending" hidden>{rsvpConfirmations.not_attending}</span>
        <span data-rsvp-message="error" hidden>{sceneStay.rsvpError}</span>
      </p>
    </div>

    <a
      class="stay__cta"
      data-stay-part="cta"
      href={whatsAppUrl}
      target="_blank"
      rel="noopener noreferrer"
    >
      {sceneStay.ctaGoTravel}
    </a>
  </div>
</div>

<script>
  import { getRsvpResponse, saveRsvpResponse, type AttendanceStatus, type SavedRsvpResponse } from '../lib/rsvp';

  // This scene is rendered twice per page (the main page-9 stay panel and
  // the page-3 "VER INFORMACIÓN DEL VIAJE" shortcut, see
  // InvitationExperience.astro) with the same guestId -- shared across
  // both .stay__rsvp instances below so a restore never fires the same
  // Firestore read twice for one page load.
  const restoreByGuestId = new Map<string, Promise<SavedRsvpResponse | null>>();

  // Both instances represent the *same* guest's one RSVP answer, so a
  // fresh save made in either one (or a restore resolving in either one)
  // needs to reach the other too -- otherwise saving in the page-9 panel
  // and then opening the page-3 shortcut in the same visit would still
  // show that panel's own stale/unselected state. Each instance below
  // registers a listener here; onGuestRsvpChanged notifies every
  // registered instance for that guestId, itself included.
  const rsvpListenersByGuestId = new Map<string, Array<(saved: SavedRsvpResponse) => void>>();

  function onGuestRsvpChanged(guestId: string, saved: SavedRsvpResponse) {
    for (const listener of rsvpListenersByGuestId.get(guestId) ?? []) listener(saved);
  }

  // The single source of truth for "what scene is showing right now" is
  // InvitationExperience.astro's own root, via data-scene -- this file
  // never imports/depends on that component's internals, it only reads
  // this one already-public attribute (see InvitationExperience.astro's
  // markup: `<div class="experience" data-scene="...">`).
  const experienceRoot = document.querySelector<HTMLElement>('.experience');

  // Runs once per page load, same as every other lightweight client
  // script in this project (see Cover.astro) -- .stay__rsvp only exists
  // once per page, but this is written to be safe if that ever changes.
  document.querySelectorAll<HTMLElement>('.stay__rsvp').forEach((rsvpEl) => {
    const guestId = rsvpEl.dataset.guestId ?? '';
    const guestName = rsvpEl.dataset.guestName ?? '';
    const partySize = Number(rsvpEl.dataset.partySize) || 1;
    // 'stay' (page 9) or 'travelInfo' (page-3 shortcut) -- whichever
    // <section data-scene-panel="..."> this RSVP block actually lives
    // in, read off the DOM rather than duplicated/hardcoded per
    // instance, so both entry points restore identically.
    const panelName = rsvpEl.closest<HTMLElement>('[data-scene-panel]')?.dataset.scenePanel ?? '';

    console.log('[RSVP RESTORE] enter StayScene', { panel: panelName });
    console.log('[RSVP RESTORE] inviteId:', guestId || '(none)');

    const feedback = rsvpEl.querySelector<HTMLElement>('[data-rsvp-feedback]');
    const messages = feedback ? Array.from(feedback.querySelectorAll<HTMLElement>('[data-rsvp-message]')) : [];
    const buttons = Array.from(rsvpEl.querySelectorAll<HTMLButtonElement>('.stay__rsvp-option'));

    function showMessage(key: string) {
      if (!feedback) return;
      messages.forEach((el) => {
        el.hidden = el.dataset.rsvpMessage !== key;
      });
      feedback.classList.add('is-visible');
    }

    // True the instant the guest interacts with this RSVP block --
    // guards the restore below from clobbering a fresh in-flight
    // selection if it resolves after the guest already started
    // answering again (see spec: never overwrite a new interaction).
    let userInteracted = false;
    // Set once the Firestore read resolves, so a later re-entry into
    // this same scene (see the MutationObserver below -- "reentrada"
    // never needs a second read) can re-apply it without refetching.
    let savedResponse: SavedRsvpResponse | null = null;

    // The one place that actually toggles .is-selected from a restored
    // (as opposed to freshly clicked) response -- called on first load
    // once the read resolves, and again every time the guest navigates
    // back into this panel. Never runs after the guest has interacted
    // (see spec: a fresh in-flight selection always wins).
    function applySavedResponse(reason: string) {
      if (!savedResponse) {
        console.log('[RSVP RESTORE] reset called: nothing saved to apply', { panel: panelName, reason });
        return;
      }
      if (userInteracted) {
        console.log('[RSVP RESTORE] reset called: user already interacted, skipping restore', {
          panel: panelName,
          reason,
        });
        return;
      }
      console.log('[RSVP RESTORE] applying status:', savedResponse.attendanceStatus, { panel: panelName, reason });
      const match = buttons.find((b) => b.dataset.rsvpStatus === savedResponse!.attendanceStatus);
      if (!match) return;
      buttons.forEach((b) => b.classList.toggle('is-selected', b === match));
      showMessage(savedResponse.attendanceStatus);
      console.log(
        '[RSVP RESTORE] selected after apply:',
        buttons.find((b) => b.classList.contains('is-selected'))?.dataset.rsvpStatus ?? '(none)'
      );
    }

    // Registers this instance so a fresh save (from itself or its sibling
    // instance for the same guestId) and a resolved restore both flow
    // through the exact same "apply" path below -- one behavior, not two.
    if (guestId) {
      const listeners = rsvpListenersByGuestId.get(guestId) ?? [];
      listeners.push((saved) => {
        savedResponse = saved;
        userInteracted = false;
        applySavedResponse('sync');
      });
      rsvpListenersByGuestId.set(guestId, listeners);
    }

    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        userInteracted = true;
        const status = button.dataset.rsvpStatus as AttendanceStatus | undefined;
        if (!status) return;

        // Selecting again later (see spec: "permitir modificarla
        // después") just re-runs this same handler -- nothing here ever
        // disables the buttons or navigates away.
        buttons.forEach((b) => b.classList.toggle('is-selected', b === button));
        showMessage('saving');

        void saveRsvpResponse({ guestId, guestName, attendanceStatus: status, partySize }).then((ok) => {
          showMessage(ok ? status : 'error');
          // A fresh save is now the current truth for this guest's RSVP,
          // in every instance of this scene on the page (see
          // onGuestRsvpChanged above), not just the one just clicked.
          if (ok && guestId) onGuestRsvpChanged(guestId, { attendanceStatus: status, partySize });
        });
      });
    });

    // Silent restore: no spinner, no gating of the scene's own reveal
    // animation (this fires alongside it, never before/blocking it). If
    // the guest already tapped an option by the time this resolves,
    // their fresh interaction wins and this is dropped on the floor.
    if (guestId) {
      let restore = restoreByGuestId.get(guestId);
      if (!restore) {
        restore = getRsvpResponse(guestId);
        restoreByGuestId.set(guestId, restore);
      }
      restore
        .then((saved) => {
          console.log('[RSVP RESTORE] firestore result:', saved, { panel: panelName });
          savedResponse = saved;
          applySavedResponse('initial-load');
        })
        .catch((error) => {
          // getRsvpResponse itself never rejects -- this is belt-and-
          // suspenders only, matching the rest of this file's philosophy
          // of never letting the RSVP feature break the page.
          console.error('[rsvp] restoring previous response failed:', error);
        });
    }

    // Reentrada: the experience never reloads/recreates this component
    // when the guest leaves and comes back to page 9 (or the page-3
    // shortcut) within the same visit -- it's the same static DOM the
    // whole time (see InvitationExperience.astro, no scene panel is ever
    // re-rendered/cloned). So the only thing that could make a restored
    // answer "disappear" on re-entry is nothing re-applying it -- this
    // reapplies it every time data-scene switches (back) to this panel,
    // covering "entra, sale, vuelve a entrar" without a second Firestore
    // read (savedResponse is already known by then).
    if (panelName && experienceRoot) {
      const observer = new MutationObserver(() => {
        if (experienceRoot.dataset.scene === panelName) {
          applySavedResponse('scene-enter:' + panelName);
        }
      });
      observer.observe(experienceRoot, { attributes: true, attributeFilter: ['data-scene'] });
    }
  });
</script>

<style>
  .stay {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    isolation: isolate;
  }

  /* Same control as every previous scene's own back button -- identical
     position, type treatment and icon, just pointing one scene back. */
  .stay__back {
    position: absolute;
    top: max(18px, env(safe-area-inset-top));
    left: max(18px, env(safe-area-inset-left));
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: none;
    border: none;
    padding: 0.4rem 0.2rem;
    cursor: pointer;
    font-family: var(--font-sans);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #3a332b;
    opacity: 0;
  }

  .stay__back::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: -6px -10px;
    pointer-events: none;
    background: radial-gradient(ellipse at center, rgba(255, 254, 248, 0.95), rgba(255, 254, 248, 0) 80%);
  }

  :global(.experience.is-revealing-stay) .stay__back,
  :global(.experience.is-travel-info-revealing) .stay__back {
    opacity: 1;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.experience:not(.is-instant)) .stay__back {
      transition: opacity 320ms ease, color 0.2s ease, transform 0.2s ease;
    }

    .stay__back:hover,
    .stay__back:focus-visible {
      color: var(--color-accent);
      transform: translateX(-2px);
    }
  }

  :global(.experience.is-instant) .stay__back {
    transition: none !important;
  }

  /*
    Same fixed 390x844 canvas convention as every other scene. Content
    sits low, over the photo's own quieter lower register, sitting inside
    .stay__wash's own quiet reading column below.
  */
  .stay__content {
    position: relative;
    margin-top: auto;
    width: 100%;
    max-width: 358.8px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    padding: 0 28px 96px;
  }

  /*
    Reading column -- same wide, soft "wash" of warm ivory light as
    JourneyScene/ImaginedDaysScene/CeremonyScene/CelebrationScene/
    KeepsakeScene's own .X__wash, but sized wider/taller than their shared
    recipe: this scene's own content block (eyebrow through the RSVP
    options) is taller and reaches further right than any previous scene's,
    so the wash's spatial reach is widened to actually sit behind all of
    it -- peak opacity values are intentionally unchanged from the shared
    recipe (still 0.26/0.55 at their strongest), only the area they cover
    is larger, per spec ("ampliar el área antes que hacerla más blanca").
  */
  .stay__wash {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse 82% 62% at 32% 60%, rgba(255, 251, 244, 0.26) 0%, rgba(255, 251, 244, 0) 80%),
      linear-gradient(
        to right,
        rgba(255, 251, 244, 0.55) 0%,
        rgba(255, 251, 244, 0.4) 42%,
        rgba(255, 251, 244, 0.2) 70%,
        rgba(255, 251, 244, 0) 98%
      );
    -webkit-mask-image: linear-gradient(
      to bottom,
      transparent 0%,
      rgba(0, 0, 0, 0.55) 14%,
      rgba(0, 0, 0, 1) 26%,
      rgba(0, 0, 0, 1) 100%
    );
    mask-image: linear-gradient(
      to bottom,
      transparent 0%,
      rgba(0, 0, 0, 0.55) 14%,
      rgba(0, 0, 0, 1) 26%,
      rgba(0, 0, 0, 1) 100%
    );
  }

  /*
    Same halo language already approved on pages 2-8: a soft, local
    opening of ivory light behind text, never a card/pill (no
    border-radius, no solid fill, no visible edge).
  */
  .stay__halo {
    position: absolute;
    z-index: -1;
    pointer-events: none;
    inset: -10px -18px;
    background: radial-gradient(ellipse at center, rgba(255, 254, 248, 0.9) 0%, rgba(255, 254, 248, 0) 72%);
  }

  .stay__halo--wide {
    inset: -14px -24px;
  }

  .stay__eyebrow {
    position: relative;
    margin: 0 0 18px;
    font-family: var(--font-sans);
    text-transform: uppercase;
    letter-spacing: 0.22em;
    font-size: 0.68rem;
    color: #6f6350;
  }

  .stay__title {
    position: relative;
    margin: 0 0 22px;
    font-family: var(--font-serif);
    font-style: normal;
    font-weight: 400;
    font-size: 1.7rem;
    line-height: 1.32;
    color: #4a3a28;
  }

  .stay__body {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .stay__body p {
    margin: 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    font-size: 1.08rem;
    line-height: 1.5;
    color: #241a12;
  }

  /*
    Highlights -- "sin cajas pesadas": plain uppercase labels in a row,
    separated by a thin middot, never pills/chips with a background or
    border. Wraps naturally on narrow screens.
  */
  .stay__highlights {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5em;
    margin: 20px 0 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-sans);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #4a3a28;
  }

  .stay__highlights li {
    position: relative;
  }

  .stay__highlights li + li::before {
    content: '·';
    margin-right: 0.5em;
    color: #8c7f6a;
  }

  /*
    GoTravel CTA -- real <a> (opens WhatsApp in a new tab), same editorial
    sans/uppercase/arrow language as every other primary CTA in the
    experience. No individual halo/patch behind it -- reads off
    .stay__wash above plus its own dark, high-contrast ink. Sits after the
    RSVP block (see the markup's own order/comment on .stay__rsvp below).
  */
  .stay__cta {
    position: relative;
    display: inline-block;
    margin: 34px 0 0;
    font-family: var(--font-sans);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-size: 0.92rem;
    color: #221a10;
    text-decoration: none;
  }

  .stay__cta::after {
    content: ' →';
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.experience:not(.is-instant)) .stay__cta {
      transition: color 0.2s ease;
    }

    .stay__cta:hover,
    .stay__cta:focus-visible {
      color: var(--color-accent);
    }
  }

  /*
    RSVP block -- comes before the GoTravel CTA below (the invitation's
    own "can you make it?" question takes priority over the logistics
    CTA -- see the markup's own order), "separado visualmente" from the
    highlights above it via extra margin, its own halo and a
    hairline-free visual pause; never a modal, never a hard card.
  */
  .stay__rsvp {
    position: relative;
    margin: 40px 0 0;
    width: 100%;
  }

  .stay__rsvp-question {
    margin: 0 0 12px;
    font-family: var(--font-serif);
    font-style: normal;
    font-weight: 400;
    font-size: 1.05rem;
    line-height: 1.4;
    color: #241a12;
  }

  .stay__rsvp-options {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
  }

  /*
    Each option reads as a clear, tappable control -- underline + arrow,
    same family as every other CTA -- without becoming a heavy button
    (no fill, no border, no shadow). .is-selected marks the guest's
    current choice once they've picked one.
  */
  .stay__rsvp-option {
    position: relative;
    display: inline-block;
    background: none;
    border: none;
    padding: 0.2rem 0;
    margin: 0;
    cursor: pointer;
    font-family: var(--font-sans);
    font-size: 0.85rem;
    letter-spacing: 0.04em;
    color: #4a3a28;
    text-decoration: underline;
    text-decoration-color: rgba(74, 58, 40, 0.35);
    text-underline-offset: 3px;
  }

  .stay__rsvp-option::before {
    content: '○ ';
  }

  .stay__rsvp-option.is-selected {
    color: #221a10;
    font-weight: 600;
    text-decoration-color: currentColor;
  }

  .stay__rsvp-option.is-selected::before {
    content: '● ';
  }

  @media (prefers-reduced-motion: no-preference) {
    .stay__rsvp-option {
      transition: color 0.2s ease;
    }

    .stay__rsvp-option:hover,
    .stay__rsvp-option:focus-visible {
      color: var(--color-accent);
    }
  }

  .stay__rsvp-feedback {
    margin: 14px 0 0;
    min-height: 1.4em;
    font-family: var(--font-sans);
    font-size: 0.78rem;
    font-style: italic;
    line-height: 1.5;
    color: #4a3a28;
    opacity: 0;
  }

  .stay__rsvp-feedback.is-visible {
    opacity: 1;
  }

  @media (prefers-reduced-motion: no-preference) {
    .stay__rsvp-feedback {
      transition: opacity 260ms ease;
    }
  }

  /*
    Entrance: plain, quiet opacity + small translateY -- never the
    handwritten ink sweep MemoryScene uses. Hidden by default; each part
    becomes visible once InvitationExperience.astro's script adds
    is-stay-revealing to the shared .experience root -- the moment the
    stay panel itself starts crossfading in, since there is no video to
    key this scene's entrance against (see the script's own stay branch
    in goToScene). Highlights/cta/rsvp settle quickly after the text
    above so the whole scene feels ready almost immediately -- this page
    is meant to be read and acted on, not watched.
  */
  [data-stay-part] {
    opacity: 0;
    transform: translateY(10px);
  }

  /* CTA and RSVP specifically: not interactive/focusable until actually
     shown -- opacity:0 alone doesn't stop pointer-events or Tab from
     reaching them (rsvp's own visibility:hidden also covers its three
     nested option buttons, since none of them override it back). */
  [data-stay-part='cta'],
  [data-stay-part='rsvp'] {
    visibility: hidden;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.experience.is-stay-revealing) [data-stay-part] {
      transition: opacity 900ms ease, transform 900ms ease;
    }

    :global(.experience.is-stay-revealing) [data-stay-part='eyebrow'] {
      opacity: 1;
      transform: translateY(0);
      transition-delay: 200ms;
    }

    :global(.experience.is-stay-revealing) [data-stay-part='title'] {
      opacity: 1;
      transform: translateY(0);
      transition-delay: 500ms;
    }

    :global(.experience.is-stay-revealing) [data-stay-part='body'] {
      opacity: 1;
      transform: translateY(0);
      transition-delay: 900ms;
    }

    :global(.experience.is-stay-revealing) [data-stay-part='highlights'] {
      opacity: 1;
      transform: translateY(0);
      transition-delay: 1300ms;
    }

    :global(.experience.is-stay-revealing) [data-stay-part='rsvp'] {
      opacity: 1;
      transform: translateY(0);
      visibility: visible;
      pointer-events: auto;
      transition: opacity 900ms ease, transform 900ms ease, visibility 0s linear;
      transition-delay: 1600ms;
    }

    :global(.experience.is-stay-revealing) [data-stay-part='cta'] {
      opacity: 1;
      transform: translateY(0);
      visibility: visible;
      pointer-events: auto;
      transition: opacity 900ms ease, transform 900ms ease, visibility 0s linear;
      transition-delay: 1900ms;
    }
  }

  /*
    Reduced motion / instant loads: no per-part stagger, no delays -- one
    short, uniform fade so the whole scene settles as a single quiet
    crossfade, same convention as every previous scene's own reduced-
    motion path.
  */
