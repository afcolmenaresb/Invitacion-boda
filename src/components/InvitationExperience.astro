  .experience__scene--destination {
    z-index: 0;
    opacity: 0;
    pointer-events: none;
  }

  .experience[data-scene='destination'] .experience__scene--destination {
    pointer-events: auto;
  }

  .experience[data-scene='destination'] .experience__scene--cover,
  .experience[data-scene='destination'] .experience__scene--memory {
    pointer-events: none;
