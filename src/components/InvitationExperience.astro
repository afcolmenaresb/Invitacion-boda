    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) scale(var(--cover-scale-x, 1), var(--cover-scale-y, 1));
  }

  .experience__destination-image {
    position: absolute;
    inset: 0;
    background-color: var(--color-bg);
