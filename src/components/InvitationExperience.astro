  */
  .experience__journey-veil {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: rgba(255, 254, 248, 0.09);
  }

  .experience__journey-overlay {
    position: absolute;
    inset: 0;
  }

  /*
    Imagined-days scene (page 5) -- additive only, same convention as the
    journey block above, one level deeper: sits below journey in the
    stacking order (z-index -2, journey -1, destination 0, memory 1, cover
