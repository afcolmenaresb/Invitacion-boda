  .experience[data-scene='destination']:not(.is-transitioning) .experience__scene--cover,
  .experience[data-scene='destination']:not(.is-transitioning) .experience__scene--memory {
    visibility: hidden;
  }

  .experience.is-transitioning :global(.memory__cta),
  .experience.is-transitioning :global([data-action='back-to-memory']) {
    pointer-events: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .experience:not(.is-instant) .experience__scene--destination {
