---
import Cover from './Cover.astro';
import MemoryScene from './MemoryScene.astro';

interface Props {
  displayName?: string;
  dedication?: string;
}

const { displayName, dedication } = Astro.props;
---

<div class="experience" id="invitation-experience" data-scene="cover" data-transition-direction="forward">
  <section class="experience__scene experience__scene--cover" data-scene-panel="cover">
    <Cover displayName={displayName} dedication={dedication} />
  </section>

  <section class="experience__scene experience__scene--memory" data-scene-panel="memory" inert>
    <MemoryScene />
  </section>

  <!--
    One shared ink layer, mounted with the exact same 390x844 logical
    canvas and the same --cover-scale / --cover-scale-x/-y transform
    Cover.astro's own .cover-canvas uses (see the matching CSS below) --
    never a second, viewport-relative coordinate system. Each path's `d`
    is a real traced line lifted from duck.png/elephant.png (verified
    against the source art before commit, see the commit message for the
    calibration method) -- at rest every path sits pixel-for-pixel over
    its matching stroke on the animal. Nothing here is drawn on;
    everything is a rigid transform (translate/rotate/scale) of that same
    unchanged shape, driven by the per-path CSS custom properties set in
    the script below.
  -->
  <div class="ink-stage" aria-hidden="true">
    <svg class="experience__ink" viewBox="0 0 390 844" focusable="false">
      <path
        class="experience__ink-stroke experience__ink-stroke--d1"
        data-stroke="d1"
        d="M 333.98 20.80 C 331.68 21.20 324.19 21.95 320.17 23.22 C 316.14 24.48 313.26 26.09 309.81 28.40 C 306.35 30.70 302.61 33.86 299.45 37.03 C 296.28 40.19 293.40 44.22 290.81 47.39 C 288.22 50.55 285.63 53.14 283.91 56.02 C 282.18 58.90 280.45 61.78 280.45 64.65 C 280.45 67.53 282.18 70.70 283.91 73.29 C 285.63 75.88 288.22 78.18 290.81 80.19 C 293.40 82.21 296.57 82.78 299.45 85.37 C 302.32 87.96 305.78 91.99 308.08 95.73 C 310.38 99.47 311.82 103.79 313.26 107.82 C 314.70 111.85 315.85 115.88 316.71 119.90 C 317.58 123.93 318.15 127.96 318.44 131.99 C 318.73 136.02 318.73 139.76 318.44 144.08 C 318.15 148.39 317.58 153.00 316.71 157.89 C 315.85 162.78 314.41 168.25 313.26 173.43 C 312.11 178.61 311.25 184.07 309.81 188.97 C 308.37 193.86 306.64 198.46 304.63 202.78 C 302.61 207.10 300.02 211.12 297.72 214.86 C 295.42 218.61 291.97 223.50 290.81 225.22"
      />
      <path
        class="experience__ink-stroke experience__ink-stroke--d2"
        data-stroke="d2"
        d="M 295.99 206.23 C 294.55 209.40 290.53 219.18 287.36 225.22 C 284.20 231.27 280.74 236.73 277.00 242.49 C 273.26 248.25 269.23 254.58 264.92 259.76 C 260.60 264.94 256.28 269.54 251.10 273.57 C 245.92 277.60 239.02 281.05 233.84 283.93 C 228.66 286.81 223.94 289.11 220.03 290.83 C 216.11 292.56 211.97 293.71 210.36 294.29"
      />
      <path
        class="experience__ink-stroke experience__ink-stroke--e1"
        data-stroke="e1"
        d="M 90.10 534.36 C 90.53 536.84 91.87 544.28 92.65 549.24 C 93.43 554.20 94.28 559.16 94.78 564.12 C 95.28 569.08 95.52 574.39 95.63 579.00 C 95.74 583.60 95.63 587.50 95.42 591.75 C 95.20 596.00 94.74 600.78 94.35 604.50 C 93.96 608.22 93.01 611.23 93.08 614.06 C 93.15 616.90 94.32 619.38 94.78 621.50 C 95.24 623.63 96.02 625.47 95.84 626.82 C 95.67 628.16 94.07 629.12 93.72 629.58"
      />
      <path
        class="experience__ink-stroke experience__ink-stroke--e2"
        data-stroke="e2"
        d="M 200.62 493.56 C 197.15 492.57 186.81 488.60 179.79 487.61 C 172.78 486.61 165.27 486.37 158.54 487.61 C 151.81 488.85 145.08 492.49 139.41 495.04 C 133.74 497.60 129.14 500.25 124.53 502.91 C 119.93 505.57 115.68 508.40 111.78 510.98 C 107.89 513.57 104.34 516.12 101.16 518.42 C 97.97 520.73 95.31 522.92 92.65 524.80 C 90.00 526.68 87.16 528.34 85.22 529.69 C 83.27 531.03 81.67 532.34 80.96 532.88"
      />
    </svg>
  </div>
</div>

<script>
  // --- Scene architecture: Cover <-> MemoryScene, hash-routed, no vertical scroll ---
  //
  // Two absolutely-positioned full-screen panels inside a fixed container;
  // exactly one is interactive/visible at a time. Cover.astro's own
  // approved intro animation is never touched -- this only listens for
  // clicks on its existing .cover__cta (event delegation, no changes to
  // Cover's internal script) and toggles CSS classes/custom properties on
  // this wrapper and on the four ink strokes.
  //
  // The four strokes are real lines traced from duck.png/elephant.png
  // (see the calibration note on .ink-stage above). Each one is a single,
  // unmodified <path> that starts perfectly aligned with its source
  // stroke and is only ever moved with a rigid transform (translate +
  // rotate + scale around its own traced center) -- never redrawn,
  // dash-animated, or morphed into a different shape. STROKES below is
  // the one place that choreography lives; the CSS only ever reads the
  // per-path custom properties it sets.
  interface StrokeConfig {
    id: string;
    originX: number;
    originY: number;
    liftX: number;
    liftY: number;
    liftRot: number;
    finalX: number;
    finalY: number;
    finalRot: number;
    finalScale: number;
    staggerMs: number;
  }

  const STROKES: StrokeConfig[] = [
    // D1 -- duck head/beak/neck: the protagonist top curve. Starts
    // upright over the duck's face; lands as a wide, shallow arc across
    // the top of the memory scene (rotated onto its side + enlarged).
    { id: 'd1', originX: 307.2, originY: 123.0, liftX: -5, liftY: -6, liftRot: -4, finalX: -112, finalY: -30, finalRot: -88, finalScale: 1.22, staggerMs: 0 },
    // D2 -- duck wing edge: short secondary gesture parked in the
    // margin above-right of the title (between D1's landing spot and
    // the title's own top edge) -- shrunk well below its traced size so
    // it reads as a small accent, clear of both the title and the body
    // copy at every canvas scale.
    { id: 'd2', originX: 253.2, originY: 250.3, liftX: 6, liftY: -4, liftRot: 6, finalX: 87, finalY: -50, finalRot: 15, finalScale: 0.5, staggerMs: 150 },
    // E1 -- elephant trunk edge: the protagonist bottom curve, rotated
    // from its native near-vertical line into a sweep that guides the
    // eye toward the CTA (never a straight underline).
    { id: 'e1', originX: 93.0, originY: 582.0, liftX: -6, liftY: 5, liftRot: -5, finalX: 138, finalY: 116, finalRot: 68, finalScale: 1.35, staggerMs: 0 },
    // E2 -- elephant ear curve: lateral counterweight, kept away from
    // D1/E1's zones so it never competes with either protagonist.
    { id: 'e2', originX: 140.8, originY: 510.2, liftX: 6, liftY: -5, liftRot: 5, finalX: -68, finalY: 268, finalRot: -16, finalScale: 1.08, staggerMs: 150 },
  ];

  const root = document.getElementById('invitation-experience');
  if (root) {
    const coverPanel = root.querySelector<HTMLElement>('[data-scene-panel="cover"]');
    const memoryPanel = root.querySelector<HTMLElement>('[data-scene-panel="memory"]');
    const strokeEls = new Map<string, SVGPathElement>();
    STROKES.forEach((cfg) => {
      const el = root.querySelector<SVGPathElement>(`[data-stroke="${cfg.id}"]`);
      if (el) {
        strokeEls.set(cfg.id, el);
        el.style.setProperty('--origin-x', `${cfg.originX}px`);
        el.style.setProperty('--origin-y', `${cfg.originY}px`);
      }
    });

    // Forward (cover -> memory) phase timings -- mirrored in this file's
    // <style> block as transition-duration/-delay; keep both in sync by
    // hand when adjusting the choreography (same convention Cover.astro
    // itself uses for its own timing constants).
    const PHASE1_EXIT_MS = 420; // content fades, animals stay whole
    const PHASE2_SEPARATE_MS = 550; // PNGs fade, strokes lift off
    const PHASE3_TRAVEL_MS = 1300; // strokes travel to their final spot
    const PHASE4_SETTLE_MS = 700; // memory scene text settles in
    const FORWARD_DURATION = PHASE1_EXIT_MS + PHASE2_SEPARATE_MS + PHASE3_TRAVEL_MS + PHASE4_SETTLE_MS; // 2970ms
    const BACKWARD_DURATION = 950;
    const REDUCED_MOTION_DURATION = 280;

    let isTransitioning = false;
    let currentScene: 'cover' | 'memory' = 'cover';
    let pendingTimers: number[] = [];

    function clearPendingTimers() {
      pendingTimers.forEach((t) => window.clearTimeout(t));
      pendingTimers = [];
    }

    function prefersReducedMotion() {
      return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    }

    function setStrokeVars(id: string, tx: number, ty: number, rot: number, scale: number) {
      const el = strokeEls.get(id);
      if (!el) return;
      el.style.setProperty('--tx', `${tx}px`);
      el.style.setProperty('--ty', `${ty}px`);
      el.style.setProperty('--rot', `${rot}deg`);
      el.style.setProperty('--scl', `${scale}`);
    }

    function resetStrokesToOrigin() {
      STROKES.forEach((cfg) => setStrokeVars(cfg.id, 0, 0, 0, 1));
    }

    function setStrokesFinalInstant() {
      STROKES.forEach((cfg) => setStrokeVars(cfg.id, cfg.finalX, cfg.finalY, cfg.finalRot, cfg.finalScale));
    }

    // Phase 2: small liftoff, a few px, never a jump -- staggered per
    // path (D1/E1 first, D2/E2 100-200ms later).
    function runLiftoff() {
      STROKES.forEach((cfg) => {
        const el = strokeEls.get(cfg.id);
        if (!el) return;
        el.style.setProperty('--stroke-duration', `${PHASE2_SEPARATE_MS}ms`);
        el.style.setProperty('--stroke-delay', `${cfg.staggerMs}ms`);
        setStrokeVars(cfg.id, cfg.liftX, cfg.liftY, cfg.liftRot, 1.02);
      });
    }

    // Phase 3: the real journey -- translate/rotate/scale the whole
    // (unmodified) path from its lifted position to its final resting
    // transform in the memory scene's composition.
    function runTravel() {
      STROKES.forEach((cfg) => {
        const el = strokeEls.get(cfg.id);
        if (!el) return;
        el.style.setProperty('--stroke-duration', `${PHASE3_TRAVEL_MS}ms`);
        el.style.setProperty('--stroke-delay', `${cfg.staggerMs}ms`);
        setStrokeVars(cfg.id, cfg.finalX, cfg.finalY, cfg.finalRot, cfg.finalScale);
      });
    }

    // Reverse: strokes return to sit exactly back over the animals.
    function runReturn() {
      STROKES.forEach((cfg) => {
        const el = strokeEls.get(cfg.id);
        if (!el) return;
        el.style.setProperty('--stroke-duration', `${BACKWARD_DURATION}ms`);
        el.style.setProperty('--stroke-delay', '0ms');
        setStrokeVars(cfg.id, 0, 0, 0, 1);
      });
    }

    function setSceneAccessibility(scene: 'cover' | 'memory') {
      const showingMemory = scene === 'memory';
      if (memoryPanel) memoryPanel.toggleAttribute('inert', !showingMemory);
      if (coverPanel) coverPanel.toggleAttribute('inert', showingMemory);
    }

    function focusSceneHeading(scene: 'cover' | 'memory') {
      const target =
        scene === 'memory'
          ? memoryPanel?.querySelector<HTMLElement>('[data-scene-heading]')
          : coverPanel?.querySelector<HTMLElement>('.cover__cta');
      target?.focus({ preventScroll: true });
    }

    function applySceneInstantly(scene: 'cover' | 'memory') {
      root!.classList.add('is-instant');
      root!.dataset.scene = scene;
      setSceneAccessibility(scene);
      if (scene === 'memory') {
        setStrokesFinalInstant();
      } else {
        resetStrokesToOrigin();
      }
      void root!.offsetWidth;
      requestAnimationFrame(() => {
        root?.classList.remove('is-instant');
      });
      currentScene = scene;
    }

    // Cover.astro's own intro reveal can still be mid-flight (it runs
    // ~18-23s) if the CTA is reached early -- e.g. a keyboard user
    // tabbing to it before the animals finish drawing in. While that
    // reveal is running it holds an *inline* transition/clip-path/mask on
    // the elephant/duck (see Cover.astro's triggerInkReveal), which -- an
    // inline style always beating a stylesheet rule -- would otherwise
    // silently swallow this file's own opacity fade for those elements.
    // Clearing that inline state up front (never touching Cover.astro's
    // file itself) means the separation-phase fade always runs on its own
    // declared transition, at the cost of an instant, one-time "linework
    // completes" snap in that rare early-click case -- far less jarring
    // than the opacity itself popping with no transition at all.
    function releaseCoverInkReveal() {
      coverPanel
        ?.querySelectorAll<HTMLElement>('[data-animation="elephant"], [data-animation="duck"]')
        .forEach((el) => {
          el.style.transition = '';
          el.style.clipPath = '';
          el.style.removeProperty('--reveal');
          el.style.removeProperty('mask-image');
          el.style.removeProperty('-webkit-mask-image');
        });
    }

    function goToScene(scene: 'cover' | 'memory', options: { pushHistory?: boolean } = {}) {
      const { pushHistory = true } = options;
      if (isTransitioning || scene === currentScene || !coverPanel || !memoryPanel) return;

      isTransitioning = true;
      clearPendingTimers();
      if (scene === 'memory') releaseCoverInkReveal();
      root!.classList.add('is-transitioning');
      root!.dataset.transitionDirection = scene === 'memory' ? 'forward' : 'back';

      const reduced = prefersReducedMotion();
      root!.classList.toggle('is-reduced-motion', reduced);

      root!.dataset.scene = scene;
      setSceneAccessibility(scene);

      if (pushHistory) {
        const hash = scene === 'memory' ? '#recuerdo' : '#portada';
        if (window.location.hash !== hash) history.pushState({ scene }, '', hash);
      }

      let duration: number;

      if (reduced) {
        duration = REDUCED_MOTION_DURATION;
        if (scene === 'memory') setStrokesFinalInstant();
        else resetStrokesToOrigin();
      } else if (scene === 'memory') {
        duration = FORWARD_DURATION;
        // Fixed-timeout orchestration (not transitionend) so a dropped
        // frame or an unsupported property never leaves the strokes
        // stuck mid-journey -- whatever happens visually, this always
        // reaches the safe final state within FORWARD_DURATION.
        pendingTimers.push(window.setTimeout(runLiftoff, PHASE1_EXIT_MS));
        pendingTimers.push(window.setTimeout(runTravel, PHASE1_EXIT_MS + PHASE2_SEPARATE_MS));
      } else {
        duration = BACKWARD_DURATION;
        runReturn();
      }

      pendingTimers.push(
        window.setTimeout(() => {
          currentScene = scene;
          isTransitioning = false;
          root!.classList.remove('is-transitioning');
          focusSceneHeading(scene);
        }, duration)
      );
    }

    document.addEventListener('click', (event) => {
      const target = event.target as HTMLElement;
      const forwardTrigger = target.closest<HTMLElement>('.cover__cta');
      const backTrigger = target.closest<HTMLElement>('[data-action="back-to-cover"]');

      if (forwardTrigger && root!.contains(forwardTrigger)) {
        event.preventDefault();
        goToScene('memory');
      } else if (backTrigger && root!.contains(backTrigger)) {
        event.preventDefault();
        goToScene('cover');
      }
    });

    window.addEventListener('popstate', () => {
      const scene = window.location.hash === '#recuerdo' ? 'memory' : 'cover';
      goToScene(scene, { pushHistory: false });
    });

    // Initial state from the URL: a direct link to #recuerdo shows the
    // memory scene immediately (no replayed animation -- the spec only
    // asks for the transition on user action), otherwise default to
    // #portada and make that canonical in the URL.
    const initialScene = window.location.hash === '#recuerdo' ? 'memory' : 'cover';
    applySceneInstantly(initialScene);
    if (window.location.hash !== '#recuerdo' && window.location.hash !== '#portada') {
      history.replaceState({ scene: initialScene }, '', '#portada');
    }
  }
</script>

<style>
  .experience {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100svh;
    overflow: hidden;
    background: var(--color-bg);
  }

  @supports (height: 100dvh) {
    .experience {
      height: 100dvh;
    }
  }

  .experience__scene {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .experience__scene--cover {
    z-index: 2;
  }

  .experience__scene--memory {
    z-index: 1;
    opacity: 0;
    pointer-events: none;
  }

  .experience[data-scene='memory'] .experience__scene--memory {
    pointer-events: auto;
  }

  .experience[data-scene='memory'] .experience__scene--cover {
    pointer-events: none;
  }

  .experience[data-scene='memory']:not(.is-transitioning) .experience__scene--cover {
    visibility: hidden;
  }

  .experience.is-transitioning :global(.cover__cta),
  .experience.is-transitioning :global([data-action='back-to-cover']) {
    pointer-events: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .experience:not(.is-instant) .experience__scene--cover {
      transition: opacity 1000ms ease, transform 1300ms ease;
      transition-delay: 450ms;
    }

    .experience:not(.is-instant) .experience__scene--memory {
      transition: opacity 900ms ease;
      transition-delay: 450ms;
    }

    .experience[data-scene='memory'] .experience__scene--cover {
      opacity: 0;
      transform: translateX(-6%);
    }

    .experience[data-scene='memory'] .experience__scene--memory {
      opacity: 1;
    }

    .experience[data-transition-direction='back'].is-transitioning .experience__scene--cover,
    .experience[data-transition-direction='back'].is-transitioning .experience__scene--memory {
      transition-duration: 850ms;
      transition-delay: 0ms;
    }

    /* Phase 1 (0-420ms): guest name, dedication, signature, location and
       CTA fade out with a small leftward shift. The duck and elephant
       (and the ink strokes, still overlaid on them) stay fully visible
       through this phase. */
    .experience.is-transitioning[data-transition-direction='forward'] :global(.cover__intro),
    .experience.is-transitioning[data-transition-direction='forward'] :global(.cover__names),
    .experience.is-transitioning[data-transition-direction='forward'] :global(.cover__meta) {
      transition: opacity 420ms ease, transform 420ms ease;
      opacity: 0;
      transform: translateX(-10px);
    }

    /* Phase 2 (450-1000ms): the rest of the animal PNGs fade away while
       the four ink strokes (drawn on top, see .ink-stage below) stay
       fully opaque -- this is the moment the strokes read as "part of
       the animal" before detaching. */
    .experience.is-transitioning[data-transition-direction='forward'] :global(.cover__elephant),
    .experience.is-transitioning[data-transition-direction='forward'] :global(.cover__duck) {
      transition: opacity 650ms ease 450ms;
      opacity: 0;
    }
  }

  .experience.is-reduced-motion .experience__scene--cover,
  .experience.is-reduced-motion .experience__scene--memory {
    transition: opacity 260ms ease !important;
    transform: none !important;
  }

  .experience.is-reduced-motion[data-scene='memory'] .experience__scene--cover {
    opacity: 0;
  }

  .experience.is-reduced-motion[data-scene='memory'] .experience__scene--memory {
    opacity: 1;
  }

  .experience.is-reduced-motion[data-transition-direction='forward'] :global(.cover__elephant),
  .experience.is-reduced-motion[data-transition-direction='forward'] :global(.cover__duck) {
    transition: opacity 260ms ease !important;
    opacity: 0;
  }

  .experience.is-instant .experience__scene--cover,
  .experience.is-instant .experience__scene--memory,
  .experience.is-instant :global(.cover__intro),
  .experience.is-instant :global(.cover__names),
  .experience.is-instant :global(.cover__meta),
  .experience.is-instant :global(.cover__elephant),
  .experience.is-instant :global(.cover__duck) {
    transition: none !important;
  }

  /* --- Ink stage: same 390x844 logical canvas and same scale mechanism
     Cover.astro's .cover-canvas uses (see the inline script in
     Cover.astro that sets --cover-scale / --cover-scale-x/-y on <html>)
     -- guarantees the four strokes stay pixel-aligned with the duck and
     elephant in every viewport, exactly like the rest of the portada. */
  .ink-stage {
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
    overflow: hidden;
  }

  .ink-stage .experience__ink {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 390px;
    height: 844px;
    transform-origin: center center;
    transform: translate(-50%, -50%) scale(var(--cover-scale, 1));
  }

  :global(html.is-fill-viewport) .ink-stage .experience__ink {
    transform: translate(-50%, -50%) scale(var(--cover-scale-x, 1), var(--cover-scale-y, 1));
  }

  .experience__ink-stroke {
    fill: none;
    stroke: var(--color-ink, #2a241d);
    stroke-linecap: round;
    stroke-linejoin: round;
    transform-box: view-box;
    transform-origin: var(--origin-x, 0) var(--origin-y, 0);
    transform: translate(var(--tx, 0px), var(--ty, 0px)) rotate(var(--rot, 0deg)) scale(var(--scl, 1));
  }

  .experience__ink-stroke--d1,
  .experience__ink-stroke--d2 {
    stroke-width: 1.7;
  }

  .experience__ink-stroke--e1,
  .experience__ink-stroke--e2 {
    stroke-width: 2.1;
  }

  @media (prefers-reduced-motion: no-preference) {
    .experience:not(.is-instant) .experience__ink-stroke {
      transition: transform var(--stroke-duration, 1100ms) cubic-bezier(0.33, 0.68, 0.4, 1) var(--stroke-delay, 0ms);
    }
  }

  .experience.is-reduced-motion .experience__ink-stroke {
    transition: none !important;
  }

  .experience.is-instant .experience__ink-stroke {
    transition: none !important;
  }
</style>
