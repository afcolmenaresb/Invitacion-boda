  .experience__journey-frame {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background-color: var(--color-bg);
    background-size: cover;
    background-repeat: no-repeat;
    background-position: 60% top;
  }

  .experience__journey-canvas {
    position: relative;
    width: 390px;
    height: 844px;
