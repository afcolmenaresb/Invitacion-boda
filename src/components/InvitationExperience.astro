      transition-duration: 850ms;
    }
  }

  .experience.is-reduced-motion .experience__scene--imagined {
    transition: opacity 260ms ease !important;
    transform: none !important;
  }

  .experience.is-reduced-motion.is-revealing-imagined .experience__scene--imagined {
