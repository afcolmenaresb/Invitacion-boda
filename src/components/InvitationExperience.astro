    background-repeat: no-repeat;
    background-position: 60% top;
  }

  /* Same 1% overscan as .experience__video above, and for the same reason
     -- a fractional --cover-scale can otherwise leave a hairline seam on
     one edge exposing whatever sits behind the video's own GPU layer. */
  .experience__destination-video {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 101%;
    height: 101%;
    transform: translate(-50%, -50%);
    object-fit: cover;
    object-position: 50% 50%;
    display: block;
  }

  .experience__destination-overlay {
    position: absolute;
    inset: 0;
  }

  /*
    Journey scene (page 4) -- additive only, same convention as the
    destination block above, one level deeper: sits below destination in
    the stacking order (z-index -1, destination 0, memory 1, cover 2), so
    the destination -> journey crossfade is the same "panel above fades
    out, panel below is already there" pattern, repeated.
  */
  .experience__scene--journey {
    z-index: -1;
    opacity: 0;
    pointer-events: none;
  }

  .experience[data-scene='journey'] .experience__scene--journey {
    pointer-events: auto;
  }

  .experience[data-scene='journey'] .experience__scene--cover,
  .experience[data-scene='journey'] .experience__scene--memory,
  .experience[data-scene='journey'] .experience__scene--destination {
    pointer-events: none;
  }

  .experience[data-scene='journey']:not(.is-transitioning) .experience__scene--cover,
  .experience[data-scene='journey']:not(.is-transitioning) .experience__scene--memory,
  .experience[data-scene='journey']:not(.is-transitioning) .experience__scene--destination {
    visibility: hidden;
  }

  .experience.is-transitioning :global(.destination__cta--primary),
  .experience.is-transitioning :global([data-action='back-to-destination']) {
    pointer-events: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .experience:not(.is-instant) .experience__scene--journey {
      transition: opacity 360ms ease;
    }

    .experience.is-revealing-journey .experience__scene--journey {
      opacity: 1;
    }

    /* Destination recedes while .is-destination-receded is present --
       defined after the existing ".is-revealing-destination
       .experience__scene--destination {opacity:1}" rule above so it wins
       on the (otherwise equal) specificity, same trick as
       .is-memory-receded overriding memory's own opacity. */
    /* 1860ms = 360ms +1500ms -- DestinationScene's video+text fade out
       together as this one panel-level opacity animation (its own text
       overlay has no independent fade of its own), so slowing this
       directly is what makes "la desaparición del texto" read as slower
       and more deliberate on its way to JourneyScene. */
    .experience.is-destination-receded .experience__scene--destination {
      transition: opacity 1860ms ease;
      opacity: 0;
    }

    /* 3850ms = 2350ms +1500ms -- the panel (video/background) now lingers
       exactly as long as JourneyScene's own text takes to finish its
       slower exit fade (see JourneyScene.astro's own [data-journey-part]
       back-exit rule), so the text is never cut off mid-fade by the
       panel disappearing (or its own :not(.is-transitioning)
       visibility:hidden) underneath it. Scoped to journey only --
       memory/destination's own back durations are untouched. */
    .experience[data-transition-direction='back'].is-transitioning .experience__scene--journey {
      transition-duration: 3850ms;
    }
  }

  .experience.is-reduced-motion .experience__scene--journey {
    transition: opacity 260ms ease !important;
    transform: none !important;
  }

  .experience.is-reduced-motion.is-revealing-journey .experience__scene--journey {
    opacity: 1;
  }

  .experience.is-reduced-motion[data-scene='journey'] .experience__scene--destination {
    opacity: 0;
  }

  .experience.is-instant .experience__scene--journey,
  .experience.is-instant .experience__journey-video,
  .experience.is-instant :global(.destination__cta--primary) {
    transition: none !important;
  }

  /*
    Journey stage -- same fixed 390x844 canvas convention as the
    destination stage above. Unlike that one, there is no static fallback
    image layer here (none exists yet for this scene -- see the markup's
    own comment): just the video and JourneyScene's own overlay content
