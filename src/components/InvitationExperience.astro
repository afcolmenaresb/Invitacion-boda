  /* Same 1% overscan as .experience__video above, and for the same reason
     -- a fractional --cover-scale can otherwise leave a hairline seam on
     one edge exposing whatever sits behind the video's own GPU layer. */
  .experience__journey-video {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 101%;
    height: 101%;
    transform: translate(-50%, -50%);
    object-fit: cover;
    object-position: 50% 50%;
    display: block;
    /* Explicit, no-op guarantee: nothing in this file applies a filter,
       blend mode or semi-transparent scrim over the video anywhere
       (audited -- no such rule exists) -- legibility comes entirely from
       the local ivory halos behind the text (see JourneyScene.astro's
       own .journey__halo/.journey__cta::before), never from darkening
       the footage itself. */
    filter: none;
  }

