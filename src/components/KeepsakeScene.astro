---
import { sceneKeepsake, getKeepsakeFinalLine } from '../data/sceneKeepsake';
import type { Guest } from '../data/guests';

interface Props {
  /** Drives the dynamic final line ("...contigo." / "...con ustedes."). */
  addressing?: Guest['addressing'];
}

// 'plural' is the safer neutral default if this were ever rendered without
// a guest context -- in practice InvitationExperience always passes the
// real guest.addressing through (same convention as every previous scene).
const { addressing = 'plural' } = Astro.props;

const finalLine = getKeepsakeFinalLine(addressing);
---

<div class="keepsake" data-scene-panel-content aria-label={sceneKeepsake.eyebrow}>
  <span class="keepsake__wash" aria-hidden="true"></span>
  <button type="button" class="keepsake__back" data-action="back-to-celebration" aria-label={sceneKeepsake.backLabel}>
    <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
      <path d="M15 5 L8 12 L15 19" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
    <span>{sceneKeepsake.backVisibleLabel}</span>
  </button>

  <div class="keepsake__content">
    <p class="keepsake__eyebrow" data-keepsake-part="eyebrow">
      <span class="keepsake__halo" aria-hidden="true"></span>
      {sceneKeepsake.eyebrow}
    </p>
    <h2 class="keepsake__title" data-scene-heading data-keepsake-part="title" tabindex="-1">
      <span class="keepsake__halo keepsake__halo--wide" aria-hidden="true"></span>
      {sceneKeepsake.title}
    </h2>
    <div class="keepsake__body" data-keepsake-part="body">
      <span class="keepsake__halo keepsake__halo--wide" aria-hidden="true"></span>
      {sceneKeepsake.body.map((line) => (
        <p>{line}</p>
      ))}
      <p class="keepsake__final">{finalLine}</p>
    </div>
    <button
      type="button"
      class="keepsake__cta"
      data-keepsake-part="cta"
      data-action="go-to-stay"
    >
      {sceneKeepsake.ctaPrimary}
    </button>
  </div>
</div>

<style>
  .keepsake {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    isolation: isolate;
  }

  /* Same control as every previous scene's own back button -- identical
     position, type treatment and icon, just pointing one scene back. */
  .keepsake__back {
    position: absolute;
    top: max(18px, env(safe-area-inset-top));
    left: max(18px, env(safe-area-inset-left));
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: none;
    border: none;
    padding: 0.4rem 0.2rem;
    cursor: pointer;
    font-family: var(--font-sans);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #3a332b;
    opacity: 0;
  }

  .keepsake__back::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: -6px -10px;
    pointer-events: none;
    background: radial-gradient(ellipse at center, rgba(255, 254, 248, 0.95), rgba(255, 254, 248, 0) 80%);
  }

  :global(.experience.is-revealing-keepsake) .keepsake__back {
    opacity: 1;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.experience:not(.is-instant)) .keepsake__back {
      transition: opacity 320ms ease, color 0.2s ease, transform 0.2s ease;
    }

    .keepsake__back:hover,
    .keepsake__back:focus-visible {
      color: var(--color-accent);
      transform: translateX(-2px);
    }
  }

  :global(.experience.is-instant) .keepsake__back {
    transition: none !important;
  }

  /*
    Same fixed 390x844 canvas convention as every other scene. Content
    sits low, over the video's own quieter lower register, same
    composition logic as the previous scenes, sitting inside
    .keepsake__wash's own quiet reading column below.
  */
  .keepsake__content {
    position: relative;
    margin-top: auto;
    width: 100%;
    max-width: 358.8px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    padding: 0 28px 140px;
  }

  /*
    Reading column -- same wide, soft "wash" of warm ivory light living
    behind the entire text block as JourneyScene/ImaginedDaysScene/
    CeremonyScene/CelebrationScene's own .X__wash (identical values, kept
    consistent across every scene that uses this device). Covers roughly
    the left 55-60% of the canvas and dissolves toward the right, quieting
    the video underneath just enough to read clearly without a flat panel
    anywhere.
  */
  .keepsake__wash {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse 60% 44% at 26% 66%, rgba(255, 251, 244, 0.26) 0%, rgba(255, 251, 244, 0) 78%),
      linear-gradient(
        to right,
        rgba(255, 251, 244, 0.55) 0%,
        rgba(255, 251, 244, 0.38) 36%,
        rgba(255, 251, 244, 0.14) 60%,
        rgba(255, 251, 244, 0) 88%
      );
    -webkit-mask-image: linear-gradient(to bottom, transparent 0%, rgba(0, 0, 0, 1) 38%, rgba(0, 0, 0, 1) 100%);
    mask-image: linear-gradient(to bottom, transparent 0%, rgba(0, 0, 0, 1) 38%, rgba(0, 0, 0, 1) 100%);
  }

  /*
    Same halo language already approved on pages 2-7: a soft, local
    opening of ivory light behind text, never a card/pill (no
    border-radius, no solid fill, no visible edge) and never a global
    scrim over the video.
  */
  .keepsake__halo {
    position: absolute;
    z-index: -1;
    pointer-events: none;
    inset: -10px -18px;
    background: radial-gradient(ellipse at center, rgba(255, 254, 248, 0.9) 0%, rgba(255, 254, 248, 0) 72%);
  }

  .keepsake__halo--wide {
    inset: -14px -24px;
  }

  .keepsake__eyebrow {
    position: relative;
    margin: 0 0 18px;
    font-family: var(--font-sans);
    text-transform: uppercase;
    letter-spacing: 0.22em;
    font-size: 0.68rem;
    color: #6f6350;
  }

  /*
    Title -- large, editorial serif. A quieter, more muted warm brown than
    CelebrationScene's own golden title -- this page is "una bajada
    emocional, más íntima y memoriosa", not another party beat, so its
    ink is deliberately calmer while staying in the same warm family.
  */
  .keepsake__title {
    position: relative;
    margin: 0 0 26px;
    font-family: var(--font-serif);
    font-style: normal;
    font-weight: 400;
    font-size: 1.85rem;
    line-height: 1.35;
    color: #4a3a28;
  }

  /*
    Main block -- warm, elegant italic serif (never the handwritten
    Sacramento script), each line its own node so the block reads as one
    continuous, unhurried thought. Near-ink tone, same legibility level
    already approved for the other post-ceremony scenes.
  */
  .keepsake__body {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .keepsake__body p {
    margin: 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    font-size: 1.18rem;
    line-height: 1.5;
    color: #241a12;
  }

  .keepsake__final {
    color: #241a12;
  }

  /*
    CTA -- separated clearly from the body as its own later gesture, same
    editorial sans/uppercase/arrow language as every other primary CTA in
    the experience. Now a real <button> (was a plain <p>) so it can
    trigger the stay transition -- reset to look identical to the old
    paragraph: no border/background/padding, same cursor affordance the
    rest of the experience's controls use. Deliberately NOT resetting
    font/letter-spacing/text-transform to "inherit" here -- see
    JourneyScene.astro's own .journey__cta--primary comment for why that
    specific trick silently breaks the uppercase transform instead of
    fixing anything. No individual halo/patch behind it -- it reads off
    .keepsake__wash above plus its own dark, high-contrast ink, same as
    CelebrationScene's CTA.
  */
  .keepsake__cta {
    position: relative;
    display: block;
    background: none;
    border: none;
    padding: 0;
    text-align: left;
    cursor: pointer;
    margin: 44px 0 0;
    font-family: var(--font-sans);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-size: 0.92rem;
    color: #221a10;
  }

  .keepsake__cta::after {
    content: ' →';
  }

  /*
    Entrance: plain, quiet opacity + small translateY -- never the
    handwritten ink sweep MemoryScene uses. Hidden by default; each part
    becomes visible once InvitationExperience.astro's script adds
    is-keepsake-revealing to the shared .experience root -- the moment
    transition8.mp4 begins playing (see runKeepsakeVideoAndReveal's own
    comment) -- at which point each [data-keepsake-part] fades in on its
    own transition-delay, timed against that same moment: first block
    (eyebrow) ~1.5s in ("aprox. entre 1.2s y 1.8s"), then title and body
    progressively, cta last, with the whole cascade settled well before
    the ~8s video ends so nothing is left visibly "colgado" once it
    freezes.
  */
  [data-keepsake-part] {
    opacity: 0;
    transform: translateY(10px);
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.experience.is-keepsake-revealing) [data-keepsake-part] {
      transition: opacity 900ms ease, transform 900ms ease;
    }

    :global(.experience.is-keepsake-revealing) [data-keepsake-part='eyebrow'] {
      opacity: 1;
      transform: translateY(0);
      transition-delay: 1500ms;
    }

    :global(.experience.is-keepsake-revealing) [data-keepsake-part='title'] {
      opacity: 1;
      transform: translateY(0);
      transition-delay: 2200ms;
    }

    :global(.experience.is-keepsake-revealing) [data-keepsake-part='body'] {
      opacity: 1;
      transform: translateY(0);
      transition-delay: 3300ms;
    }

    :global(.experience.is-keepsake-revealing) [data-keepsake-part='cta'] {
      opacity: 1;
      transform: translateY(0);
      transition-delay: 5000ms;
    }
  }

  /*
    Reduced motion / instant loads: no per-part stagger, no delays -- one
    short, uniform fade so the whole scene settles as a single quiet
    crossfade, same convention as every previous scene's own reduced-
    motion path.
  */
  :global(.experience.is-reduced-motion.is-keepsake-revealing) [data-keepsake-part],
  :global(.experience.is-instant) [data-keepsake-part] {
    transition: opacity 260ms ease !important;
    transform: none !important;
    transition-delay: 0ms !important;
  }

  :global(.experience.is-reduced-motion.is-keepsake-revealing) [data-keepsake-part],
  :global(.experience[data-scene='keepsake'].is-instant) [data-keepsake-part] {
    opacity: 1;
    transform: translateY(0);
  }
</style>
