---
import { sceneCelebration } from '../data/sceneCelebration';
---

<div class="celebration" data-scene-panel-content aria-label={sceneCelebration.eyebrow}>
  <span class="celebration__wash" aria-hidden="true"></span>
  <button type="button" class="celebration__back" data-action="back-to-ceremony" aria-label={sceneCelebration.backLabel}>
    <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
      <path d="M15 5 L8 12 L15 19" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
    <span>{sceneCelebration.backVisibleLabel}</span>
  </button>

  <div class="celebration__content">
    <p class="celebration__eyebrow" data-celebration-part="eyebrow">
      <span class="celebration__halo" aria-hidden="true"></span>
      {sceneCelebration.eyebrow}
    </p>
    <h2 class="celebration__title" data-scene-heading data-celebration-part="title" tabindex="-1">
      <span class="celebration__halo celebration__halo--wide" aria-hidden="true"></span>
      {sceneCelebration.title}
    </h2>
    <div class="celebration__body" data-celebration-part="body">
      <span class="celebration__halo celebration__halo--wide" aria-hidden="true"></span>
      {sceneCelebration.body.map((line) => (
        <p>{line}</p>
      ))}
    </div>
    <p class="celebration__closing" data-celebration-part="closing">
      <span class="celebration__halo celebration__halo--wide" aria-hidden="true"></span>
      {sceneCelebration.closing}
    </p>
    <button
      type="button"
      class="celebration__cta"
      data-celebration-part="cta"
      data-action="go-to-keepsake"
    >
      {sceneCelebration.ctaPrimary}
    </button>
  </div>
</div>

<style>
  .celebration {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    isolation: isolate;
  }

  /* Same control as every previous scene's own back button -- identical
     position, type treatment and icon, just pointing one scene back. */
  .celebration__back {
    position: absolute;
    top: max(18px, env(safe-area-inset-top));
    left: max(18px, env(safe-area-inset-left));
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: none;
    border: none;
    padding: 0.4rem 0.2rem;
    cursor: pointer;
    font-family: var(--font-sans);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #3a332b;
    opacity: 0;
  }

  .celebration__back::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: -6px -10px;
    pointer-events: none;
    background: radial-gradient(ellipse at center, rgba(255, 254, 248, 0.95), rgba(255, 254, 248, 0) 80%);
  }

  :global(.experience.is-revealing-celebration) .celebration__back {
    opacity: 1;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.experience:not(.is-instant)) .celebration__back {
      transition: opacity 320ms ease, color 0.2s ease, transform 0.2s ease;
    }

    .celebration__back:hover,
    .celebration__back:focus-visible {
      color: var(--color-accent);
      transform: translateX(-2px);
    }
  }

  :global(.experience.is-instant) .celebration__back {
    transition: none !important;
  }

  /*
    Same fixed 390x844 canvas convention as every other scene. Content
    sits low, over the video's own quieter lower register, same
    composition logic as the previous scenes -- nudged up further than
    the other scenes' own 108px (readability pass: several lines were
    landing right over the table/flowers/candles in the footage), so it
    has more room to breathe over the video's calmer area and sit inside
    .celebration__wash's own quiet reading column below.
  */
  .celebration__content {
    position: relative;
    margin-top: auto;
    width: 100%;
    max-width: 358.8px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    padding: 0 28px 156px;
  }

  /*
    Reading column -- a real, wide "wash" of warm ivory light living
    behind the entire text block (eyebrow through cta), not a small
    isolated halo. Covers roughly the left 55-60% of the canvas (where
    this left-aligned content actually sits) and dissolves smoothly
    toward the right, so the busier/decorative right side of the frame
    is left completely untouched -- never a flat panel (no solid fill at
    any single alpha, no border, no corner, no edge you can trace with
    your eye). Two layers:
      1. a linear-gradient(to right, ...) doing the actual left->right
         "quieting" of the footage the spec asks for -- most opaque at
         the very left, fully gone well before the right edge;
      2. a much fainter radial-gradient centered roughly behind the main
         block, adding a touch more lift right where the eyebrow/title/
         body/cta actually are, without changing the overall silhouette.
    mask-image fades the whole thing in vertically starting a bit above
    where the content begins, so there is no horizontal seam where the
    wash "starts" -- it simply grows out of nothing, the same soft way
    the local halos already do.

    Toned down a further round from the first pass (was reading as too
    opaque/present) -- same shape and reach, lower alpha throughout, kept
    identical to JourneyScene/ImaginedDaysScene/CeremonyScene's own
    .X__wash so the system reads as one consistent device across every
    scene that uses it, not a one-off.
  */
  .celebration__wash {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse 60% 44% at 26% 66%, rgba(255, 251, 244, 0.26) 0%, rgba(255, 251, 244, 0) 78%),
      linear-gradient(
        to right,
        rgba(255, 251, 244, 0.55) 0%,
        rgba(255, 251, 244, 0.38) 36%,
        rgba(255, 251, 244, 0.14) 60%,
        rgba(255, 251, 244, 0) 88%
      );
    -webkit-mask-image: linear-gradient(to bottom, transparent 0%, rgba(0, 0, 0, 1) 38%, rgba(0, 0, 0, 1) 100%);
    mask-image: linear-gradient(to bottom, transparent 0%, rgba(0, 0, 0, 1) 38%, rgba(0, 0, 0, 1) 100%);
  }

  /*
    Same halo language already approved on pages 2-6: a soft, local
    opening of ivory light behind text, never a card/pill (no
    border-radius, no solid fill, no visible edge) and never a global
    scrim over the video.
  */
  .celebration__halo {
    position: absolute;
    z-index: -1;
    pointer-events: none;
    inset: -10px -18px;
    background: radial-gradient(ellipse at center, rgba(255, 254, 248, 0.9) 0%, rgba(255, 254, 248, 0) 72%);
  }

  .celebration__halo--wide {
    inset: -14px -24px;
  }

  .celebration__eyebrow {
    position: relative;
    margin: 0 0 18px;
    font-family: var(--font-sans);
    text-transform: uppercase;
    letter-spacing: 0.22em;
    font-size: 0.68rem;
    /* Slightly deepened from #8c7f6a for the same readability pass as
       the rest of this scene's text -- still a quiet, muted label. */
    color: #6f6350;
  }

  /*
    Title -- large, editorial serif. Warm gold, same family as
    var(--color-accent) but deepened further (kept local to this scene,
    the shared token itself is untouched) so it reads warmer than the
    ceremony before it while still having real contrast against the
    video -- "no negro puro agresivo", just a richer, darker version of
    the same warmth.
  */
  .celebration__title {
    position: relative;
    margin: 0 0 26px;
    font-family: var(--font-serif);
    font-style: normal;
    font-weight: 400;
    font-size: 1.85rem;
    line-height: 1.35;
    color: #5f4522;
  }

  /*
    Main block -- warm, elegant italic serif (never the handwritten
    Sacramento script), each line its own node so the block reads as one
    continuous, unhurried thought.
  */
  .celebration__body {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .celebration__body p {
    margin: 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    font-size: 1.18rem;
    line-height: 1.5;
    /* Taken to a near-ink tone -- "llevarlo a un tono casi tinta" -- the
       strongest deepening in this pass, since this is the block that was
       still reading too soft. Still a warm brown, not flat #000. */
    color: #241a12;
  }

  .celebration__final {
    color: #241a12;
  }

  /*
    Closing statement ("remate") -- upright (not italic, unlike the body
    above), same deepened warm gold as the title (see its own comment),
    deliberately separated from the body with more room -- emotional, but
    "no más dominante que el título" so it stays at the title's own size,
    not larger.
  */
  .celebration__closing {
    position: relative;
    margin: 24px 0 0;
    font-family: var(--font-serif);
    font-style: normal;
    font-weight: 400;
    font-size: 1.2rem;
    line-height: 1.5;
    color: #5f4522;
  }

  /*
    CTA -- separated clearly from the closing as its own later gesture,
    same editorial sans/uppercase/arrow language as every other primary
    CTA in the experience. Now a real <button> (was a plain <p>) so it
    can trigger the keepsake transition -- reset to look identical to the
    old paragraph: no border/background/padding, same cursor affordance
    the rest of the experience's controls use. Deliberately NOT resetting
    font/letter-spacing/text-transform to "inherit" here -- see
    JourneyScene.astro's own .journey__cta--primary comment for why that
    specific trick silently breaks the uppercase transform instead of
    fixing anything.

    No individual halo/patch behind it (the previous round's own large
    ::before was read as too heavy, its own separate "block") -- it reads
    purely off .celebration__wash above (it already sits well inside
    that wash's reach) plus its own dark, high-contrast ink.
  */
  .celebration__cta {
    position: relative;
    display: block;
    background: none;
    border: none;
    padding: 0;
    text-align: left;
    cursor: pointer;
    margin: 44px 0 0;
    font-family: var(--font-sans);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-size: 0.92rem;
    /* Deepened further -- "asegúrate de que el contraste del texto sea
       alto". */
    color: #221a10;
  }

  .celebration__cta::after {
    content: ' →';
  }

  /*
    Entrance: plain, quiet opacity + small translateY -- never the
    handwritten ink sweep MemoryScene uses. Hidden by default; each part
    becomes visible once InvitationExperience.astro's script adds
    is-celebration-revealing to the shared .experience root -- the moment
    transition7.mp4 begins playing (see runCelebrationVideoAndReveal's own
    comment) -- at which point each [data-celebration-part] fades in on
    its own transition-delay, timed against that same moment: first block
    (eyebrow) ~1.5s in, then title, body and closing progressively, cta
    last -- "que se sienta mágica y pausada, pero no lenta", with the
    whole cascade settled well before the ~8s video ends so nothing is
    left visibly "colgado" once it freezes.
  */
  [data-celebration-part] {
    opacity: 0;
    transform: translateY(10px);
  }

  /* CTA specifically: not interactive/focusable until actually shown --
     opacity:0 alone doesn't stop pointer-events or Tab from reaching it. */
  [data-celebration-part='cta'] {
    visibility: hidden;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.experience.is-celebration-revealing) [data-celebration-part] {
      transition: opacity 900ms ease, transform 900ms ease;
    }

    :global(.experience.is-celebration-revealing) [data-celebration-part='eyebrow'] {
      opacity: 1;
      transform: translateY(0);
      transition-delay: 1500ms;
    }

    :global(.experience.is-celebration-revealing) [data-celebration-part='title'] {
      opacity: 1;
      transform: translateY(0);
      transition-delay: 2200ms;
    }

    :global(.experience.is-celebration-revealing) [data-celebration-part='body'] {
      opacity: 1;
      transform: translateY(0);
      transition-delay: 3200ms;
    }

    :global(.experience.is-celebration-revealing) [data-celebration-part='closing'] {
      opacity: 1;
      transform: translateY(0);
      transition-delay: 4600ms;
    }

    /*
      The CTA's own appearance is additionally gated on
      .is-celebration-cta-ready -- added by InvitationExperience.astro's
      script only once the *whole* forward sequence for this scene has
      genuinely finished (the video reaching 'ended'/erroring/hard-
      capping, or the no-video fallback hold elapsing -- see
      runCelebrationVideoAndReveal's own comment), not just this fixed
      6000ms delay on its own. Video/text timings above are untouched --
      this only holds the CTA back a little longer whenever the real
      video (~8s) outlasts that fixed delay, instead of popping in mid-
      playback.
    */
    :global(.experience.is-celebration-revealing) [data-celebration-part='cta'] {
      transition: opacity 900ms ease, transform 900ms ease, visibility 0s linear;
      transition-delay: 6000ms;
    }

    :global(.experience.is-celebration-revealing.is-celebration-cta-ready) [data-celebration-part='cta'] {
      /* Overrides the 6000ms transition-delay above -- see
         .ceremony__cta's own identical override for why. */
      transition-delay: 0ms;
      opacity: 1;
      transform: translateY(0);
      visibility: visible;
      pointer-events: auto;
    }
  }

  /*
    Reduced motion / instant loads: no per-part stagger, no delays -- one
    short, uniform fade so the whole scene settles as a single quiet
    crossfade, same convention as every previous scene's own reduced-
    motion path.
  */
  :global(.experience.is-reduced-motion.is-celebration-revealing) [data-celebration-part],
  :global(.experience.is-instant) [data-celebration-part] {
    transition: opacity 260ms ease !important;
    transform: none !important;
    transition-delay: 0ms !important;
  }

  :global(.experience.is-reduced-motion.is-celebration-revealing) [data-celebration-part],
  :global(.experience[data-scene='celebration'].is-instant) [data-celebration-part] {
    opacity: 1;
    transform: translateY(0);
  }

  :global(.experience.is-reduced-motion.is-celebration-revealing) [data-celebration-part='cta'],
  :global(.experience[data-scene='celebration'].is-instant) [data-celebration-part='cta'] {
    visibility: visible;
    pointer-events: auto;
  }
</style>
