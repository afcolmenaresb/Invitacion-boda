---
import { sceneCelebration, getCelebrationFinalLine } from '../data/sceneCelebration';
import type { Guest } from '../data/guests';

interface Props {
  /** Drives the dynamic final line ("...contigo." / "...con ustedes."). */
  addressing?: Guest['addressing'];
}

// 'plural' is the safer neutral default if this were ever rendered without
// a guest context -- in practice InvitationExperience always passes the
// real guest.addressing through (same convention as every previous scene).
const { addressing = 'plural' } = Astro.props;

const finalLine = getCelebrationFinalLine(addressing);
---

<div class="celebration" data-scene-panel-content aria-label={sceneCelebration.eyebrow}>
  <button type="button" class="celebration__back" data-action="back-to-ceremony" aria-label={sceneCelebration.backLabel}>
    <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
      <path d="M15 5 L8 12 L15 19" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
    <span>{sceneCelebration.backVisibleLabel}</span>
  </button>

  <div class="celebration__content">
    <p class="celebration__eyebrow" data-celebration-part="eyebrow">
      <span class="celebration__halo" aria-hidden="true"></span>
      {sceneCelebration.eyebrow}
    </p>
    <h2 class="celebration__title" data-scene-heading data-celebration-part="title" tabindex="-1">
      <span class="celebration__halo celebration__halo--wide" aria-hidden="true"></span>
      {sceneCelebration.title}
    </h2>
    <div class="celebration__body" data-celebration-part="body">
      <span class="celebration__halo celebration__halo--wide" aria-hidden="true"></span>
      {sceneCelebration.body.map((line) => (
        <p>{line}</p>
      ))}
      <p class="celebration__final">{finalLine}</p>
    </div>
    <p class="celebration__closing" data-celebration-part="closing">
      <span class="celebration__halo celebration__halo--wide" aria-hidden="true"></span>
      {sceneCelebration.closing}
    </p>
    <p class="celebration__cta" data-celebration-part="cta">
      {sceneCelebration.ctaPrimary}
    </p>
  </div>
</div>

<style>
  .celebration {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    isolation: isolate;
  }

  /* Same control as every previous scene's own back button -- identical
     position, type treatment and icon, just pointing one scene back. */
  .celebration__back {
    position: absolute;
    top: max(18px, env(safe-area-inset-top));
    left: max(18px, env(safe-area-inset-left));
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: none;
    border: none;
    padding: 0.4rem 0.2rem;
    cursor: pointer;
    font-family: var(--font-sans);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #3a332b;
    opacity: 0;
  }

  .celebration__back::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: -6px -10px;
    pointer-events: none;
    background: radial-gradient(ellipse at center, rgba(255, 254, 248, 0.95), rgba(255, 254, 248, 0) 80%);
  }

  :global(.experience.is-revealing-celebration) .celebration__back {
    opacity: 1;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.experience:not(.is-instant)) .celebration__back {
      transition: opacity 320ms ease, color 0.2s ease, transform 0.2s ease;
    }

    .celebration__back:hover,
    .celebration__back:focus-visible {
      color: var(--color-accent);
      transform: translateX(-2px);
    }
  }

  :global(.experience.is-instant) .celebration__back {
    transition: none !important;
  }

  /*
    Same fixed 390x844 canvas convention as every other scene. Content
    sits low, over the video's own quieter lower register, same
    composition logic as the previous scenes.
  */
  .celebration__content {
    margin-top: auto;
    width: 100%;
    max-width: 358.8px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    padding: 0 28px 108px;
  }

  /*
    Same halo language already approved on pages 2-6: a soft, local
    opening of ivory light behind text, never a card/pill (no
    border-radius, no solid fill, no visible edge) and never a global
    scrim over the video.
  */
  .celebration__halo {
    position: absolute;
    z-index: -1;
    pointer-events: none;
    inset: -10px -18px;
    background: radial-gradient(ellipse at center, rgba(255, 254, 248, 0.9) 0%, rgba(255, 254, 248, 0) 72%);
  }

  .celebration__halo--wide {
    inset: -14px -24px;
  }

  .celebration__eyebrow {
    position: relative;
    margin: 0 0 18px;
    font-family: var(--font-sans);
    text-transform: uppercase;
    letter-spacing: 0.22em;
    font-size: 0.68rem;
    color: #8c7f6a;
  }

  /*
    Title -- large, editorial serif, in the warm accent ink (same
    rgba(173,138,88...) already used for the emotional beats on the
    previous scenes' own closings/final lines) so the page reads warmer
    than the ceremony before it, without introducing a new color.
  */
  .celebration__title {
    position: relative;
    margin: 0 0 26px;
    font-family: var(--font-serif);
    font-style: normal;
    font-weight: 400;
    font-size: 1.85rem;
    line-height: 1.35;
    color: var(--color-accent);
  }

  /*
    Main block -- warm, elegant italic serif (never the handwritten
    Sacramento script), each line its own node so the block reads as one
    continuous, unhurried thought.
  */
  .celebration__body {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .celebration__body p {
    margin: 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    font-size: 1.18rem;
    line-height: 1.5;
    color: #4a3f35;
  }

  .celebration__final {
    color: #4a3f35;
  }

  /*
    Closing statement ("remate") -- upright (not italic, unlike the body
    above), warm accent ink, deliberately separated from the body with
    more room -- emotional, but "no más dominante que el título" so it
    stays at the title's own size, not larger.
  */
  .celebration__closing {
    position: relative;
    margin: 24px 0 0;
    font-family: var(--font-serif);
    font-style: normal;
    font-weight: 400;
    font-size: 1.2rem;
    line-height: 1.5;
    color: var(--color-accent);
  }

  /*
    CTA -- separated clearly from the closing as its own later gesture,
    same editorial sans/uppercase/arrow language as every other primary
    CTA in the experience. Left as a prepared-but-inert label, same
    convention already used for not-yet-wired CTAs elsewhere (e.g.
    CeremonyScene's own "Celebremos") -- nothing beyond this scene has
    been requested yet.
  */
  .celebration__cta {
    position: relative;
    margin: 44px 0 0;
    font-family: var(--font-sans);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-size: 0.92rem;
    color: #3a332b;
  }

  .celebration__cta::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: -8px -14px;
    pointer-events: none;
    background: radial-gradient(ellipse at center, rgba(255, 254, 248, 1), rgba(255, 254, 248, 0) 80%);
  }

  .celebration__cta::after {
    content: ' →';
  }

  /*
    Entrance: plain, quiet opacity + small translateY -- never the
    handwritten ink sweep MemoryScene uses. Hidden by default; each part
    becomes visible once InvitationExperience.astro's script adds
    is-celebration-revealing to the shared .experience root -- the moment
    transition7.mp4 begins playing (see runCelebrationVideoAndReveal's own
    comment) -- at which point each [data-celebration-part] fades in on
    its own transition-delay, timed against that same moment: first block
    (eyebrow) ~1.5s in, then title, body and closing progressively, cta
    last -- "que se sienta mágica y pausada, pero no lenta", with the
    whole cascade settled well before the ~8s video ends so nothing is
    left visibly "colgado" once it freezes.
  */
  [data-celebration-part] {
    opacity: 0;
    transform: translateY(10px);
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.experience.is-celebration-revealing) [data-celebration-part] {
      transition: opacity 900ms ease, transform 900ms ease;
    }

    :global(.experience.is-celebration-revealing) [data-celebration-part='eyebrow'] {
      opacity: 1;
      transform: translateY(0);
      transition-delay: 1500ms;
    }

    :global(.experience.is-celebration-revealing) [data-celebration-part='title'] {
      opacity: 1;
      transform: translateY(0);
      transition-delay: 2200ms;
    }

    :global(.experience.is-celebration-revealing) [data-celebration-part='body'] {
      opacity: 1;
      transform: translateY(0);
      transition-delay: 3200ms;
    }

    :global(.experience.is-celebration-revealing) [data-celebration-part='closing'] {
      opacity: 1;
      transform: translateY(0);
      transition-delay: 4600ms;
    }

    :global(.experience.is-celebration-revealing) [data-celebration-part='cta'] {
      opacity: 1;
      transform: translateY(0);
      transition-delay: 6000ms;
    }
  }

  /*
    Reduced motion / instant loads: no per-part stagger, no delays -- one
    short, uniform fade so the whole scene settles as a single quiet
    crossfade, same convention as every previous scene's own reduced-
    motion path.
  */
  :global(.experience.is-reduced-motion.is-celebration-revealing) [data-celebration-part],
  :global(.experience.is-instant) [data-celebration-part] {
    transition: opacity 260ms ease !important;
    transform: none !important;
    transition-delay: 0ms !important;
  }

  :global(.experience.is-reduced-motion.is-celebration-revealing) [data-celebration-part],
  :global(.experience[data-scene='celebration'].is-instant) [data-celebration-part] {
    opacity: 1;
    transform: translateY(0);
  }
</style>
