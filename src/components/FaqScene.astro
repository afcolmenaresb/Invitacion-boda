---
import { sceneFaq } from '../data/sceneFaq';
---

<div class="faq" data-scene-panel-content aria-label={sceneFaq.title}>
  <button type="button" class="faq__back" data-action="back-to-about" aria-label={sceneFaq.backLabel}>
    <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
      <path d="M15 5 L8 12 L15 19" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
    <span>{sceneFaq.backVisibleLabel}</span>
  </button>

  <div class="faq__frame">
    <div class="faq__header">
      <p class="faq__eyebrow" data-faq-part="eyebrow">
        <span class="faq__halo" aria-hidden="true"></span>
        Un poco de nosotros
      </p>
      <h2 class="faq__title" data-scene-heading data-faq-part="title" tabindex="-1">
        <span class="faq__halo faq__halo--wide" aria-hidden="true"></span>
        {sceneFaq.title}
      </h2>
    </div>

    <div class="faq__scroll" data-faq-scroll>
      <div class="faq__list" data-faq-part="list">
        {sceneFaq.items.map((item) => (
          <div class="faq__item">
            <p class="faq__question">{item.question}</p>
            {item.answer.map((line) => (
              <p class="faq__answer">{line}</p>
            ))}
          </div>
        ))}
      </div>
    </div>
  </div>
</div>

<style>
  .faq {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    isolation: isolate;
  }

  .faq__back {
    position: absolute;
    top: max(18px, env(safe-area-inset-top));
    left: max(18px, env(safe-area-inset-left));
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: none;
    border: none;
    padding: 0.4rem 0.2rem;
    cursor: pointer;
    font-family: var(--font-sans);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #3a332b;
    opacity: 0;
  }

  .faq__back::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: -6px -10px;
    pointer-events: none;
    background: radial-gradient(ellipse at center, rgba(255, 254, 248, 0.95), rgba(255, 254, 248, 0) 80%);
  }

  :global(.experience.is-faq-revealing) .faq__back {
    opacity: 1;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.experience:not(.is-instant)) .faq__back {
      transition: opacity 320ms ease, color 0.2s ease, transform 0.2s ease;
    }

    .faq__back:hover,
    .faq__back:focus-visible {
      color: var(--color-accent);
      transform: translateX(-2px);
    }
  }

  :global(.experience.is-instant) .faq__back {
    transition: none !important;
  }

  /*
    Same fixed 390x844 canvas as every scene, but the eleven Q&A pairs
    are far more content than any single previous scene carries. Split
    into a header (title -- stays fixed/visible, never scrolls away) and
    a separate scrolling body, same flex-column device as PersonScene's
    own .person__frame/.person__header/.person__scroll (see that
    component's own comment for why position:sticky doesn't work here).
    "no satures la pantalla" is handled by letting the visitor scroll
    through an unhurried list rather than cramming everything into one
    fixed view, plus the title never disappearing while reading.
  */
  .faq__frame {
    position: relative;
    margin-top: auto;
    width: 100%;
    max-width: 358.8px;
    max-height: min(78vh, 680px);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    /* Slightly narrower than before -- keeps question/answer text off
       the busiest parts of the sunset photo underneath. */
    padding: 0 34px;
  }

  .faq__header {
    position: relative;
    flex: 0 0 auto;
    width: 100%;
  }

  /*
    The list's own wash lives here, as this element's own background
    with background-attachment:local, instead of a separately positioned
    overlay -- a plain absolutely-positioned overlay sibling only ever
    covers this element's fixed *visible* height (max-height above),
    never its full *scrollable* height, so it used to fade out partway
    down an eleven-question list well before the real end. A background
    with local attachment scrolls together with the content and sizes
    itself to that full scrollable canvas instead, so the wash now
    reaches all the way to the last answer, not just the first screenful.
  */
  .faq__scroll {
    position: relative;
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    padding-bottom: 64px;
    background-image: linear-gradient(
        to right,
        rgba(255, 251, 244, 0.5) 0%,
        rgba(255, 251, 244, 0.34) 34%,
        rgba(255, 251, 244, 0.12) 58%,
        rgba(255, 251, 244, 0) 86%
      ),
      linear-gradient(to bottom, rgba(255, 251, 244, 0) 0%, rgba(255, 251, 244, 0.4) 14%, rgba(255, 251, 244, 0.4) 100%);
    background-repeat: no-repeat, no-repeat;
    background-attachment: local, local;
    /* Promotes this scrolling region to its own compositor layer -- see
       PersonScene's own .person__scroll comment for why this matters. */
    transform: translateZ(0);
  }

  .faq__halo {
    position: absolute;
    z-index: -1;
    pointer-events: none;
    inset: -10px -18px;
    background: radial-gradient(ellipse at center, rgba(255, 254, 248, 0.9) 0%, rgba(255, 254, 248, 0) 72%);
  }

  .faq__halo--wide {
    inset: -14px -24px;
  }

  /*
    "FAQ" own halo: same fix as PersonScene's title (see that component's
    own comment) -- the header's previous .faq__header-wash spanned
    edge-to-edge behind the whole header, reading as a hard horizontal
    band. That element is gone; instead .faq__title itself now
    shrink-wraps to its own text (width: fit-content below) so this local,
    explicitly-shaped ellipse halo scales with the word "FAQ" instead of
    the column -- a soft, local glow, never a band, never spanning the
    viewport.
  */
  .faq__title .faq__halo--wide {
    inset: -20px -46px;
    background: radial-gradient(ellipse 62% 100% at center, rgba(255, 254, 248, 0.95) 0%, rgba(255, 254, 248, 0) 74%);
  }

  .faq__eyebrow {
    position: relative;
    width: fit-content;
    margin: 0 0 14px;
    font-family: var(--font-sans);
    text-transform: uppercase;
    letter-spacing: 0.22em;
    font-size: 0.68rem;
    color: #6f6350;
  }

  .faq__title {
    position: relative;
    width: fit-content;
    margin: 0 0 24px;
    font-family: var(--font-serif);
    font-style: normal;
    font-weight: 400;
    font-size: 2.15rem;
    line-height: 1.25;
    color: #4a3a28;
    outline: none;
  }

  /*
    Each question/answer pair reads as one small paragraph of the same
    story -- an italic serif question (never a bold, "technical FAQ"
    label) followed by its own answer lines directly beneath, separated
    from the next pair by generous space alone, no rule/divider/card.
  */
  .faq__list {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 30px;
    padding-bottom: 8px;
  }

  .faq__item {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .faq__question {
    margin: 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    font-size: 1.08rem;
    line-height: 1.45;
    color: #3a2a18;
  }

  .faq__answer {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 0.86rem;
    line-height: 1.6;
    color: #4a3a28;
  }

  [data-faq-part] {
    opacity: 0;
    transform: translateY(10px);
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.experience.is-faq-revealing) [data-faq-part] {
      transition: opacity 700ms ease, transform 700ms ease;
    }

    :global(.experience.is-faq-revealing) [data-faq-part='eyebrow'] {
      opacity: 1;
      transform: translateY(0);
      transition-delay: 150ms;
    }

    :global(.experience.is-faq-revealing) [data-faq-part='title'] {
      opacity: 1;
      transform: translateY(0);
      transition-delay: 380ms;
    }

    :global(.experience.is-faq-revealing) [data-faq-part='list'] {
      opacity: 1;
      transform: translateY(0);
      transition-delay: 600ms;
    }
  }

  :global(.experience.is-reduced-motion.is-faq-revealing) [data-faq-part],
  :global(.experience.is-instant) [data-faq-part] {
    transition: opacity 260ms ease !important;
    transform: none !important;
    transition-delay: 0ms !important;
  }

  :global(.experience.is-reduced-motion.is-faq-revealing) [data-faq-part],
  :global(.experience[data-scene='faq'].is-instant) [data-faq-part] {
    opacity: 1;
    transform: translateY(0);
  }
</style>
