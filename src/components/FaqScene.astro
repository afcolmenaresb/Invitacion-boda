---
import { sceneFaq } from '../data/sceneFaq';
---

<div class="faq" data-scene-panel-content aria-label={sceneFaq.title}>
  <span class="faq__wash" aria-hidden="true"></span>
  <button type="button" class="faq__back" data-action="back-to-about" aria-label={sceneFaq.backLabel}>
    <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
      <path d="M15 5 L8 12 L15 19" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
    <span>{sceneFaq.backVisibleLabel}</span>
  </button>

  <div class="faq__content" data-faq-scroll>
    <p class="faq__eyebrow" data-faq-part="eyebrow">
      <span class="faq__halo" aria-hidden="true"></span>
      Un poco de nosotros
    </p>
    <h2 class="faq__title" data-scene-heading data-faq-part="title" tabindex="-1">
      <span class="faq__halo faq__halo--wide" aria-hidden="true"></span>
      {sceneFaq.title}
    </h2>

    <div class="faq__list" data-faq-part="list">
      <span class="faq__halo faq__halo--wide" aria-hidden="true"></span>
      {sceneFaq.items.map((item) => (
        <div class="faq__item">
          <p class="faq__question">{item.question}</p>
          {item.answer.map((line) => (
            <p class="faq__answer">{line}</p>
          ))}
        </div>
      ))}
    </div>
  </div>
</div>

<style>
  .faq {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    isolation: isolate;
  }

  .faq__back {
    position: absolute;
    top: max(18px, env(safe-area-inset-top));
    left: max(18px, env(safe-area-inset-left));
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: none;
    border: none;
    padding: 0.4rem 0.2rem;
    cursor: pointer;
    font-family: var(--font-sans);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #3a332b;
    opacity: 0;
  }

  .faq__back::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: -6px -10px;
    pointer-events: none;
    background: radial-gradient(ellipse at center, rgba(255, 254, 248, 0.95), rgba(255, 254, 248, 0) 80%);
  }

  :global(.experience.is-faq-revealing) .faq__back {
    opacity: 1;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.experience:not(.is-instant)) .faq__back {
      transition: opacity 320ms ease, color 0.2s ease, transform 0.2s ease;
    }

    .faq__back:hover,
    .faq__back:focus-visible {
      color: var(--color-accent);
      transform: translateX(-2px);
    }
  }

  :global(.experience.is-instant) .faq__back {
    transition: none !important;
  }

  /*
    Same fixed 390x844 canvas as every scene, but the eleven Q&A pairs
    are far more content than any single previous scene carries -- this
    reading column scrolls internally (never the outer canvas), same
    device as PersonScene's own .person__content, so "no satures la
    pantalla" is handled by letting the visitor scroll through an
    unhurried list rather than cramming everything into one fixed view.
  */
  .faq__content {
    position: relative;
    margin-top: auto;
    width: 100%;
    max-width: 358.8px;
    max-height: min(78vh, 680px);
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    padding: 0 28px 64px;
  }

  .faq__wash {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse 60% 44% at 26% 66%, rgba(255, 251, 244, 0.26) 0%, rgba(255, 251, 244, 0) 78%),
      linear-gradient(
        to right,
        rgba(255, 251, 244, 0.55) 0%,
        rgba(255, 251, 244, 0.38) 36%,
        rgba(255, 251, 244, 0.14) 60%,
        rgba(255, 251, 244, 0) 88%
      );
    -webkit-mask-image: linear-gradient(to bottom, transparent 0%, rgba(0, 0, 0, 1) 26%, rgba(0, 0, 0, 1) 100%);
    mask-image: linear-gradient(to bottom, transparent 0%, rgba(0, 0, 0, 1) 26%, rgba(0, 0, 0, 1) 100%);
  }

  .faq__halo {
    position: absolute;
    z-index: -1;
    pointer-events: none;
    inset: -10px -18px;
    background: radial-gradient(ellipse at center, rgba(255, 254, 248, 0.9) 0%, rgba(255, 254, 248, 0) 72%);
  }

  .faq__halo--wide {
    inset: -14px -24px;
  }

  .faq__eyebrow {
    position: relative;
    margin: 0 0 14px;
    font-family: var(--font-sans);
    text-transform: uppercase;
    letter-spacing: 0.22em;
    font-size: 0.68rem;
    color: #6f6350;
  }

  .faq__title {
    position: relative;
    margin: 0 0 24px;
    font-family: var(--font-serif);
    font-style: normal;
    font-weight: 400;
    font-size: 2.15rem;
    line-height: 1.25;
    color: #4a3a28;
    outline: none;
  }

  /*
    Each question/answer pair reads as one small paragraph of the same
    story -- an italic serif question (never a bold, "technical FAQ"
    label) followed by its own answer lines directly beneath, separated
    from the next pair by generous space alone, no rule/divider/card.
  */
  .faq__list {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 30px;
    padding-bottom: 8px;
  }

  .faq__item {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .faq__question {
    margin: 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    font-size: 1.08rem;
    line-height: 1.45;
    color: #3a2a18;
  }

  .faq__answer {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 0.86rem;
    line-height: 1.6;
    color: #4a3a28;
  }

  [data-faq-part] {
    opacity: 0;
    transform: translateY(10px);
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.experience.is-faq-revealing) [data-faq-part] {
      transition: opacity 700ms ease, transform 700ms ease;
    }

    :global(.experience.is-faq-revealing) [data-faq-part='eyebrow'] {
      opacity: 1;
      transform: translateY(0);
      transition-delay: 150ms;
    }

    :global(.experience.is-faq-revealing) [data-faq-part='title'] {
      opacity: 1;
      transform: translateY(0);
      transition-delay: 380ms;
    }

    :global(.experience.is-faq-revealing) [data-faq-part='list'] {
      opacity: 1;
      transform: translateY(0);
      transition-delay: 600ms;
    }
  }

  :global(.experience.is-reduced-motion.is-faq-revealing) [data-faq-part],
  :global(.experience.is-instant) [data-faq-part] {
    transition: opacity 260ms ease !important;
    transform: none !important;
    transition-delay: 0ms !important;
  }

  :global(.experience.is-reduced-motion.is-faq-revealing) [data-faq-part],
  :global(.experience[data-scene='faq'].is-instant) [data-faq-part] {
    opacity: 1;
    transform: translateY(0);
  }
</style>
