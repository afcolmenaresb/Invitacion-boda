---
import '../styles/global.css';

interface Props {
  title: string;
  /**
   * Personalized invitation pages (src/pages/i/[invite].astro) pass this
   * so search engines never crawl/index/follow-link-from a guest's own
   * page -- each one contains that guest's name/dedication and is only
   * meant to be reached via the private link sent to them, never
   * discovered. Defaults to false (indexable) for the guest-less demo
   * page (/).
   */
  noindex?: boolean;
}

const { title, noindex = false } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, minimum-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover"
    />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<script is:inline>
  // Belt-and-suspenders on top of the viewport meta's own maximum-scale=1/
  // user-scalable=no and global.css's touch-action -- modern iOS Safari
  // (10+) ignores user-scalable=no in the viewport meta for accessibility
  // reasons, so pinch-zoom and double-tap-zoom can still slip through
  // there without this. Neither handler touches scrolling/panning: both
  // only ever preventDefault() the zoom gesture itself.
  document.addEventListener(
    'gesturestart',
    (event) => {
      event.preventDefault();
    },
    { passive: false }
  );

  let lastTouchEnd = 0;
  document.addEventListener(
    'touchend',
    (event) => {
      const now = Date.now();
      if (now - lastTouchEnd <= 300) {
        event.preventDefault();
      }
      lastTouchEnd = now;
    },
    { passive: false }
  );

  // Cosmetic deterrent only -- does not actually hide or protect the page
  // source (view-source:, curl, a browser's own menu, etc. all still work).
  // Blocks the right-click context menu and the common keyboard shortcuts
  // for opening DevTools / viewing source, so a casual visitor doesn't
  // stumble into either by accident.
  document.addEventListener('contextmenu', (event) => {
    event.preventDefault();
  });

  document.addEventListener('keydown', (event) => {
    const key = event.key.toLowerCase();
    const blocksDevTools =
      key === 'f12' ||
      (event.ctrlKey && event.shiftKey && ['i', 'j', 'c'].includes(key)) ||
      (event.metaKey && event.altKey && ['i', 'j', 'c'].includes(key)) ||
      (event.ctrlKey && key === 'u') ||
      (event.metaKey && key === 'u');
    if (blocksDevTools) {
      event.preventDefault();
    }
  });
</script>

