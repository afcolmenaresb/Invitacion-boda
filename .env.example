# Firebase web app config for the RSVP feature on page 9 (src/lib/firebase.ts).
# Copy this file to .env (already gitignored) and fill in the values from
# your Firebase project: Project settings -> General -> Your apps -> Web app
# -> SDK setup and configuration -> Config.
#
# These are the public *web app* config values, not secrets -- Firebase's
# own docs confirm they're safe to ship in a client bundle. Real access
# control for the "rsvp" collection lives in firestore.rules, not here.
# Never put a service-account key in this file or anywhere in this repo.
#
# Must be prefixed PUBLIC_ so Astro/Vite inlines them into the client
# bundle -- see https://docs.astro.build/en/guides/environment-variables/.
# If any of these are missing, the RSVP feature quietly degrades (shows a
# discreet error instead of saving) without affecting the rest of the site.
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_STORAGE_BUCKET=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_APP_ID=
